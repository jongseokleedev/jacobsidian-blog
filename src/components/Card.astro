---
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import { getSeriesSlug } from "@/utils/getSeriesSlug";
import Datetime from "./Datetime.astro";
import ViewCount from "./ViewCount.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", ...entry } = Astro.props;
const { data } = entry;
const { title, description, pubDatetime, modDatetime, timezone, series, seriesOrder } = data;
const seriesSlug = series ? await getSeriesSlug(series) : null;
---

<li class="my-6">
  {series && seriesSlug && (
    <a
      href={`/series/${seriesSlug}`}
      class="inline-flex items-center gap-1.5 mb-1.5 text-[11.5px] transition-colors hover:text-accent"
      style="color: var(--fg-faint);"
    >
      {seriesOrder && <span class="font-mono">{seriesOrder}.</span>}
      <span>{series}</span>
    </a>
  )}
  <a
    href={getPath(entry as CollectionEntry<"posts">)}
    class:list={[
      "inline-block text-lg font-medium hover:text-accent transition-colors",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading>{title}</Heading>
  </a>
  <div class="flex items-center gap-2">
    <Datetime {pubDatetime} {modDatetime} {timezone} />
    <ViewCount postId={entry.id} />
  </div>
  <p>{description}</p>
</li>
