---
interface Props {
  item: {
    href: string;
    poster: string | null;
    title: string;
    description: string;
    date: Date;
    label: string;
    color: string;
  };
  index: number;
}
const { item, index } = Astro.props;
const dateStr = item.date.toLocaleDateString("ko-KR", { year: "numeric", month: "2-digit", day: "2-digit" });
---

<a
  href={item.href}
  class:list={[
    "group flex flex-row rounded-lg border border-border overflow-hidden hover:border-accent transition-colors h-[140px]",
    index === 2 && "hidden lg:flex",
  ]}
>
  <div
    class="w-[100px] shrink-0 overflow-hidden"
    style={`background: linear-gradient(135deg, color-mix(in srgb, ${item.color} 25%, transparent), color-mix(in srgb, ${item.color} 6%, transparent))`}
  >
    {item.poster ? (
      <img
        src={item.poster}
        alt={item.title}
        class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-end justify-end p-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-6 h-6 opacity-15" aria-hidden="true">
          <g transform="translate(16 16) scale(0.85) translate(-16 -16)" fill="currentColor" stroke="currentColor">
            <line x1="7" y1="9" x2="22" y2="22" stroke-width="1.9" stroke-linecap="round"></line>
            <line x1="22" y1="22" x2="25" y2="8" stroke-width="1.9" stroke-linecap="round"></line>
            <line x1="7" y1="9" x2="25" y2="8" stroke-width="1.9" stroke-linecap="round" opacity="0.4"></line>
            <circle cx="7" cy="9" r="3.2" stroke="none"></circle>
            <circle cx="22" cy="22" r="4" stroke="none"></circle>
            <circle cx="25" cy="8" r="2.4" stroke="none"></circle>
          </g>
        </svg>
      </div>
    )}
  </div>
  <div class="flex flex-col justify-between flex-1 p-3 gap-1 min-w-0">
    <div class="flex items-center justify-between gap-2">
      <span class="flex items-center gap-1.5 font-mono text-[11px] shrink-0" style={`color: ${item.color}`}>
        <span class="cat-dot shrink-0" style={`background: ${item.color}`} />
        {item.label}
      </span>
      <span class="font-mono text-[11px] shrink-0" style="color: var(--fg-faint);">{dateStr}</span>
    </div>
    <p class="font-semibold text-[14px] leading-snug line-clamp-2 group-hover:text-accent transition-colors">{item.title}</p>
    <p class="text-[12.5px] leading-snug line-clamp-2 min-h-[2.5em]" style="color: var(--fg-mute);">{item.description}</p>
  </div>
</a>
