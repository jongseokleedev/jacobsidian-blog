---
interface Props {
  item: {
    href: string;
    poster: string | null;
    title: string;
    description: string;
    date: Date;
    label: string;
    color: string;
  };
  index?: number;
  carousel?: boolean;
}
const { item, index = 0, carousel = false } = Astro.props;
const dateStr = item.date.toLocaleDateString("ko-KR", { year: "numeric", month: "2-digit", day: "2-digit" });
---

<a
  href={item.href}
  style={carousel ? "scroll-snap-align: start;" : undefined}
  class:list={[
    "group flex flex-row rounded-lg border border-border overflow-hidden hover:border-accent transition-colors outline-none focus-visible:outline-2 focus-visible:outline-dashed focus-visible:outline-accent focus-visible:outline-offset-2",
    carousel
      ? "shrink-0 w-[200px] h-[120px] sm:w-[280px] sm:h-[140px]"
      : ["h-[140px]", index === 2 && "hidden lg:flex"],
  ]}
>
  <div
    class:list={["shrink-0 overflow-hidden", carousel ? "w-[70px] sm:w-[100px]" : "w-[100px]"]}
    style={`background: linear-gradient(135deg, color-mix(in srgb, ${item.color} 25%, transparent), color-mix(in srgb, ${item.color} 6%, transparent))`}
  >
    {item.poster ? (
      <img
        src={item.poster}
        alt={item.title}
        width="100"
        height="150"
        class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-16 h-16 opacity-[0.08]" aria-hidden="true">
          <g transform="translate(16 16) scale(0.85) translate(-16 -16)" fill="currentColor" stroke="currentColor">
            <line x1="7" y1="9" x2="22" y2="22" stroke-width="1.9" stroke-linecap="round"></line>
            <line x1="22" y1="22" x2="25" y2="8" stroke-width="1.9" stroke-linecap="round"></line>
            <line x1="7" y1="9" x2="25" y2="8" stroke-width="1.9" stroke-linecap="round" opacity="0.4"></line>
            <circle cx="7" cy="9" r="3.2" stroke="none"></circle>
            <circle cx="22" cy="22" r="4" stroke="none"></circle>
            <circle cx="25" cy="8" r="2.4" stroke="none"></circle>
          </g>
        </svg>
      </div>
    )}
  </div>
  <div class="flex flex-col flex-1 p-3 gap-1.5 min-w-0 overflow-hidden">
    <div class="flex flex-col gap-y-0.5">
      {carousel ? (
        /* 모바일: 닷 + 날짜 한 줄, 라벨은 sm 이상에서만 */
        <span class="flex items-center gap-1.5 font-mono text-[11px]" style="color: var(--fg-faint);">
          <span class="cat-dot shrink-0 size-1.5" style={`background: ${item.color}`} />
          <span class="hidden sm:inline" style={`color: ${item.color}`}>{item.label}&ensp;</span>
          {dateStr}
        </span>
      ) : (
        <>
          <span class="flex items-center gap-1.5 font-mono text-[11px] shrink-0" style={`color: ${item.color}`}>
            <span class="cat-dot shrink-0" style={`background: ${item.color}`} />
            {item.label}
          </span>
          <span class="font-mono text-[11px] shrink-0" style="color: var(--fg-faint);">{dateStr}</span>
        </>
      )}
    </div>
    <p class="font-semibold text-[14px] leading-snug line-clamp-3 group-hover:text-accent transition-colors">{item.title}</p>
    <p class="text-[12.5px] leading-snug line-clamp-2 mt-auto" style="color: var(--fg-mute);">{item.description}</p>
  </div>
</a>
