<div class="giscus mt-12"></div>

<script is:inline>
  function loadGiscus() {
    const container = document.querySelector(".giscus");
    if (!container) return;

    container.replaceChildren();

    const theme =
      document.firstElementChild?.getAttribute("data-theme") === "dark"
        ? "dark"
        : "light";

    const s = document.createElement("script");
    s.src = "https://giscus.app/client.js";
    s.setAttribute("data-repo", "jongseokleedev/jacobsidian-blog");
    s.setAttribute("data-repo-id", "R_kgDOSa7ZLA");
    s.setAttribute("data-category", "Announcements");
    s.setAttribute("data-category-id", "DIC_kwDOSa7ZLM4C87y6");
    s.setAttribute("data-mapping", "pathname");
    s.setAttribute("data-strict", "0");
    s.setAttribute("data-reactions-enabled", "1");
    s.setAttribute("data-emit-metadata", "0");
    s.setAttribute("data-input-position", "bottom");
    s.setAttribute("data-theme", theme);
    s.setAttribute("data-lang", "ko");
    s.setAttribute("data-loading", "lazy");
    s.crossOrigin = "anonymous";
    s.async = true;
    container.appendChild(s);
  }

  function syncGiscusTheme() {
    const iframe = document.querySelector("iframe.giscus-frame");
    if (!iframe) return;
    const theme =
      document.firstElementChild?.getAttribute("data-theme") === "dark"
        ? "dark"
        : "light";
    iframe.contentWindow?.postMessage(
      { giscus: { setConfig: { theme } } },
      "https://giscus.app"
    );
  }

  document.addEventListener("astro:page-load", loadGiscus);

  new MutationObserver(syncGiscusTheme).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>
