---
interface Props {
  focusId?: string;
  height?: number;
  categoryFilter?: string;
}
const { focusId, height = 500, categoryFilter } = Astro.props;
const isMini = !!focusId;
const containerId = `graph-container-${Math.random().toString(36).slice(2)}`;
---

<div
  id={containerId}
  data-focus-id={focusId ?? ""}
  data-is-mini={isMini ? "true" : "false"}
  data-category-filter={categoryFilter ?? ""}
  style={`height: ${height}px; width: 100%;`}
  class="relative overflow-hidden bg-background"
>
  <canvas style="width: 100%; height: 100%;"></canvas>
  <!-- Zoom-to-fit button (full graph only) -->
  {!isMini && (
    <div class="absolute bottom-3 right-3 flex gap-1.5">
      <!-- Animate (timelapse) button -->
      <button
        class="animate-btn size-7 flex items-center justify-center rounded border border-border bg-background/80 text-foreground/40 hover:text-accent hover:border-accent transition-colors backdrop-blur-sm"
        title="Animate — timelapse by date"
        aria-label="Animate graph timelapse"
      >
        <!-- Play icon (default) -->
        <svg class="animate-icon-play size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="5,3 19,12 5,21"/>
        </svg>
        <!-- Stop icon (shown while playing) -->
        <svg class="animate-icon-stop size-3.5 hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <rect x="4" y="4" width="16" height="16" rx="2"/>
        </svg>
      </button>
      <!-- Fit view button -->
      <button
        class="fit-btn size-7 flex items-center justify-center rounded border border-border bg-background/80 text-foreground/40 hover:text-accent hover:border-accent transition-colors backdrop-blur-sm"
        title="Fit view"
        aria-label="Fit graph to view"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
        </svg>
      </button>
    </div>
  )}
  <!-- Timelapse date overlay -->
  {!isMini && (
    <div
      class="animate-date-overlay absolute top-3 left-3 pointer-events-none opacity-0 transition-opacity duration-300"
      style="min-width: 7em;"
    >
      <div
        class="animate-date-text font-mono text-[13px] white-space-nowrap"
        style="color: var(--fg-mute);"
      ></div>
      <div class="mt-1 h-[2px] rounded-full overflow-hidden" style="background: var(--border);">
        <div
          class="animate-progress-bar h-full rounded-full"
          style="width:0%; background: var(--fg-mute); transition: width 120ms linear;"
        ></div>
      </div>
    </div>
  )}
  <!-- Node bottom bar -->
  <div
    class="graph-node-bar absolute bottom-0 left-0 right-0 z-20 flex items-center justify-between gap-3 border-t border-border bg-background/90 px-3 backdrop-blur-sm"
    style="height:36px; transform:translateY(100%); transition:transform 200ms cubic-bezier(0.4,0,0.2,1); pointer-events:none;"
  >
    <span class="graph-node-bar-title truncate text-[12px] font-medium" style="color:var(--fg-mute);"></span>
    <a
      class="graph-node-bar-link shrink-0 font-mono text-[11px] hover:text-accent transition-colors"
      style="color:var(--fg-faint); pointer-events:auto;"
      href="#"
    >열기 →</a>
  </div>
</div>

<script define:vars={{ containerId }}>
  async function initGraph(containerEl) {
    if (!containerEl) return;

    const focusId = containerEl.dataset.focusId || null;
    const isMini = containerEl.dataset.isMini === "true";
    const initCategoryFilter = containerEl.dataset.categoryFilter || "all";

    const d3 = await import("https://cdn.jsdelivr.net/npm/d3@7/+esm");

    const res = await fetch("/graph.json");
    let { nodes, edges } = await res.json();

    if (isMini && focusId) {
      const neighborIds = new Set([focusId]);
      for (const e of edges) {
        if (e.source === focusId || e.target === focusId) {
          neighborIds.add(e.source);
          neighborIds.add(e.target);
        }
      }
      nodes = nodes.filter(n => neighborIds.has(n.id));
      edges = edges.filter(e => neighborIds.has(e.source) && neighborIds.has(e.target));
    }

    const canvas = containerEl.querySelector("canvas");
    const fitBtn = containerEl.querySelector(".fit-btn");
    const rect = containerEl.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    const ctx = canvas.getContext("2d");

    const getVar = v => getComputedStyle(document.documentElement).getPropertyValue(v).trim();

    const CATEGORY_COLORS = {
      essay:   getVar("--cat-essay"),
      tech:    getVar("--cat-tech"),
      review:  getVar("--cat-review"),
      fiction: getVar("--cat-fiction"),
    };

    const nodesCopy = nodes.map(n => ({ ...n }));
    const edgesCopy = edges.map(e => ({ ...e }));

    // Degree
    const degree = new Map();
    for (const n of nodesCopy) degree.set(n.id, 0);
    for (const e of edges) {
      degree.set(e.source, (degree.get(e.source) ?? 0) + 1);
      degree.set(e.target, (degree.get(e.target) ?? 0) + 1);
    }

    // Remove isolated nodes
    const connectedIds = new Set(nodesCopy.filter(n => (degree.get(n.id) ?? 0) > 0).map(n => n.id));
    nodesCopy.splice(0, nodesCopy.length, ...nodesCopy.filter(n => connectedIds.has(n.id)));
    edgesCopy.splice(0, edgesCopy.length, ...edgesCopy.filter(e =>
      connectedIds.has(typeof e.source === "object" ? e.source.id : e.source) &&
      connectedIds.has(typeof e.target === "object" ? e.target.id : e.target)
    ));

    const nodeRadius = n => {
      if (n.type === "tag") return 4;
      return Math.min(5 + (degree.get(n.id) ?? 0) * 1.5, 14);
    };

    function nodeColor(n) {
      if (n.type === "tag") return "#888888";
      const parent = n.category?.split("-")[0] ?? n.category;
      return CATEGORY_COLORS[parent] ?? "#aaaaaa";
    }

    // Build adjacency for 2-hop lookup
    const adjacency = new Map();
    for (const n of nodesCopy) adjacency.set(n.id, new Set());
    for (const e of edgesCopy) {
      const sid = typeof e.source === "object" ? e.source.id : e.source;
      const tid = typeof e.target === "object" ? e.target.id : e.target;
      adjacency.get(sid)?.add(tid);
      adjacency.get(tid)?.add(sid);
    }

    function getHopSets(node) {
      const hop1 = new Set([node.id, ...(adjacency.get(node.id) ?? [])]);
      const hop2 = new Set(hop1);
      for (const id of adjacency.get(node.id) ?? []) {
        for (const nid of adjacency.get(id) ?? []) hop2.add(nid);
      }
      return { hop1, hop2 };
    }

    let hoveredNode = null;
    let pinnedNodes = new Set();
    let currentTransform = d3.zoomIdentity;
    let categoryFilter = initCategoryFilter;

    // Hover animation state
    const hoverProgress = new Map(); // nodeId → 0..1  (label scale)
    let dimProgress = 0;             // 0..1  (global dim strength)
    let lastHop1 = null;
    let lastHop2 = null;
    let animFrameId = null;

    // Timelapse birth state — 0: hidden, 1: fully visible
    const birthProgress = new Map(); // nodeId → 0..1
    let timelapseActive = false;
    for (const n of nodesCopy) birthProgress.set(n.id, 1); // start fully visible

    // Category filter animation state
    const catAlphaMap = new Map();  // nodeId → current alpha (0.18..1)
    const catPulseMap = new Map();  // nodeId → pulse progress 0..1 (sin curve → scale)
    for (const n of nodesCopy) catAlphaMap.set(n.id, 1);

    function targetCatAlpha(n) {
      if (categoryFilter === "all" || n.type === "tag") return 1;
      const parentCat = n.category?.split("-")[0] ?? n.category;
      return parentCat === categoryFilter ? 1 : 0.18;
    }

    function triggerCatFilter() {
      for (const n of nodesCopy) {
        const prev = catAlphaMap.get(n.id) ?? 1;
        const next = targetCatAlpha(n);
        if (prev < 0.5 && next === 1) catPulseMap.set(n.id, 0.001); // dim→bright: pulse
      }
    }

    function animateTick() {
      let needsRedraw = false;
      const speed = 0.14;
      const catSpeed = 0.11;
      const pulseSpeed = 0.07;

      // Per-node label progress
      for (const n of nodesCopy) {
        const isHovered = hoveredNode?.id === n.id;
        const cur = hoverProgress.get(n.id) ?? 0;
        const target = isHovered ? 1 : 0;
        if (Math.abs(cur - target) > 0.005) {
          hoverProgress.set(n.id, cur + (target - cur) * speed);
          needsRedraw = true;
        } else if (cur !== target) {
          hoverProgress.set(n.id, target);
        }
      }

      // Global dim progress
      const dimTarget = hoveredNode ? 1 : 0;
      if (Math.abs(dimProgress - dimTarget) > 0.005) {
        dimProgress += (dimTarget - dimProgress) * speed;
        needsRedraw = true;
      } else if (dimProgress !== dimTarget) {
        dimProgress = dimTarget;
      }

      // Category alpha lerp + pulse
      for (const n of nodesCopy) {
        const cur = catAlphaMap.get(n.id) ?? 1;
        const tgt = targetCatAlpha(n);
        if (Math.abs(cur - tgt) > 0.005) {
          catAlphaMap.set(n.id, cur + (tgt - cur) * catSpeed);
          needsRedraw = true;
        } else if (cur !== tgt) {
          catAlphaMap.set(n.id, tgt);
        }

        const pulse = catPulseMap.get(n.id);
        if (pulse != null) {
          const next = pulse + pulseSpeed;
          if (next >= 1) {
            catPulseMap.delete(n.id);
          } else {
            catPulseMap.set(n.id, next);
          }
          needsRedraw = true;
        }
      }

      if (needsRedraw) {
        draw();
        animFrameId = requestAnimationFrame(animateTick);
      } else {
        animFrameId = null;
      }
    }

    function startAnim() {
      if (hoveredNode) {
        lastHop1 = getHopSets(hoveredNode).hop1;
        lastHop2 = getHopSets(hoveredNode).hop2;
      }
      if (!animFrameId) animFrameId = requestAnimationFrame(animateTick);
    }

    // Label fade threshold — matches Obsidian text-fade behaviour
    const LABEL_FADE_START = 1.5;
    const LABEL_FADE_END   = 2.2;
    function labelAlpha(k) {
      return Math.min(1, Math.max(0, (k - LABEL_FADE_START) / (LABEL_FADE_END - LABEL_FADE_START)));
    }

    function drawDotGrid(fg) {
      const spacing = 28;
      const dotR = 0.8 / currentTransform.k;
      const t = currentTransform;
      const x0 = -t.x / t.k;
      const y0 = -t.y / t.k;
      const x1 = (rect.width - t.x) / t.k;
      const y1 = (rect.height - t.y) / t.k;
      const startX = Math.floor(x0 / spacing) * spacing;
      const startY = Math.floor(y0 / spacing) * spacing;
      ctx.fillStyle = fg + "18";
      for (let gx = startX; gx < x1; gx += spacing) {
        for (let gy = startY; gy < y1; gy += spacing) {
          ctx.beginPath();
          ctx.arc(gx, gy, dotR, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }

    // Draw diamond shape for tag nodes
    function drawDiamond(x, y, r) {
      ctx.beginPath();
      ctx.moveTo(x, y - r * 1.4);
      ctx.lineTo(x + r, y);
      ctx.lineTo(x, y + r * 1.4);
      ctx.lineTo(x - r, y);
      ctx.closePath();
    }

    function draw() {
      // Apply birth progress: multiply catAlphaMap by birth factor during timelapse
      if (timelapseActive) {
        for (const n of nodesCopy) {
          const birth = birthProgress.get(n.id) ?? 0;
          const cat = targetCatAlpha(n);
          catAlphaMap.set(n.id, cat * birth);
        }
      }

      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.translate(currentTransform.x, currentTransform.y);
      ctx.scale(currentTransform.k, currentTransform.k);

      const fg = getVar("--foreground") || "#e2e2e2";
      const accent = getVar("--accent") || "#f97316";
      const muted = getVar("--muted") || "#555";

      drawDotGrid(fg);

      // Use last known hop sets during fade-out so dim stays stable
      const activeHop1 = hoveredNode ? getHopSets(hoveredNode).hop1 : lastHop1;
      const activeHop2 = hoveredNode ? getHopSets(hoveredNode).hop2 : lastHop2;
      const hop1 = dimProgress > 0.01 ? activeHop1 : null;
      const hop2 = dimProgress > 0.01 ? activeHop2 : null;
      const d = dimProgress;

      function nodeOpacity(id) {
        const catAlpha = catAlphaMap.get(id) ?? 1;
        if (d < 0.01) return catAlpha;
        if (hop1?.has(id)) return catAlpha;
        if (hop2?.has(id)) return catAlpha * (1 - d * 0.55);
        return catAlpha * (1 - d * 0.9);
      }

      // Edges
      for (const e of edgesCopy) {
        if (!e.source.x) continue;
        if (e.type === "tag") continue; // tag edges are for force clustering only
        const sid = e.source?.id ?? e.source;
        const tid = e.target?.id ?? e.target;

        // During timelapse: only draw edge when both endpoints are born
        if (timelapseActive) {
          const sb = birthProgress.get(sid) ?? 0;
          const tb = birthProgress.get(tid) ?? 0;
          if (sb <= 0 || tb <= 0) continue;
          ctx.globalAlpha = Math.min(sb, tb);
        } else {
          const isActive = !hop1 || (hop1.has(sid) && hop1.has(tid));
          const baseOpacity = isActive ? 1 : (hop2?.has(sid) || hop2?.has(tid) ? 0.2 : 0.05);
          ctx.globalAlpha = d < 0.01 ? 1 : isActive ? 1 : 1 - d * (1 - baseOpacity);
        }

        const isActive = !hop1 || (hop1.has(sid) && hop1.has(tid));
        ctx.beginPath();
        ctx.moveTo(e.source.x, e.source.y);
        ctx.lineTo(e.target.x, e.target.y);
        ctx.setLineDash([]);
        ctx.strokeStyle = isActive ? fg + "cc" : fg + "44";
        ctx.lineWidth = isActive && hop1 ? 1.8 : 1.2;
        ctx.stroke();
      }
      ctx.globalAlpha = 1;

      // Nodes
      for (const n of nodesCopy) {
        if (n.x == null) continue;
        if (n.type === "tag") continue; // tag nodes are invisible clustering anchors
        const isFocused = n.id === focusId;
        const isHovered = hoveredNode?.id === n.id;
        const isPinned = pinnedNodes.has(n.id);
        const r = (isFocused || isHovered) ? Math.max(nodeRadius(n), 9) : nodeRadius(n);
        const baseColor = nodeColor(n);
        const opacity = nodeOpacity(n.id);

        // Pulse scale from category filter (sin curve: 0→peak→0)
        const pulse = catPulseMap.get(n.id);
        const pulseScale = pulse != null ? 1 + Math.sin(pulse * Math.PI) * 0.15 : 1;

        // Birth scale: elastic pop — fast burst → overshoot → bounce → settle
        const birth = timelapseActive ? (birthProgress.get(n.id) ?? 0) : 1;
        let birthScale = 1;
        if (birth < 1) {
          if (birth < 0.35) {
            birthScale = (birth / 0.35) * 1.9;          // 0 → 1.9x (fast burst)
          } else if (birth < 0.60) {
            const p = (birth - 0.35) / 0.25;
            birthScale = 1.9 - p * (1.9 - 0.75);        // 1.9x → 0.75x (snap back)
          } else if (birth < 0.82) {
            const p = (birth - 0.60) / 0.22;
            birthScale = 0.75 + p * (1.18 - 0.75);      // 0.75x → 1.18x (bounce up)
          } else {
            const p = (birth - 0.82) / 0.18;
            birthScale = 1.18 - p * 0.18;               // 1.18x → 1.0x (settle)
          }
        }
        const totalScale = pulseScale * birthScale;

        ctx.save();
        if (totalScale !== 1) {
          ctx.translate(n.x, n.y);
          ctx.scale(totalScale, totalScale);
          ctx.translate(-n.x, -n.y);
        }

        // Glow ring
        if (isHovered) {
          ctx.globalAlpha = 1;
          if (n.type === "tag") {
            drawDiamond(n.x, n.y, r + 5);
          } else {
            ctx.beginPath();
            ctx.arc(n.x, n.y, r + 5, 0, Math.PI * 2);
          }
          ctx.fillStyle = baseColor + "33";
          ctx.fill();
        } else if (isFocused) {
          ctx.globalAlpha = 1;
          ctx.beginPath();
          ctx.arc(n.x, n.y, r + 5, 0, Math.PI * 2);
          ctx.fillStyle = accent + "33";
          ctx.fill();
        } else if (pulse != null) {
          // Pulse glow ring for newly activated nodes
          ctx.globalAlpha = Math.sin(pulse * Math.PI) * 0.25;
          ctx.beginPath();
          ctx.arc(n.x, n.y, r + 4, 0, Math.PI * 2);
          ctx.fillStyle = baseColor;
          ctx.fill();
        }

        ctx.globalAlpha = opacity;
        if (n.type === "tag") {
          drawDiamond(n.x, n.y, r);
        } else {
          ctx.beginPath();
          ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
        }
        ctx.fillStyle = baseColor;
        ctx.fill();
        ctx.restore();


        // Pin indicator — small dot at top-right of pinned nodes
        if (isPinned && n.type !== "tag") {
          ctx.globalAlpha = 1;
          ctx.beginPath();
          ctx.arc(n.x + r * 0.7, n.y - r * 0.7, 2.5, 0, Math.PI * 2);
          ctx.fillStyle = accent;
          ctx.fill();
        }

        ctx.globalAlpha = 1;
      }

      // Labels
      const zoomLabelAlpha = labelAlpha(currentTransform.k);
      ctx.textAlign = "center";

      for (const n of nodesCopy) {
        if (n.x == null || n.type === "tag") continue;
        const isHovered = hoveredNode?.id === n.id;
        const isHop1 = hop1?.has(n.id);

        let alpha;
        if (isHovered) {
          alpha = 1;
        } else if (isMini) {
          alpha = 0; // mini graph: labels only on hover
        } else if (hop1) {
          if (isHop1) alpha = 0.75;
          else alpha = 0;
        } else {
          alpha = zoomLabelAlpha;
        }

        if (alpha <= 0.01) continue;

        const r = nodeRadius(n);
        ctx.globalAlpha = alpha;

        const p = hoverProgress.get(n.id) ?? 0;
        const fontSize = 9 + p * 4; // 9px → 13px
        const weight = p > 0.5 ? "600 " : "";
        ctx.font = `${weight}${fontSize}px sans-serif`;
        const maxChars = Math.round(20 + p * 8);
        const label = n.title?.length > maxChars ? n.title.slice(0, maxChars - 1) + "…" : n.title;
        ctx.fillStyle = p > 0.01 ? fg : fg + "aa";
        ctx.fillText(label, n.x, n.y + r + fontSize + 2);

        // Connection count fades in below label
        if (p > 0.3) {
          const connections = degree.get(n.id) ?? 0;
          ctx.globalAlpha = alpha * ((p - 0.3) / 0.7);
          ctx.font = `10px sans-serif`;
          ctx.fillStyle = fg + "66";
          ctx.fillText(`${connections} connection${connections !== 1 ? "s" : ""}`, n.x, n.y + r + fontSize + 16);
          ctx.globalAlpha = alpha;
        }

        ctx.globalAlpha = 1;
      }

      ctx.restore();
    }

    const zoom = d3.zoom()
      .scaleExtent(isMini ? [0.1, 10] : [0.2, 5])
      .on("zoom", event => {
        currentTransform = event.transform;
        draw();
      });

    if (!isMini) d3.select(canvas).call(zoom);

    // Cluster nodes at center before silent convergence
    const cx0 = rect.width / 2;
    const cy0 = rect.height / 2;
    nodesCopy.forEach(n => {
      n.x = cx0 + (Math.random() - 0.5) * 20;
      n.y = cy0 + (Math.random() - 0.5) * 20;
      n.vx = 0;
      n.vy = 0;
    });

    const sim = d3.forceSimulation(nodesCopy)
      .force("link", d3.forceLink(edgesCopy).id(d => d.id).distance(e => e.type === "tag" ? 30 : 60))
      .force("charge", d3.forceManyBody().strength(n => n.type === "tag" ? -30 : -120))
      .force("center", d3.forceCenter(rect.width / 2, rect.height / 2))
      .force("collision", d3.forceCollide(n => nodeRadius(n) + 4));

    // Silently converge
    sim.stop();
    for (let i = 0; i < 300; i++) sim.tick();

    function computeFitTransform() {
      const postNodes = nodesCopy.filter(n => n.type !== "tag");
      const xs = postNodes.map(n => n.x).filter(x => x != null);
      const ys = postNodes.map(n => n.y).filter(y => y != null);
      if (!xs.length) return d3.zoomIdentity;
      const minX = Math.min(...xs), maxX = Math.max(...xs);
      const minY = Math.min(...ys), maxY = Math.max(...ys);
      const pad = 48;
      const k = Math.min(
        (rect.width - pad * 2) / (maxX - minX || 1),
        (rect.height - pad * 2) / (maxY - minY || 1),
        2
      );
      const tx = rect.width / 2 - k * (minX + maxX) / 2;
      const ty = rect.height / 2 - k * (minY + maxY) / 2;
      return d3.zoomIdentity.translate(tx, ty).scale(k);
    }

    const fitTransform = computeFitTransform();
    d3.select(canvas).call(zoom.transform, fitTransform);

    if (!isMini) {
      fitBtn?.addEventListener("click", () => {
        const fit = computeFitTransform();
        // Animate camera to fit view
        d3.select(canvas).transition().duration(400).call(zoom.transform, fit);

        // Unpin all nodes, re-cluster to center, restart simulation
        const cx = (rect.width / 2 - fit.x) / fit.k;
        const cy = (rect.height / 2 - fit.y) / fit.k;
        for (const n of nodesCopy) {
          n.fx = null;
          n.fy = null;
          n.x = cx + (Math.random() - 0.5) * 20;
          n.y = cy + (Math.random() - 0.5) * 20;
          n.vx = 0;
          n.vy = 0;
        }
        pinnedNodes.clear();
        sim.alpha(1).restart();
      });
    }

    // ── Timelapse animation ──────────────────────────────────────
    if (!isMini) {
      const animateBtn = containerEl.querySelector(".animate-btn");
      const animIconPlay = containerEl.querySelector(".animate-icon-play");
      const animIconStop = containerEl.querySelector(".animate-icon-stop");
      const dateOverlay = containerEl.querySelector(".animate-date-overlay");
      const dateText = containerEl.querySelector(".animate-date-text");
      const progressBar = containerEl.querySelector(".animate-progress-bar");

      // Sort post nodes by pubDatetime; tag/undated nodes appear last
      const timelapseSorted = [...nodesCopy]
        .filter(n => n.type !== "tag")
        .sort((a, b) => {
          if (!a.pubDatetime && !b.pubDatetime) return 0;
          if (!a.pubDatetime) return 1;
          if (!b.pubDatetime) return -1;
          return new Date(a.pubDatetime).getTime() - new Date(b.pubDatetime).getTime();
        });

      const BIRTH_SPEED = 0.16;
      const STEP_MS = 120;
      let timelapsTimer = null;

      // Slot-machine digit transition for date text
      function setDateAnimated(newText) {
        if (!dateText) return;
        const oldText = dateText.dataset.cur ?? "";
        if (oldText === newText) return;
        dateText.dataset.cur = newText;
        const children = [];
        for (let ci = 0; ci < newText.length; ci++) {
          const nc = newText[ci] ?? "";
          const oc = oldText[ci] ?? "";
          if (!/\d/.test(nc) || nc === oc) {
            const s = document.createElement("span");
            s.style.cssText = "display:inline-block;vertical-align:middle;";
            s.textContent = nc;
            children.push(s);
          } else {
            const slot = document.createElement("span");
            slot.style.cssText = "display:inline-block;overflow:hidden;height:1em;vertical-align:middle;position:relative;";
            const track = document.createElement("span");
            track.style.cssText = "display:flex;flex-direction:column;will-change:transform;";
            const prev = document.createElement("span");
            prev.textContent = oc || nc;
            prev.style.cssText = "display:block;height:1em;line-height:1em;";
            const next = document.createElement("span");
            next.textContent = nc;
            next.style.cssText = "display:block;height:1em;line-height:1em;";
            track.appendChild(prev);
            track.appendChild(next);
            slot.appendChild(track);
            children.push(slot);
            requestAnimationFrame(() => requestAnimationFrame(() => {
              track.style.transition = "transform 220ms cubic-bezier(0.4,0,0.2,1)";
              track.style.transform = "translateY(-1em)";
            }));
          }
        }
        dateText.replaceChildren(...children);
      }

      function tickBirth() {
        let anyChanging = false;
        for (const n of nodesCopy) {
          const cur = birthProgress.get(n.id) ?? 0;
          if (cur > 0 && cur < 1) {
            birthProgress.set(n.id, Math.min(1, cur + BIRTH_SPEED));
            anyChanging = true;
          }
        }
        draw();
        if (anyChanging) requestAnimationFrame(tickBirth);
      }

      function stopTimelapse() {
        timelapseActive = false;
        clearTimeout(timelapsTimer);
        timelapsTimer = null;
        animIconPlay?.classList.remove("hidden");
        animIconStop?.classList.add("hidden");
        // Keep date overlay and progress bar visible after completion
        for (const n of nodesCopy) birthProgress.set(n.id, 1);
        // Restore catAlphaMap and alphaDecay
        for (const n of nodesCopy) catAlphaMap.set(n.id, targetCatAlpha(n));
        sim.alphaDecay(0.0228);
        // Freeze layout and snap camera to fit
        sim.stop();
        const finalFit = computeFitTransform();
        d3.select(canvas).interrupt();
        d3.select(canvas)
          .transition()
          .duration(250)
          .ease(d3.easeCubicOut)
          .call(zoom.transform, finalFit)
          .on("end", () => sim.restart());
        draw();
      }

      function startTimelapse() {
        timelapseActive = true;
        animIconPlay?.classList.add("hidden");
        animIconStop?.classList.remove("hidden");
        if (dateOverlay) dateOverlay.style.opacity = "1";
        if (progressBar) progressBar.style.width = "0%";
        if (dateText) { dateText.dataset.cur = ""; dateText.replaceChildren(); }

        // Hide all nodes
        for (const n of nodesCopy) birthProgress.set(n.id, 0);

        // Re-cluster to canvas center
        const cx = rect.width / 2;
        const cy = rect.height / 2;
        for (const n of nodesCopy) {
          n.fx = null; n.fy = null;
          n.x = cx + (Math.random() - 0.5) * 20;
          n.y = cy + (Math.random() - 0.5) * 20;
          n.vx = 0; n.vy = 0;
        }
        pinnedNodes.clear();
        // Reset camera to identity so simulation spreads visibly
        d3.select(canvas).call(zoom.transform, d3.zoomIdentity);
        // Slow decay so layout is still settling when last node appears
        sim.alphaDecay(0.011);
        sim.alpha(1).restart();

        let i = 0;
        function step() {
          if (!timelapseActive || i >= timelapseSorted.length) {
            stopTimelapse();
            return;
          }
          const n = timelapseSorted[i++];
          birthProgress.set(n.id, 0.01); // trigger birth animation
          // Reheat simulation so layout keeps adjusting as nodes appear
          if (sim.alpha() < 0.2) sim.alpha(0.2).restart();
          // Progressively move camera toward current fit as nodes spread
          d3.select(canvas)
            .transition()
            .duration(STEP_MS * 1.5)
            .ease(d3.easeLinear)
            .call(zoom.transform, computeFitTransform());
          if (n.pubDatetime) {
            const d = new Date(n.pubDatetime);
            setDateAnimated(d.toLocaleDateString("ko-KR", { year: "numeric", month: "2-digit" }));
          }
          if (progressBar) {
            progressBar.style.width = `${(i / timelapseSorted.length) * 100}%`;
          }
          tickBirth();
          timelapsTimer = setTimeout(step, STEP_MS);
        }
        step();
      }

      animateBtn?.addEventListener("click", () => {
        if (timelapseActive) stopTimelapse();
        else startTimelapse();
      });
    }

    // Reset nodes to center cluster and animate from fit view
    const cx = (rect.width / 2 - fitTransform.x) / fitTransform.k;
    const cy = (rect.height / 2 - fitTransform.y) / fitTransform.k;
    nodesCopy.forEach(n => {
      n.x = cx + (Math.random() - 0.5) * 20;
      n.y = cy + (Math.random() - 0.5) * 20;
      n.vx = 0;
      n.vy = 0;
    });

    sim.on("tick", draw);
    sim.alpha(1).restart();

    // Drag with pin-on-release
    const drag = d3.drag()
      .subject(event => {
        const t = currentTransform;
        return sim.find((event.x - t.x) / t.k, (event.y - t.y) / t.k, 20) ?? null;
      })
      .on("start", event => {
        if (!event.subject) return;
        if (!event.active) sim.alphaTarget(0.3).restart();
        event.subject.fx = event.subject.x;
        event.subject.fy = event.subject.y;
      })
      .on("drag", event => {
        if (!event.subject) return;
        const t = currentTransform;
        event.subject.fx = (event.x - t.x) / t.k;
        event.subject.fy = (event.y - t.y) / t.k;
      })
      .on("end", event => {
        if (!event.subject) return;
        if (!event.active) sim.alphaTarget(0);
        // Pin the node at its current position
        pinnedNodes.add(event.subject.id);
        draw();
      });

    if (!isMini) d3.select(canvas).call(drag);

    // Double-click to unpin
    canvas.addEventListener("dblclick", event => {
      const t = currentTransform;
      const found = sim.find((event.offsetX - t.x) / t.k, (event.offsetY - t.y) / t.k, 20);
      if (found && pinnedNodes.has(found.id)) {
        pinnedNodes.delete(found.id);
        found.fx = null;
        found.fy = null;
        sim.alpha(0.3).restart();
        draw();
      }
    });

    // Hover
    canvas.addEventListener("mousemove", event => {
      const t = currentTransform;
      const nearest = sim.find((event.offsetX - t.x) / t.k, (event.offsetY - t.y) / t.k, 20) ?? null;
      const found = nearest?.type === "tag" ? null : nearest;
      const changed = found?.id !== hoveredNode?.id;
      hoveredNode = found;
      if (changed) startAnim();
      canvas.style.cursor = found?.url ? "pointer" : "default";
    });

    canvas.addEventListener("mouseleave", () => {
      hoveredNode = null;
      startAnim();
    });

    const bar = containerEl.querySelector(".graph-node-bar");
    const barTitle = containerEl.querySelector(".graph-node-bar-title");
    const barLink = containerEl.querySelector(".graph-node-bar-link");
    let barNode = null;

    function showBar(node) {
      if (!bar || !barTitle || !barLink) return;
      barTitle.textContent = node.title ?? "";
      barLink.href = node.url;
      bar.style.transform = "translateY(0)";
      bar.style.pointerEvents = "auto";
      barNode = node;
      hoveredNode = node;
      startAnim();
    }

    function hideBar() {
      if (!bar) return;
      bar.style.transform = "translateY(100%)";
      bar.style.pointerEvents = "none";
      barNode = null;
      hoveredNode = null;
      startAnim();
    }

    canvas.addEventListener("click", event => {
      const t = currentTransform;
      const nearest = sim.find((event.offsetX - t.x) / t.k, (event.offsetY - t.y) / t.k, 20);
      const found = nearest?.type === "tag" ? null : nearest;
      if (!found?.url) { hideBar(); return; }
      if (barNode?.id === found.id) { hideBar(); return; }
      showBar(found);
    });

    canvas.addEventListener("mousedown", event => {
      if (!barNode) return;
      const t = currentTransform;
      const found = sim.find((event.offsetX - t.x) / t.k, (event.offsetY - t.y) / t.k, 20);
      if (!found || found.id !== barNode.id) hideBar();
    });

    document.addEventListener("click", event => {
      if (!barNode) return;
      if (containerEl.contains(event.target)) return;
      hideBar();
    });

    const themeObserver = new MutationObserver(draw);
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

    if (initCategoryFilter !== "all") {
      triggerCatFilter();
      startAnim();
    }

    document.addEventListener("graph:filter", event => {
      categoryFilter = event.detail?.category ?? "all";
      triggerCatFilter();
      startAnim();
    });
  }

  function setup() {
    const container = document.getElementById(containerId);
    if (!container) return;
    if (container.offsetWidth === 0) {
      container.addEventListener("graph:show", () => initGraph(container), { once: true });
    } else {
      initGraph(container);
    }
  }

  setup();
  document.addEventListener("astro:after-swap", setup);
</script>
