---
interface Props {
  focusId?: string;
  height?: number;
}
const { focusId, height = 500 } = Astro.props;
const isMini = !!focusId;
const containerId = `graph-container-${Math.random().toString(36).slice(2)}`;
---

<div
  id={containerId}
  data-focus-id={focusId ?? ""}
  data-is-mini={isMini ? "true" : "false"}
  style={`height: ${height}px; width: 100%;`}
  class="relative overflow-hidden bg-background"
>
  <canvas style="width: 100%; height: 100%;"></canvas>
  <div class="graph-tooltip pointer-events-none absolute hidden text-xs text-foreground/70"></div>
  <!-- Node preview popup -->
  <div class="graph-preview pointer-events-none absolute hidden rounded-lg border border-border bg-background/95 backdrop-blur-sm px-3 py-2 shadow-lg max-w-[200px]">
    <div class="graph-preview-title text-sm font-medium text-foreground truncate"></div>
    <div class="graph-preview-meta text-xs text-foreground/40 mt-0.5"></div>
    <div class="text-xs text-accent mt-1">클릭하여 이동 →</div>
  </div>
  <!-- Zoom-to-fit button -->
  <button
    class="fit-btn absolute bottom-3 right-3 size-7 flex items-center justify-center rounded border border-border bg-background/80 text-foreground/40 hover:text-accent hover:border-accent transition-colors backdrop-blur-sm"
    title="Fit view"
    aria-label="Fit graph to view"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
    </svg>
  </button>
</div>

<script define:vars={{ containerId }}>
  async function initGraph(containerEl) {
    if (!containerEl) return;

    const focusId = containerEl.dataset.focusId || null;
    const isMini = containerEl.dataset.isMini === "true";

    const d3 = await import("https://cdn.jsdelivr.net/npm/d3@7/+esm");

    const res = await fetch("/graph.json");
    let { nodes, edges } = await res.json();

    if (isMini && focusId) {
      const neighborIds = new Set([focusId]);
      for (const e of edges) {
        if (e.source === focusId || e.target === focusId) {
          neighborIds.add(e.source);
          neighborIds.add(e.target);
        }
      }
      nodes = nodes.filter(n => neighborIds.has(n.id));
      edges = edges.filter(e => neighborIds.has(e.source) && neighborIds.has(e.target));
    }

    const canvas = containerEl.querySelector("canvas");
    const tooltip = containerEl.querySelector(".graph-tooltip");
    const preview = containerEl.querySelector(".graph-preview");
    const previewTitle = containerEl.querySelector(".graph-preview-title");
    const previewMeta = containerEl.querySelector(".graph-preview-meta");
    const fitBtn = containerEl.querySelector(".fit-btn");
    const rect = containerEl.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    const ctx = canvas.getContext("2d");

    const getVar = v => getComputedStyle(document.documentElement).getPropertyValue(v).trim();

    const CATEGORY_COLORS = {
      thought: "#a78bfa",
      tech:    "#60a5fa",
      writing: "#34d399",
      book:    "#fbbf24",
    };

    const nodesCopy = nodes.map(n => ({ ...n }));
    const edgesCopy = edges.map(e => ({ ...e }));

    // Degree
    const degree = new Map();
    for (const n of nodesCopy) degree.set(n.id, 0);
    for (const e of edges) {
      degree.set(e.source, (degree.get(e.source) ?? 0) + 1);
      degree.set(e.target, (degree.get(e.target) ?? 0) + 1);
    }

    // Remove isolated nodes
    const connectedIds = new Set(nodesCopy.filter(n => (degree.get(n.id) ?? 0) > 0).map(n => n.id));
    nodesCopy.splice(0, nodesCopy.length, ...nodesCopy.filter(n => connectedIds.has(n.id)));
    edgesCopy.splice(0, edgesCopy.length, ...edgesCopy.filter(e =>
      connectedIds.has(typeof e.source === "object" ? e.source.id : e.source) &&
      connectedIds.has(typeof e.target === "object" ? e.target.id : e.target)
    ));

    const nodeRadius = n => {
      if (n.type === "tag") return 4;
      return Math.min(5 + (degree.get(n.id) ?? 0) * 1.5, 14);
    };

    function nodeColor(n) {
      if (n.type === "tag") return "#888888";
      return CATEGORY_COLORS[n.category] ?? "#aaaaaa";
    }

    // Build adjacency for 2-hop lookup
    const adjacency = new Map();
    for (const n of nodesCopy) adjacency.set(n.id, new Set());
    for (const e of edgesCopy) {
      const sid = typeof e.source === "object" ? e.source.id : e.source;
      const tid = typeof e.target === "object" ? e.target.id : e.target;
      adjacency.get(sid)?.add(tid);
      adjacency.get(tid)?.add(sid);
    }

    function getHopSets(node) {
      const hop1 = new Set([node.id, ...(adjacency.get(node.id) ?? [])]);
      const hop2 = new Set(hop1);
      for (const id of adjacency.get(node.id) ?? []) {
        for (const nid of adjacency.get(id) ?? []) hop2.add(nid);
      }
      return { hop1, hop2 };
    }

    let hoveredNode = null;
    let pinnedNodes = new Set(); // IDs of pinned nodes
    let previewNode = null;      // node awaiting second click
    let currentTransform = d3.zoomIdentity;

    // Label fade threshold — matches Obsidian text-fade behaviour
    const LABEL_FADE_START = 0.6;
    const LABEL_FADE_END   = 1.3;
    function labelAlpha(k) {
      return Math.min(1, Math.max(0, (k - LABEL_FADE_START) / (LABEL_FADE_END - LABEL_FADE_START)));
    }

    function drawDotGrid(fg) {
      const spacing = 28;
      const dotR = 0.8 / currentTransform.k;
      const t = currentTransform;
      const x0 = -t.x / t.k;
      const y0 = -t.y / t.k;
      const x1 = (rect.width - t.x) / t.k;
      const y1 = (rect.height - t.y) / t.k;
      const startX = Math.floor(x0 / spacing) * spacing;
      const startY = Math.floor(y0 / spacing) * spacing;
      ctx.fillStyle = fg + "18";
      for (let gx = startX; gx < x1; gx += spacing) {
        for (let gy = startY; gy < y1; gy += spacing) {
          ctx.beginPath();
          ctx.arc(gx, gy, dotR, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }

    // Draw diamond shape for tag nodes
    function drawDiamond(x, y, r) {
      ctx.beginPath();
      ctx.moveTo(x, y - r * 1.4);
      ctx.lineTo(x + r, y);
      ctx.lineTo(x, y + r * 1.4);
      ctx.lineTo(x - r, y);
      ctx.closePath();
    }

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.translate(currentTransform.x, currentTransform.y);
      ctx.scale(currentTransform.k, currentTransform.k);

      const fg = getVar("--foreground") || "#e2e2e2";
      const accent = getVar("--accent") || "#f97316";
      const muted = getVar("--muted") || "#555";

      drawDotGrid(fg);

      const { hop1, hop2 } = hoveredNode ? getHopSets(hoveredNode) : { hop1: null, hop2: null };

      function nodeOpacity(id) {
        if (!hop1) return 1;
        if (hop1.has(id)) return 1;
        if (hop2.has(id)) return 0.45;
        return 0.1;
      }

      // Edges
      for (const e of edgesCopy) {
        if (!e.source.x) continue;
        const sid = e.source?.id ?? e.source;
        const tid = e.target?.id ?? e.target;
        const isActive = !hop1 || (hop1.has(sid) && hop1.has(tid));
        const opacity = hop1
          ? (isActive ? 1 : (hop2?.has(sid) || hop2?.has(tid) ? 0.2 : 0.05))
          : 1;

        ctx.globalAlpha = opacity;
        ctx.beginPath();
        ctx.moveTo(e.source.x, e.source.y);
        ctx.lineTo(e.target.x, e.target.y);
        if (e.type === "tag") {
          ctx.setLineDash([3, 4]);
          ctx.strokeStyle = muted + "66";
          ctx.lineWidth = 0.8;
        } else {
          ctx.setLineDash([]);
          ctx.strokeStyle = isActive ? fg + "cc" : fg + "44";
          ctx.lineWidth = isActive && hop1 ? 1.8 : 1.2;
        }
        ctx.stroke();
        ctx.setLineDash([]);
      }
      ctx.globalAlpha = 1;

      // Nodes
      for (const n of nodesCopy) {
        if (n.x == null) continue;
        const isFocused = n.id === focusId;
        const isHovered = hoveredNode?.id === n.id;
        const isPinned = pinnedNodes.has(n.id);
        const r = (isFocused || isHovered) ? Math.max(nodeRadius(n), 9) : nodeRadius(n);
        const baseColor = isFocused ? accent : nodeColor(n);
        const opacity = nodeOpacity(n.id);

        // Glow ring
        if (isHovered) {
          ctx.globalAlpha = 1;
          if (n.type === "tag") {
            drawDiamond(n.x, n.y, r + 5);
          } else {
            ctx.beginPath();
            ctx.arc(n.x, n.y, r + 5, 0, Math.PI * 2);
          }
          ctx.fillStyle = baseColor + "33";
          ctx.fill();
        } else if (isFocused) {
          ctx.globalAlpha = 1;
          ctx.beginPath();
          ctx.arc(n.x, n.y, r + 4, 0, Math.PI * 2);
          ctx.fillStyle = accent + "33";
          ctx.fill();
        }

        ctx.globalAlpha = opacity;
        if (n.type === "tag") {
          drawDiamond(n.x, n.y, r);
        } else {
          ctx.beginPath();
          ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
        }
        ctx.fillStyle = baseColor;
        ctx.fill();

        // Pin indicator — small dot at top-right of pinned nodes
        if (isPinned && n.type !== "tag") {
          ctx.globalAlpha = 1;
          ctx.beginPath();
          ctx.arc(n.x + r * 0.7, n.y - r * 0.7, 2.5, 0, Math.PI * 2);
          ctx.fillStyle = accent;
          ctx.fill();
        }

        ctx.globalAlpha = 1;
      }

      // Labels
      const zoomLabelAlpha = labelAlpha(currentTransform.k);
      ctx.textAlign = "center";

      for (const n of nodesCopy) {
        if (n.x == null || n.type === "tag") continue;
        const isHovered = hoveredNode?.id === n.id;
        const isHop1 = hop1?.has(n.id);

        let alpha;
        if (isHovered) {
          alpha = 1;
        } else if (hop1) {
          if (isHop1) alpha = 0.75;
          else alpha = 0;
        } else {
          alpha = zoomLabelAlpha;
        }

        if (alpha <= 0.01) continue;

        const r = nodeRadius(n);
        const fontSize = isHovered ? 11 : 9;
        ctx.font = `${isHovered ? "500 " : ""}${fontSize}px sans-serif`;
        const label = n.title?.length > 20 ? n.title.slice(0, 19) + "…" : n.title;
        ctx.globalAlpha = alpha;
        ctx.fillStyle = isHovered ? fg : fg + "aa";
        ctx.fillText(label, n.x, n.y + r + fontSize + 2);
        ctx.globalAlpha = 1;
      }

      ctx.restore();
    }

    const zoom = d3.zoom()
      .scaleExtent([0.2, 5])
      .on("zoom", event => {
        currentTransform = event.transform;
        draw();
      });

    d3.select(canvas).call(zoom);

    // Cluster nodes at center before silent convergence
    const cx0 = rect.width / 2;
    const cy0 = rect.height / 2;
    nodesCopy.forEach(n => {
      n.x = cx0 + (Math.random() - 0.5) * 20;
      n.y = cy0 + (Math.random() - 0.5) * 20;
      n.vx = 0;
      n.vy = 0;
    });

    const sim = d3.forceSimulation(nodesCopy)
      .force("link", d3.forceLink(edgesCopy).id(d => d.id).distance(e => e.type === "tag" ? 30 : 60))
      .force("charge", d3.forceManyBody().strength(n => n.type === "tag" ? -30 : -120))
      .force("center", d3.forceCenter(rect.width / 2, rect.height / 2))
      .force("collision", d3.forceCollide(n => nodeRadius(n) + 4));

    // Silently converge
    sim.stop();
    for (let i = 0; i < 300; i++) sim.tick();

    function computeFitTransform() {
      const postNodes = nodesCopy.filter(n => n.type !== "tag");
      const xs = postNodes.map(n => n.x).filter(x => x != null);
      const ys = postNodes.map(n => n.y).filter(y => y != null);
      if (!xs.length) return d3.zoomIdentity;
      const minX = Math.min(...xs), maxX = Math.max(...xs);
      const minY = Math.min(...ys), maxY = Math.max(...ys);
      const pad = 48;
      const k = Math.min(
        (rect.width - pad * 2) / (maxX - minX || 1),
        (rect.height - pad * 2) / (maxY - minY || 1),
        2
      );
      const tx = rect.width / 2 - k * (minX + maxX) / 2;
      const ty = rect.height / 2 - k * (minY + maxY) / 2;
      return d3.zoomIdentity.translate(tx, ty).scale(k);
    }

    const fitTransform = computeFitTransform();
    d3.select(canvas).call(zoom.transform, fitTransform);

    fitBtn?.addEventListener("click", () => {
      d3.select(canvas).transition().duration(400).call(zoom.transform, computeFitTransform());
    });

    // Reset nodes to center cluster and animate from fit view
    const cx = (rect.width / 2 - fitTransform.x) / fitTransform.k;
    const cy = (rect.height / 2 - fitTransform.y) / fitTransform.k;
    nodesCopy.forEach(n => {
      n.x = cx + (Math.random() - 0.5) * 20;
      n.y = cy + (Math.random() - 0.5) * 20;
      n.vx = 0;
      n.vy = 0;
    });

    sim.on("tick", draw);
    sim.alpha(1).restart();

    // Drag with pin-on-release
    const drag = d3.drag()
      .subject(event => {
        const t = currentTransform;
        return sim.find((event.x - t.x) / t.k, (event.y - t.y) / t.k, 20) ?? null;
      })
      .on("start", event => {
        if (!event.subject) return;
        if (!event.active) sim.alphaTarget(0.3).restart();
        event.subject.fx = event.subject.x;
        event.subject.fy = event.subject.y;
      })
      .on("drag", event => {
        if (!event.subject) return;
        const t = currentTransform;
        event.subject.fx = (event.x - t.x) / t.k;
        event.subject.fy = (event.y - t.y) / t.k;
      })
      .on("end", event => {
        if (!event.subject) return;
        if (!event.active) sim.alphaTarget(0);
        // Pin the node at its current position
        pinnedNodes.add(event.subject.id);
        draw();
      });

    d3.select(canvas).call(drag);

    // Double-click to unpin
    canvas.addEventListener("dblclick", event => {
      const t = currentTransform;
      const found = sim.find((event.offsetX - t.x) / t.k, (event.offsetY - t.y) / t.k, 20);
      if (found && pinnedNodes.has(found.id)) {
        pinnedNodes.delete(found.id);
        found.fx = null;
        found.fy = null;
        sim.alpha(0.3).restart();
        draw();
      }
    });

    // Hover — show tooltip with connection count
    canvas.addEventListener("mousemove", event => {
      const t = currentTransform;
      const found = sim.find((event.offsetX - t.x) / t.k, (event.offsetY - t.y) / t.k, 20) ?? null;
      const changed = found?.id !== hoveredNode?.id;
      hoveredNode = found;
      if (changed) draw();

      if (found) {
        const connections = degree.get(found.id) ?? 0;
        const connLabel = found.type === "tag"
          ? `tag · ${connections} posts`
          : `${connections} connection${connections !== 1 ? "s" : ""}`;
        tooltip.textContent = `${found.title}  —  ${connLabel}`;
        tooltip.style.left = `${event.offsetX + 12}px`;
        tooltip.style.top = `${event.offsetY - 4}px`;
        tooltip.classList.remove("hidden");
        canvas.style.cursor = found.url ? "pointer" : "default";
      } else {
        tooltip.classList.add("hidden");
        canvas.style.cursor = "default";
      }
    });

    canvas.addEventListener("mouseleave", () => {
      hoveredNode = null;
      tooltip.classList.add("hidden");
      draw();
    });

    // Click: first click shows preview, second click navigates
    canvas.addEventListener("click", event => {
      const t = currentTransform;
      const found = sim.find((event.offsetX - t.x) / t.k, (event.offsetY - t.y) / t.k, 20) ?? null;

      if (!found?.url) {
        previewNode = null;
        preview.classList.add("hidden");
        return;
      }

      if (previewNode?.id === found.id) {
        // Second click — navigate
        window.location.href = found.url;
        return;
      }

      // First click — show preview
      previewNode = found;
      previewTitle.textContent = found.title;
      previewMeta.textContent = found.pubDatetime
        ? new Date(found.pubDatetime).toLocaleDateString("ko-KR", { year: "numeric", month: "2-digit", day: "2-digit" })
        : found.category ?? "";

      // Position preview, keep within canvas bounds
      const pw = 200, ph = 80;
      let px = event.offsetX + 16;
      let py = event.offsetY - ph / 2;
      if (px + pw > rect.width) px = event.offsetX - pw - 16;
      if (py < 0) py = 4;
      if (py + ph > rect.height) py = rect.height - ph - 4;

      preview.style.left = `${px}px`;
      preview.style.top = `${py}px`;
      preview.classList.remove("hidden");
    });

    // Hide preview when clicking outside a node
    canvas.addEventListener("mousedown", event => {
      const t = currentTransform;
      const found = sim.find((event.offsetX - t.x) / t.k, (event.offsetY - t.y) / t.k, 20) ?? null;
      if (!found) {
        previewNode = null;
        preview.classList.add("hidden");
      }
    });

    const themeObserver = new MutationObserver(draw);
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  }

  function setup() {
    const container = document.getElementById(containerId);
    if (!container) return;
    if (container.offsetWidth === 0) {
      container.addEventListener("graph:show", () => initGraph(container), { once: true });
    } else {
      initGraph(container);
    }
  }

  setup();
  document.addEventListener("astro:after-swap", setup);
</script>
