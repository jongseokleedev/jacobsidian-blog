---
import "@pagefind/default-ui/css/ui.css";
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenu from "@/assets/icons/IconMenu.svg";
import Logo from "./Logo.astro";
import { SITE } from "@/config";
import { PARENTS } from "@/utils/getCategories";

const { pathname } = Astro.url;

const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  Skip to content
</a>

<header class="sticky top-0 z-10 w-full">
  <div
    id="top-nav-wrap"
    class="border-b border-border w-full bg-background/90 backdrop-blur-sm"
  >
    <div class="flex items-center justify-between px-6 py-0" style="height:56px;">
      <Logo size={20} />

      <!-- 데스크탑: 검색 pill + 테마 + RSS + 우측 패널 토글 -->
      <div class="hidden sm:flex items-center gap-3">
        <button
          id="search-pill-btn"
          class="flex items-center gap-2 rounded-[6px] border border-border px-3 py-1.5 text-[13px] hover:border-accent hover:text-accent transition-colors"
          style="min-width:200px; color: var(--fg-faint);"
          aria-label="Search"
        >
          <IconSearch class="size-3.5 shrink-0" />
          <span class="flex-1 text-left">Wander Jacob's second brain…</span>
          <kbd class="font-mono text-[11px] opacity-50">⌘K</kbd>
        </button>
        {SITE.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="focus-outline relative size-8 p-1 hover:[&>svg]:stroke-accent"
            title="Toggles light & dark"
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )}
        <!-- 양쪽 패널 동시 토글 (데스크탑) -->
        <button
          id="toggle-both-rails"
          class="focus-outline hidden lg:flex items-center justify-center size-8 p-1 hover:[&>svg]:stroke-accent"
          style="color:var(--fg-faint);"
          aria-label="패널 접기/펼치기"
          title="패널 토글"
        >
          <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <path d="M9 3v18"/>
            <path d="M15 3v18"/>
          </svg>
        </button>
      </div>

      <!-- 모바일 우측: 검색 + 테마 + 햄버거 -->
      <div class="flex items-center gap-1 sm:hidden">
        <button
          id="search-pill-btn-mobile"
          class="focus-outline p-2 hover:text-accent"
          aria-label="Search"
        >
          <IconSearch class="size-4" />
          <span class="sr-only">Search</span>
        </button>
        {SITE.lightAndDarkMode && (
          <button
            id="theme-btn-mobile"
            class="focus-outline relative size-10 p-2 hover:[&>svg]:stroke-accent"
            title="Toggles light & dark"
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )}
        <button
          id="menu-btn"
          class="focus-outline p-2"
          aria-label="Open Menu"
          aria-expanded="false"
          aria-controls="menu-items"
        >
          <IconX id="close-icon" class="hidden" />
          <IconMenu id="menu-icon" />
        </button>
      </div>
    </div>

    <!-- 모바일 드롭다운 메뉴 -->
    <div id="menu-items" class="overflow-hidden sm:hidden" style="max-height: 0; transition: max-height 300ms cubic-bezier(0.4, 0, 0.2, 1), opacity 220ms ease; opacity: 0;">
      <nav class="pb-4 px-4 flex flex-col">
        {Object.entries(PARENTS).map(([parentKey, parentMeta]) => {
          const isParentActive = isActive(`/${parentKey}`);
          return (
            <div class="mobile-cat-item" data-parent={parentKey}>
              <div class="flex items-center">
                <a
                  href={`/${parentKey}`}
                  class:list={[
                    "flex-1 flex items-center gap-2 px-2 py-2.5 text-sm font-medium rounded transition-colors hover:text-accent",
                    isParentActive ? "text-accent" : "",
                  ]}
                >
                  <span class="w-1.5 h-1.5 rounded-full shrink-0" style={`background:${parentMeta.color}`} />
                  {parentMeta.label}
                </a>
                <button
                  class="mobile-cat-toggle flex items-center justify-center rounded hover:text-accent transition-colors shrink-0"
                  style="width:40px; height:40px; color: var(--fg-faint);"
                  data-target={parentKey}
                  aria-expanded={isParentActive ? "true" : "false"}
                  aria-label={`${parentMeta.label} 서브카테고리 열기`}
                >
                  <svg
                    class:list={["size-3.5 transition-transform duration-200", isParentActive ? "rotate-90" : ""]}
                    xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                  >
                    <polyline points="9 18 15 12 9 6"/>
                  </svg>
                </button>
              </div>
              <div
                id={`mobile-sub-wrap-${parentKey}`}
                class="overflow-hidden"
                style={`max-height: ${isParentActive ? "200px" : "0"}; transition: max-height 220ms cubic-bezier(0.4, 0, 0.2, 1);`}
              >
                <ul class="ml-4 mb-1 flex flex-col border-l border-border">
                  {Object.entries(parentMeta.subs).map(([subKey, subMeta]) => (
                    <li>
                      <a
                        href={`/${parentKey}/${subKey}`}
                        class:list={[
                          "block text-[13px] py-2 pl-4 rounded-r transition-colors hover:text-accent",
                          isActive(`/${parentKey}/${subKey}`)
                            ? "text-accent font-medium"
                            : "text-[color:var(--fg-mute)]",
                        ]}
                      >
                        <span class="block">{subMeta.label}</span>
                        <span class="block text-[11px] leading-tight mt-0.5" style="color: var(--fg-faint);">{subMeta.desc}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        })}
        <a
          href="/about"
          class:list={[
            "flex items-center gap-2 px-2 py-2.5 text-sm font-medium rounded transition-colors hover:text-accent",
            isActive("/about") ? "text-accent" : "",
          ]}
        >
          <span class="w-1.5 h-1.5 rounded-full shrink-0 opacity-0" aria-hidden="true" />
          About
        </a>
      </nav>
    </div>
  </div>
</header>

<!-- Search modal -->
<dialog
  id="search-modal"
  class="fixed inset-0 z-50 m-0 h-full w-full max-h-none max-w-none bg-transparent p-0"
>
  <div
    class="mx-auto mt-[10vh] rounded-lg border border-border bg-background shadow-2xl"
    style="max-width:560px; width: calc(100% - 2rem);"
  >
    <div class="flex items-center justify-between border-b border-border px-4 py-3">
      <div class="flex items-center gap-2" style="color: var(--fg-faint);">
        <IconSearch class="size-4 shrink-0" />
        <span class="text-[13px]">Jacob's second brain 탐색</span>
      </div>
      <button
        id="search-modal-close"
        class="rounded p-1 hover:text-accent transition-colors text-[12px] font-mono"
        style="color: var(--fg-faint);"
        aria-label="Close search"
      >
        ESC
      </button>
    </div>
    <div id="search-modal-body" class="p-4">
      <!-- DEV 경고 (빌드 전에만 표시) -->
      <p id="search-dev-warning" class="hidden text-sm p-2 rounded bg-muted text-foreground/60">
        검색은 빌드 후 동작합니다:
        <code class="font-mono">pnpm run build</code>
      </p>
      <div id="pagefind-modal-ui"></div>
    </div>
  </div>
</dialog>

<script>
  let controller = new AbortController();

  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items") as HTMLElement | null;
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    function getMenuScrollHeight(): number {
      return menuItems!.scrollHeight;
    }

    menuBtn.addEventListener("click", () => {
      const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
      const next = !isOpen;
      menuBtn.setAttribute("aria-expanded", next ? "true" : "false");
      menuBtn.setAttribute("aria-label", next ? "Close Menu" : "Open Menu");
      menuItems.style.maxHeight = next ? `${getMenuScrollHeight()}px` : "0";
      menuItems.style.opacity = next ? "1" : "0";
      menuIcon.classList.toggle("hidden", next);
      closeIcon.classList.toggle("hidden", !next);
    }, { signal: controller.signal });

    // 서브카테고리 아코디언 토글
    document.querySelectorAll<HTMLButtonElement>(".mobile-cat-toggle").forEach(btn => {
      btn.addEventListener("click", () => {
        const key = btn.dataset.target!;
        const wrap = document.getElementById(`mobile-sub-wrap-${key}`);
        const svg = btn.querySelector("svg");
        if (!wrap) return;
        const isOpen = btn.getAttribute("aria-expanded") === "true";
        if (isOpen) {
          btn.setAttribute("aria-expanded", "false");
          btn.setAttribute("aria-label", btn.getAttribute("aria-label")?.replace("닫기", "열기") ?? "");
          svg?.classList.remove("rotate-90");
          wrap.style.maxHeight = "0";
          setTimeout(() => {
            if (menuItems && menuBtn.getAttribute("aria-expanded") === "true") {
              menuItems.style.maxHeight = `${getMenuScrollHeight()}px`;
            }
          }, 230);
        } else {
          btn.setAttribute("aria-expanded", "true");
          btn.setAttribute("aria-label", btn.getAttribute("aria-label")?.replace("열기", "닫기") ?? "");
          svg?.classList.add("rotate-90");
          const inner = wrap.querySelector("ul");
          const innerH = inner ? inner.scrollHeight + 8 : 200;
          wrap.style.maxHeight = `${innerH}px`;
          // 외부 높이 즉시 확장 후 transition 완료 시점에 정확한 값으로 맞춤
          if (menuItems) menuItems.style.maxHeight = `${getMenuScrollHeight() + innerH}px`;
          setTimeout(() => {
            if (menuItems && menuBtn.getAttribute("aria-expanded") === "true") {
              menuItems.style.maxHeight = `${getMenuScrollHeight()}px`;
            }
          }, 230);
        }
      }, { signal: controller.signal });
    });

    // 서브카테고리 링크 클릭 시 메뉴 닫기
    document.querySelectorAll<HTMLAnchorElement>(".mobile-cat-item a[href]").forEach(link => {
      link.addEventListener("click", () => {
        menuBtn.setAttribute("aria-expanded", "false");
        menuBtn.setAttribute("aria-label", "Open Menu");
        menuItems.style.maxHeight = "0";
        menuItems.style.opacity = "0";
        menuIcon.classList.remove("hidden");
        closeIcon.classList.add("hidden");
      }, { signal: controller.signal });
    });
  }

  function syncThemeButtons() {
    const mobileBtn = document.querySelector("#theme-btn-mobile");
    const desktopBtn = document.querySelector("#theme-btn");
    if (!mobileBtn || !desktopBtn) return;
    mobileBtn.addEventListener("click", () => (desktopBtn as HTMLElement).click(), { signal: controller.signal });
  }

  function initScrollBorder() {
    const nav = document.querySelector<HTMLElement>("#top-nav-wrap");
    if (!nav) return;
    const update = () => nav.classList.toggle("scrolled", window.scrollY > 10);
    update();
    window.addEventListener("scroll", update, { passive: true, signal: controller.signal });
  }

  let pagefindLoaded = false;

  async function openSearchModal() {
    const modal = document.querySelector("#search-modal") as HTMLDialogElement | null;
    if (!modal) return;

    modal.showModal();

    if (!pagefindLoaded) {
      pagefindLoaded = true;

      if (import.meta.env.DEV) {
        document.querySelector("#search-dev-warning")?.classList.remove("hidden");
        return;
      }

      // @ts-expect-error — Missing types for @pagefind/default-ui
      const { PagefindUI } = await import("@pagefind/default-ui");
      new PagefindUI({
        element: "#pagefind-modal-ui",
        showImages: false,
        showSubResults: true,
      });
    }

    setTimeout(() => {
      const input = modal.querySelector<HTMLInputElement>(".pagefind-ui__search-input");
      input?.focus();
    }, 50);
  }

  function closeSearchModal() {
    const modal = document.querySelector("#search-modal") as HTMLDialogElement | null;
    modal?.close();
  }

  function initSearchModal() {
    const modal = document.querySelector("#search-modal") as HTMLDialogElement | null;
    if (!modal) return;

    document.querySelector("#search-pill-btn")?.addEventListener("click", openSearchModal, { signal: controller.signal });
    document.querySelector("#search-pill-btn-mobile")?.addEventListener("click", openSearchModal, { signal: controller.signal });
    document.querySelector("#search-modal-close")?.addEventListener("click", closeSearchModal, { signal: controller.signal });

    modal.addEventListener("click", e => {
      if (e.target === modal) closeSearchModal();
    }, { signal: controller.signal });

    document.addEventListener("keydown", e => {
      if ((e.metaKey || e.ctrlKey) && e.key === "k") {
        e.preventDefault();
        if (modal.open) { closeSearchModal(); } else { openSearchModal(); }
      }
    }, { signal: controller.signal });
  }

  function init() {
    toggleNav();
    syncThemeButtons();
    initScrollBorder();
    initSearchModal();
  }

  init();

  document.addEventListener("astro:before-swap", () => {
    controller.abort();
    controller = new AbortController();
  });

  document.addEventListener("astro:after-swap", () => {
    pagefindLoaded = false;
    init();
  });
</script>

<style is:global>
  #search-modal::backdrop {
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(4px);
  }

  #pagefind-modal-ui {
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--background);
    --pagefind-ui-border-radius: 0.375rem;
    --pagefind-ui-border-width: 1px;
  }

  #pagefind-modal-ui .pagefind-ui__search-input {
    font-weight: 400;
    border: 1px solid var(--border);
  }

  #pagefind-modal-ui .pagefind-ui__search-input:focus-visible {
    outline: 1px solid var(--accent);
  }

  #pagefind-modal-ui .pagefind-ui__form::before {
    background-color: var(--foreground);
  }

  #pagefind-modal-ui .pagefind-ui__result-title a {
    color: var(--accent);
  }

  #pagefind-modal-ui .pagefind-ui__result:last-of-type {
    border-bottom: 0;
  }
</style>
