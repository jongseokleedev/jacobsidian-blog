---
import "@pagefind/default-ui/css/ui.css";
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenu from "@/assets/icons/IconMenu.svg";
import Logo from "./Logo.astro";
import { SITE } from "@/config";

const { pathname } = Astro.url;

const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  Skip to content
</a>

<header class="sticky top-0 z-10 w-full" style="view-transition-name: site-header;">
  <div
    id="top-nav-wrap"
    class="border-b border-border w-full bg-background/90 backdrop-blur-sm"
  >
    <div class="flex items-center justify-between px-6 py-0" style="height:56px;">
      <Logo size={20} />

      <!-- 데스크탑: 검색 pill + 테마 + RSS -->
      <div class="hidden sm:flex items-center gap-3">
        <button
          id="search-pill-btn"
          class="flex items-center gap-2 rounded-[6px] border border-border px-3 py-1.5 text-[13px] hover:border-accent hover:text-accent transition-colors"
          style="min-width:200px; color: var(--fg-faint);"
          aria-label="Search"
        >
          <IconSearch class="size-3.5 shrink-0" />
          <span class="flex-1 text-left">Wander Jacob's second brain…</span>
          <kbd class="font-mono text-[11px] opacity-50">⌘K</kbd>
        </button>
        {SITE.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="focus-outline relative size-8 p-1 hover:[&>svg]:stroke-accent"
            title="Toggles light & dark"
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )}
        <a href="/rss.xml" title="RSS" class="focus-outline p-1 hover:text-accent" style="color: var(--fg-faint);">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
          <span class="sr-only">RSS</span>
        </a>
      </div>

      <!-- 모바일 우측: 검색 + 테마 + 햄버거 -->
      <div class="flex items-center gap-1 sm:hidden">
        <button
          id="search-pill-btn-mobile"
          class="focus-outline p-2 hover:text-accent"
          aria-label="Search"
        >
          <IconSearch class="size-4" />
          <span class="sr-only">Search</span>
        </button>
        {SITE.lightAndDarkMode && (
          <button
            id="theme-btn-mobile"
            class="focus-outline relative size-10 p-2 hover:[&>svg]:stroke-accent"
            title="Toggles light & dark"
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )}
        <button
          id="menu-btn"
          class="focus-outline p-2"
          aria-label="Open Menu"
          aria-expanded="false"
          aria-controls="menu-items"
        >
          <IconX id="close-icon" class="hidden" />
          <IconMenu id="menu-icon" />
        </button>
      </div>
    </div>

    <!-- 모바일 드롭다운 메뉴 -->
    <div id="menu-items" class="overflow-hidden" style="max-height: 0; transition: max-height 280ms cubic-bezier(0.4, 0, 0.2, 1), opacity 220ms ease; opacity: 0;">
      <ul class="pb-4 px-6 flex flex-col gap-1 sm:hidden
        [&>li>a]:block [&>li>a]:px-2 [&>li>a]:py-2.5 [&>li>a]:text-sm [&>li>a]:font-medium [&>li>a]:hover:text-accent">
        <li><a href="/essay"   class:list={{ "active-nav": isActive("/essay") }}>Essay</a></li>
        <li><a href="/tech"    class:list={{ "active-nav": isActive("/tech") }}>Tech</a></li>
        <li><a href="/review"  class:list={{ "active-nav": isActive("/review") }}>Review</a></li>
        <li><a href="/fiction" class:list={{ "active-nav": isActive("/fiction") }}>Fiction</a></li>
        <li><a href="/about"   class:list={{ "active-nav": isActive("/about") }}>About</a></li>
      </ul>
    </div>
  </div>
</header>

<!-- Search modal -->
<dialog
  id="search-modal"
  class="fixed inset-0 z-50 m-0 h-full w-full max-h-none max-w-none bg-transparent p-0"
>
  <div
    class="mx-auto mt-[10vh] rounded-lg border border-border bg-background shadow-2xl"
    style="max-width:560px; width: calc(100% - 2rem);"
  >
    <div class="flex items-center justify-between border-b border-border px-4 py-3">
      <div class="flex items-center gap-2" style="color: var(--fg-faint);">
        <IconSearch class="size-4 shrink-0" />
        <span class="text-[13px]">Jacob's second brain 탐색</span>
      </div>
      <button
        id="search-modal-close"
        class="rounded p-1 hover:text-accent transition-colors text-[12px] font-mono"
        style="color: var(--fg-faint);"
        aria-label="Close search"
      >
        ESC
      </button>
    </div>
    <div id="search-modal-body" class="p-4">
      <!-- DEV 경고 (빌드 전에만 표시) -->
      <p id="search-dev-warning" class="hidden text-sm p-2 rounded bg-muted text-foreground/60">
        검색은 빌드 후 동작합니다:
        <code class="font-mono">pnpm run build</code>
      </p>
      <div id="pagefind-modal-ui"></div>
    </div>
  </div>
</dialog>

<script>
  let controller = new AbortController();

  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items") as HTMLElement | null;
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const MENU_HEIGHT = 220;

    menuBtn.addEventListener("click", () => {
      const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
      const next = !isOpen;
      menuBtn.setAttribute("aria-expanded", next ? "true" : "false");
      menuBtn.setAttribute("aria-label", next ? "Close Menu" : "Open Menu");
      menuItems.style.maxHeight = next ? `${MENU_HEIGHT}px` : "0";
      menuItems.style.opacity = next ? "1" : "0";
      menuIcon.classList.toggle("hidden", next);
      closeIcon.classList.toggle("hidden", !next);
    }, { signal: controller.signal });
  }

  function syncThemeButtons() {
    const mobileBtn = document.querySelector("#theme-btn-mobile");
    const desktopBtn = document.querySelector("#theme-btn");
    if (!mobileBtn || !desktopBtn) return;
    mobileBtn.addEventListener("click", () => (desktopBtn as HTMLElement).click(), { signal: controller.signal });
  }

  function initScrollBorder() {
    const nav = document.querySelector("#top-nav-wrap");
    if (!nav) return;
    const update = () => nav.classList.toggle("scrolled", window.scrollY > 10);
    update();
    window.addEventListener("scroll", update, { passive: true, signal: controller.signal });
  }

  let pagefindLoaded = false;

  async function openSearchModal() {
    const modal = document.querySelector("#search-modal") as HTMLDialogElement | null;
    if (!modal) return;

    modal.showModal();

    if (!pagefindLoaded) {
      pagefindLoaded = true;

      if (import.meta.env.DEV) {
        document.querySelector("#search-dev-warning")?.classList.remove("hidden");
        return;
      }

      // @ts-expect-error — Missing types for @pagefind/default-ui
      const { PagefindUI } = await import("@pagefind/default-ui");
      new PagefindUI({
        element: "#pagefind-modal-ui",
        showImages: false,
        showSubResults: true,
      });
    }

    setTimeout(() => {
      const input = modal.querySelector<HTMLInputElement>(".pagefind-ui__search-input");
      input?.focus();
    }, 50);
  }

  function closeSearchModal() {
    const modal = document.querySelector("#search-modal") as HTMLDialogElement | null;
    modal?.close();
  }

  function initSearchModal() {
    const modal = document.querySelector("#search-modal") as HTMLDialogElement | null;
    if (!modal) return;

    document.querySelector("#search-pill-btn")?.addEventListener("click", openSearchModal, { signal: controller.signal });
    document.querySelector("#search-pill-btn-mobile")?.addEventListener("click", openSearchModal, { signal: controller.signal });
    document.querySelector("#search-modal-close")?.addEventListener("click", closeSearchModal, { signal: controller.signal });

    modal.addEventListener("click", e => {
      if (e.target === modal) closeSearchModal();
    }, { signal: controller.signal });

    document.addEventListener("keydown", e => {
      if ((e.metaKey || e.ctrlKey) && e.key === "k") {
        e.preventDefault();
        if (modal.open) { closeSearchModal(); } else { openSearchModal(); }
      }
    }, { signal: controller.signal });
  }

  function init() {
    toggleNav();
    syncThemeButtons();
    initScrollBorder();
    initSearchModal();
  }

  init();

  document.addEventListener("astro:before-swap", () => {
    controller.abort();
    controller = new AbortController();
  });

  document.addEventListener("astro:after-swap", () => {
    pagefindLoaded = false;
    init();
  });
</script>

<style is:global>
  #search-modal::backdrop {
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(4px);
  }

  #pagefind-modal-ui {
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--background);
    --pagefind-ui-border-radius: 0.375rem;
    --pagefind-ui-border-width: 1px;
  }

  #pagefind-modal-ui .pagefind-ui__search-input {
    font-weight: 400;
    border: 1px solid var(--border);
  }

  #pagefind-modal-ui .pagefind-ui__search-input:focus-visible {
    outline: 1px solid var(--accent);
  }

  #pagefind-modal-ui .pagefind-ui__form::before {
    background-color: var(--foreground);
  }

  #pagefind-modal-ui .pagefind-ui__result-title a {
    color: var(--accent);
  }

  #pagefind-modal-ui .pagefind-ui__result:last-of-type {
    border-bottom: 0;
  }
</style>
