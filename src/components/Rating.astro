---
interface Props {
  value?: number | null;
  size?: "sm" | "md";
  showText?: boolean;
  class?: string;
}

const { value, size = "md", showText = false, class: className = "" } = Astro.props;

if (value == null) return null;

const clamped = Math.max(0, Math.min(5, Math.round(value * 2) / 2));
const stars = [1, 2, 3, 4, 5].map(i => {
  const diff = clamped - (i - 1);
  return diff >= 1 ? 100 : diff >= 0.5 ? 50 : 0;
});

const dim = size === "sm" ? 12 : 16;
const gap = size === "sm" ? "gap-[1px]" : "gap-0.5";
const textCls = size === "sm" ? "text-[11px]" : "text-[12.5px]";
---

<span
  class:list={["inline-flex items-center", gap, className]}
  aria-label={`별점 ${clamped}점 / 5점`}
  role="img"
>
  {stars.map((fill, idx) => (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={dim}
      height={dim}
      viewBox="0 0 24 24"
      aria-hidden="true"
      class="shrink-0"
    >
      <defs>
        <linearGradient id={`star-${idx}-${dim}-${fill}`} x1="0" x2="1" y1="0" y2="0">
          <stop offset={`${fill}%`} stop-color="var(--star)" />
          <stop offset={`${fill}%`} stop-color="var(--fg-faint)" stop-opacity="0.35" />
        </linearGradient>
      </defs>
      <path
        d="M12 2.5l2.95 5.98 6.6.96-4.78 4.66 1.13 6.58L12 17.6l-5.9 3.1 1.13-6.58L2.45 9.44l6.6-.96L12 2.5z"
        fill={`url(#star-${idx}-${dim}-${fill})`}
      />
    </svg>
  ))}
  {showText && (
    <span class:list={["ml-1.5 font-mono tabular-nums", textCls]} style="color: var(--fg-mute);">
      {clamped.toFixed(1)}
    </span>
  )}
</span>
