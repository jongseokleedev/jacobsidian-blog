---
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import Datetime from "@/components/Datetime.astro";

type Entry = CollectionEntry<"posts">;

type Props = {
  currentPost: Entry;
  allPosts: Entry[];
};

const { currentPost, allPosts } = Astro.props;

const linkedIds = new Set<string>();

const linkedPosts = (currentPost.data.links ?? [])
  .map(linkTitle => allPosts.find(p => p.data.title === linkTitle && !p.data.draft))
  .filter((p): p is Entry => p !== undefined)
  .filter(p => {
    if (linkedIds.has(p.id)) return false;
    linkedIds.add(p.id);
    return true;
  });

const currentTags = currentPost.data.tags ?? [];
const remaining = 5 - linkedPosts.length;

const tagBased = remaining > 0
  ? allPosts
      .filter(p => p.id !== currentPost.id && !p.data.draft && !linkedIds.has(p.id))
      .map(p => ({
        post: p,
        score: (p.data.tags ?? []).filter(t => currentTags.includes(t)).length,
      }))
      .filter(({ score }) => score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, remaining)
      .map(({ post }) => post)
  : [];

const related = [...linkedPosts, ...tagBased];
---

{related.length > 0 && (
  <section class="mt-12 pt-8 border-t" style="border-color: var(--border);">
    <h2 class="text-sm font-semibold mb-4" style="color: var(--fg-mute);">See Also</h2>
    <ul class="space-y-3">
      {related.map(post => (
        <li>
          <a
            href={getPath(post)}
            class="group flex flex-col gap-0.5 hover:text-accent transition-colors"
          >
            <span class="text-sm font-medium">{post.data.title}</span>
            <Datetime pubDatetime={post.data.pubDatetime} />
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
