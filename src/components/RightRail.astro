---
import { getCollection } from "astro:content";
import { getCategoryMeta, PARENTS, parseCategory } from "@/utils/getCategories";
import getSortedPosts from "@/utils/getSortedPosts";
import GraphCanvas from "@/components/GraphCanvas.astro";

type Variant = "discovery" | "category" | "reading";

interface Props {
  variant: Variant;
  postId?: string;
  categoryKey?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const { variant, postId, categoryKey, headings = [] } = Astro.props;

const rawPosts = await getCollection("posts");
const allPosts = getSortedPosts(rawPosts);
const totalNotes = rawPosts.length;
const uniqueTags = new Set(allPosts.flatMap(p => p.data.tags ?? [])).size;
const totalLinks = rawPosts.reduce((sum, p) => sum + p.data.links.length, 0);
const oneWeekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
const thisWeekCount = allPosts.filter(p => new Date(p.data.pubDatetime) >= oneWeekAgo).length;
const recentPosts = allPosts.slice(0, 4);

// categoryKey can be a parent key ("essay") or a full key ("essay-thought")
const isParentKey = categoryKey ? !!PARENTS[categoryKey] && !categoryKey.includes("-") : false;
const catParentKey = categoryKey
  ? (isParentKey ? categoryKey : categoryKey.split("-")[0])
  : undefined;
const catMeta = categoryKey
  ? (isParentKey ? PARENTS[categoryKey] : getCategoryMeta(categoryKey))
  : undefined;
const catPosts = categoryKey
  ? allPosts
      .filter(p =>
        isParentKey
          ? p.data.category.startsWith(`${categoryKey}-`)
          : p.data.category === categoryKey
      )
      .slice(0, 4)
  : recentPosts;
const catPostCount = categoryKey
  ? allPosts.filter(p =>
      isParentKey
        ? p.data.category.startsWith(`${categoryKey}-`)
        : p.data.category === categoryKey
    ).length
  : 0;
const thisWeekPosts = variant === "category" ? catPosts : recentPosts;

// For reading variant: related posts and backlinks
const currentPost = postId
  ? allPosts.find(p => p.id === postId || p.data.slug === postId)
  : undefined;
const links: string[] = currentPost?.data.links ?? [];
const relatedPosts = links
  .map((id: string) => allPosts.find(p => p.id === id || p.data.slug === id))
  .filter((p): p is NonNullable<typeof p> => !!p)
  .slice(0, 5);
const backlinks = postId
  ? allPosts
      .filter(p => (p.data.links ?? []).includes(postId))
      .slice(0, 5)
  : [];

// Category URL helper
function catUrl(key: string) {
  const { parent, sub } = parseCategory(key);
  return `/${parent}/${sub}`;
}

// Post URL helper
const postUrl = (post: (typeof allPosts)[number]) => {
  const slug = post.data.slug ?? post.id;
  return `${catUrl(post.data.category)}/${slug}`;
};
---

<aside
  id="right-rail"
  class="hidden lg:block border-l border-border"
  style="position:fixed; right:0; top:56px; width:260px; height:calc(100vh - 56px); overflow:hidden; transform:translateX(var(--right-rail-tx, 0px)); transition:transform 280ms cubic-bezier(0.4,0,0.2,1); z-index:5;"
>
<div style="width:260px; height:100%; overflow-y:auto; padding:28px 24px; gap:26px;" class="flex flex-col">
  {variant === "discovery" && (
    <>
      <!-- NOW READING (hydrated from localStorage, hidden until JS confirms data) -->
      <section id="now-reading-section" class="hidden">
        <p class="bd-overline mb-2">Now Reading</p>
        <div id="now-reading-content">
          <div class="flex gap-2.5 items-start">
            <div id="now-reading-thumb" class="hidden shrink-0 rounded bg-muted" style="width:40px;height:58px;" />
            <div class="min-w-0">
              <a id="now-reading-title" href="#" class="block text-[13px] font-medium leading-snug hover:text-accent transition-colors"></a>
              <p id="now-reading-author" class="text-[11.5px] mt-0.5" style="color:var(--fg-faint);"></p>
              <div class="mt-2 h-[2px] bg-muted rounded-full overflow-hidden">
                <div id="now-reading-bar" class="h-full bg-accent rounded-full transition-all" style="width:0%"></div>
              </div>
              <p id="now-reading-pct" class="font-mono text-[10px] mt-1" style="color:var(--fg-faint);"></p>
            </div>
          </div>
        </div>
      </section>

      <!-- THIS WEEK -->
      <section>
        <p class="bd-overline mb-2">This Week</p>
        <ul class="flex flex-col gap-3">
          {thisWeekPosts.map(post => (
            <li>
              <a href={postUrl(post)} class="block hover:text-accent transition-colors">
                <span class="block font-mono text-[10.5px] mb-0.5 text-[color:var(--fg-veryfaint)]">
                  {new Date(post.data.pubDatetime).toLocaleDateString("ko-KR", { year: "numeric", month: "2-digit", day: "2-digit" })}
                </span>
                <span class="block text-[12.5px] leading-snug text-[color:var(--fg-mute)]">
                  {post.data.title}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- STATS -->
      <section>
        <p class="bd-overline mb-2">Stats</p>
        <div class="grid grid-cols-2 gap-x-3 gap-y-4">
          <div>
            <p class="font-mono text-[22px] leading-none">{totalNotes}</p>
            <p class="text-[11px] mt-1 text-[color:var(--fg-faint)]">notes</p>
          </div>
          <div>
            <p class="font-mono text-[22px] leading-none">{totalLinks}</p>
            <p class="text-[11px] mt-1 text-[color:var(--fg-faint)]">links</p>
          </div>
          <div>
            <p class="font-mono text-[22px] leading-none">{uniqueTags}</p>
            <p class="text-[11px] mt-1 text-[color:var(--fg-faint)]">tags</p>
          </div>
          <div>
            <p class="font-mono text-[22px] leading-none text-[color:var(--accent)]">+{thisWeekCount}</p>
            <p class="text-[11px] mt-1 text-[color:var(--fg-faint)]">this week</p>
          </div>
        </div>
      </section>
    </>
  )}

  {variant === "category" && catMeta && (
    <>
      <!-- CATEGORY GRAPH -->
      <section>
        <p class="bd-overline mb-2">{catMeta.label} Graph</p>
        <div class="rounded border border-border overflow-hidden">
          <GraphCanvas height={200} categoryFilter={catParentKey} />
        </div>
        <p class="font-mono text-[11px] text-[color:var(--fg-faint)] mt-1">
          {catPostCount} notes
        </p>
      </section>

      <!-- THIS WEEK (filtered to category) -->
      <section>
        <p class="bd-overline mb-2">This Week</p>
        <ul class="flex flex-col gap-3">
          {thisWeekPosts.map(post => (
            <li>
              <a href={postUrl(post)} class="block hover:text-accent transition-colors">
                <span class="block font-mono text-[10.5px] mb-0.5 text-[color:var(--fg-veryfaint)]">
                  {new Date(post.data.pubDatetime).toLocaleDateString("ko-KR", { year: "numeric", month: "2-digit", day: "2-digit" })}
                </span>
                <span class="block text-[12.5px] leading-snug text-[color:var(--fg-mute)]">
                  {post.data.title}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- OTHER CATEGORIES -->
      <section>
        <p class="bd-overline mb-2">Other Categories</p>
        <nav class="flex flex-col gap-1">
          {(() => {
            const { parent: activeParent } = categoryKey ? parseCategory(categoryKey) : { parent: "" };
            return Object.entries(PARENTS)
              .filter(([parentKey]) => parentKey !== activeParent)
              .map(([parentKey, parentMeta]) => (
                <a
                  href={`/${parentKey}/${Object.keys(parentMeta.subs)[0]}`}
                  class="flex items-center gap-1.5 text-[13px] text-[color:var(--fg-mute)] hover:text-accent transition-colors"
                >
                  <span class="cat-dot shrink-0" style={`background:${parentMeta.color}`} />
                  {parentMeta.label}
                </a>
              ));
          })()}
        </nav>
      </section>
    </>
  )}

  {variant === "reading" && (
    <>
      <!-- ON THIS PAGE (TOC) -->
      {headings.length > 0 && (
        <section>
          <p class="bd-overline mb-2">On This Page</p>
          <ul id="bd-toc" class="relative flex flex-col border-l border-border">
            <!-- Sliding accent indicator -->
            <span
              id="toc-indicator"
              class="absolute pointer-events-none rounded-full bg-accent"
              style="left:-1px; width:2px; top:0; height:0; opacity:0; transition: top 200ms cubic-bezier(0.4,0,0.2,1), height 200ms cubic-bezier(0.4,0,0.2,1), opacity 150ms ease;"
            ></span>
            {headings.map(h => (
              <li>
                <a
                  href={`#${h.slug}`}
                  class:list={[
                    "bd-toc-item block text-[12.5px] text-[color:var(--fg-mute)] hover:text-accent transition-colors",
                    h.depth === 3 ? "pl-[24px] text-[12px]" : "pl-[14px]",
                  ]}
                  style="padding-top:4px;padding-bottom:4px;"
                  data-heading={h.slug}
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- LOCAL GRAPH -->
      <section>
        <p class="bd-overline mb-2">Local Graph</p>
        <div class="rounded border border-border overflow-hidden">
          {postId && <GraphCanvas focusId={postId} height={200} />}
        </div>
      </section>

      <!-- RELATED -->
      {relatedPosts.length > 0 && (
        <section>
          <p class="bd-overline mb-2">Related</p>
          <ul class="flex flex-col gap-1.5">
            {relatedPosts.map(post => (
              <li class="flex items-start gap-1.5">
                <span
                  class="cat-dot mt-1.5 shrink-0"
                  style={`background:${getCategoryMeta(post.data.category)?.color ?? "var(--fg-faint)"}`}
                />
                <a
                  href={postUrl(post)}
                  class="text-[13px] leading-snug hover:text-accent transition-colors"
                  style="border-bottom: 1px dashed var(--accent); opacity: 0.7;"
                >
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- BACKLINKS -->
      {backlinks.length > 0 && (
        <section>
          <p class="bd-overline mb-2">Backlinks</p>
          <ul class="flex flex-col gap-1.5">
            {backlinks.map(post => (
              <li>
                <a
                  href={postUrl(post)}
                  class="text-[13px] text-[color:var(--fg-mute)] hover:text-accent transition-colors"
                >
                  ← {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </>
  )}
</div>
</aside>

<script>
  function initToc() {
    const toc = document.getElementById("bd-toc");
    const indicator = document.getElementById("toc-indicator");
    if (!toc || !indicator) return;

    const items = Array.from(toc.querySelectorAll<HTMLAnchorElement>("a[data-heading]"));
    if (!items.length) return;

    function moveIndicator(link: HTMLAnchorElement, instant = false) {
      const tocRect = toc!.getBoundingClientRect();
      const linkRect = link.getBoundingClientRect();
      const top = linkRect.top - tocRect.top;
      const height = linkRect.height;

      if (instant) {
        indicator!.style.transition = "none";
        indicator!.style.top = `${top}px`;
        indicator!.style.height = `${height}px`;
        indicator!.style.opacity = "1";
        indicator!.getBoundingClientRect();
        indicator!.style.transition = "";
      } else {
        indicator!.style.top = `${top}px`;
        indicator!.style.height = `${height}px`;
        indicator!.style.opacity = "1";
      }

      items.forEach(a => {
        const isActive = a === link;
        a.style.color = isActive ? "var(--accent)" : "";
      });
    }

    // Scrollspy via IntersectionObserver
    const headingEls = items.map(a => document.getElementById(a.dataset.heading!)).filter(Boolean) as HTMLElement[];
    let activeHeading: HTMLElement | null = null;

    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          activeHeading = entry.target as HTMLElement;
        }
      }
      if (activeHeading) {
        const link = items.find(a => a.dataset.heading === activeHeading!.id);
        if (link) moveIndicator(link);
      }
    }, { rootMargin: "0px 0px -60% 0px", threshold: 0 });

    headingEls.forEach(el => observer.observe(el));

    // Set initial indicator to first active (or first) heading
    const firstLink = items[0];
    if (firstLink) moveIndicator(firstLink, true);

    // Smooth scroll + heading pulse on click
    function smoothScrollTo(targetY: number, duration: number) {
      const startY = window.scrollY;
      const diff = targetY - startY;
      if (diff === 0) return;
      let startTime: number | null = null;
      const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
      function step(timestamp: number) {
        if (!startTime) startTime = timestamp;
        const elapsed = timestamp - startTime;
        const progress = Math.min(elapsed / duration, 1);
        window.scrollTo(0, startY + diff * easeOut(progress));
        if (progress < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    function pulseHeading(el: HTMLElement) {
      el.classList.add("toc-heading-pulse");
      el.addEventListener("animationend", () => el.classList.remove("toc-heading-pulse"), { once: true });
    }

    items.forEach(link => {
      link.addEventListener("click", e => {
        e.preventDefault();
        const slug = link.dataset.heading;
        const target = slug ? document.getElementById(slug) : null;
        if (!target) return;
        const targetY = target.getBoundingClientRect().top + window.scrollY - 72;
        smoothScrollTo(targetY, 300);
        setTimeout(() => pulseHeading(target), 280);
      });
    });

    return () => observer.disconnect();
  }

  let cleanup: (() => void) | undefined;

  function setup() {
    cleanup?.();
    cleanup = initToc() ?? undefined;
  }

  setup();
  document.addEventListener("astro:after-swap", setup);
</script>
