---
interface Props {
  name: string;
  subtitle?: string;
  description?: string;
  href: string;
  chapterCount: number;
  color: string;
  latestDate: Date;
}

const { name, subtitle, description, href, chapterCount, color } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col rounded-lg border border-border hover:border-accent transition-colors overflow-hidden outline-none focus-visible:outline-2 focus-visible:outline-dashed focus-visible:outline-accent focus-visible:outline-offset-2"
  style="max-width: 200px; width: 100%;"
>
  <!-- 책 표지 -->
  <div
    class="flex flex-col justify-between px-5 py-5"
    style={`min-height: 180px; background: linear-gradient(160deg, color-mix(in srgb, ${color} 24%, transparent), color-mix(in srgb, ${color} 8%, transparent));`}
  >
    <span
      class="text-[9px] font-mono tracking-widest uppercase self-start px-1.5 py-0.5 rounded"
      style={`color: ${color}; background: color-mix(in srgb, ${color} 18%, transparent);`}
    >
      Series
    </span>

    <div>
      <p class="font-bold text-[17px] leading-snug tracking-tight group-hover:text-accent transition-colors mb-0.5">
        {name}
      </p>
      {subtitle && (
        <p class="text-[12px] leading-snug" style="color: var(--fg-mute);">
          {subtitle}
        </p>
      )}
    </div>
  </div>

  <!-- 내지 -->
  <div class="flex flex-col px-5 py-4 gap-2 border-t border-border">
    {description && (
      <p class="text-[12px] leading-relaxed line-clamp-2" style="color: var(--fg-mute);">
        {description}
      </p>
    )}
    <div class="flex items-center justify-between mt-1">
      <span class="text-[11px] font-mono" style="color: var(--fg-faint);">{chapterCount}편 수록</span>
      <span class="text-[11px]" style="color: var(--fg-faint);">전편 읽기 →</span>
    </div>
  </div>
</a>
