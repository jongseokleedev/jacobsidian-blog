---
interface Props {
  name: string;
  subtitle?: string;
  description?: string;
  href: string;
  chapterCount: number;
  color: string;
  latestDate: Date;
  ongoing?: boolean;
}

const { name, subtitle, description, href, chapterCount, color, ongoing } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col rounded-lg border border-border hover:border-accent transition-colors overflow-hidden outline-none focus-visible:outline-2 focus-visible:outline-dashed focus-visible:outline-accent focus-visible:outline-offset-2"
  style="max-width: 176px; width: 100%;"
>
  <!-- 커버 -->
  <div
    class="flex flex-col gap-2 px-5 py-5 relative"
    style={`min-height: 160px; background: linear-gradient(160deg, color-mix(in srgb, ${color} 22%, transparent), color-mix(in srgb, ${color} 7%, transparent));`}
  >
    <div class="flex items-center justify-between">
      <span
        class="text-[9px] font-mono tracking-widest uppercase px-1.5 py-0.5 rounded"
        style={`color: ${color}; background: color-mix(in srgb, ${color} 18%, transparent);`}
      >
        Series
      </span>
      {ongoing && (
        <span
          class="inline-flex items-center gap-1 text-[9px] font-mono tracking-widest uppercase px-1.5 py-0.5 rounded"
          style={`color: ${color}; background: color-mix(in srgb, ${color} 14%, transparent); border: 1px solid color-mix(in srgb, ${color} 30%, transparent);`}
        >
          <span class="ongoing-dot" style={`background: ${color}; --dot-color: ${color};`}></span>
          연재중
        </span>
      )}
    </div>

    <div class="flex flex-col gap-0.5 mt-1">
      <p class="font-bold text-[16px] leading-snug tracking-tight group-hover:text-accent transition-colors">
        {name}
      </p>
      {subtitle && (
        <p class="text-[11.5px] leading-snug" style="color: var(--fg-mute);">
          {subtitle}
        </p>
      )}
    </div>
  </div>

  <!-- 내지 -->
  <div class="flex flex-col px-5 py-4 gap-2 border-t border-border">
    {description && (
      <p class="text-[11.5px] leading-relaxed line-clamp-3" style="color: var(--fg-mute);">
        {description}
      </p>
    )}
    <div class="flex items-center justify-between mt-1">
      <span class="text-[10.5px] font-mono" style="color: var(--fg-faint);">{chapterCount}편</span>
      <span class="text-[10.5px]" style="color: var(--fg-faint);">읽기 →</span>
    </div>
  </div>
</a>

<style>
  .ongoing-dot {
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    flex-shrink: 0;
    animation: ongoing-pulse 2.4s ease-in-out infinite;
  }

  @keyframes ongoing-pulse {
    0%, 100% {
      opacity: 1;
      box-shadow: 0 0 0 0 var(--dot-color);
    }
    50% {
      opacity: 0.75;
      box-shadow: 0 0 6px 2px color-mix(in srgb, var(--dot-color) 60%, transparent);
    }
  }
</style>
