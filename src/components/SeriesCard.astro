---
interface Props {
  name: string;
  subtitle?: string;
  description?: string;
  href: string;
  chapterCount: number;
  color: string;
  latestDate: Date;
}

const { name, subtitle, description, href, chapterCount, color } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col rounded-lg border border-border hover:border-accent transition-colors overflow-hidden outline-none focus-visible:outline-2 focus-visible:outline-dashed focus-visible:outline-accent focus-visible:outline-offset-2"
  style="max-width: 280px; width: 100%;"
>
  <!-- 커버 영역 -->
  <div
    class="flex items-end px-5 pt-6 pb-4"
    style={`height: 100px; background: linear-gradient(160deg, color-mix(in srgb, ${color} 22%, transparent), color-mix(in srgb, ${color} 8%, transparent));`}
  >
    <span
      class="text-[10px] font-mono tracking-widest uppercase px-1.5 py-0.5 rounded"
      style={`color: ${color}; background: color-mix(in srgb, ${color} 15%, transparent);`}
    >
      Series · {chapterCount}편
    </span>
  </div>

  <!-- 텍스트 영역 -->
  <div class="flex flex-col flex-1 px-5 pt-4 pb-5 gap-1">
    <p class="font-bold text-[16px] leading-snug tracking-tight group-hover:text-accent transition-colors">
      {name}
    </p>
    {subtitle && (
      <p class="text-[12.5px] leading-snug" style="color: var(--fg-mute);">
        {subtitle}
      </p>
    )}
    {description && (
      <p class="text-[12px] leading-relaxed line-clamp-3 mt-2" style="color: var(--fg-faint);">
        {description}
      </p>
    )}
    <p class="text-[11px] mt-auto pt-3" style="color: var(--fg-faint);">
      전편 읽기 →
    </p>
  </div>
</a>
