---
import { PARENTS, parseCategory } from "@/utils/getCategories";

interface Props {
  activeCategory?: string;   // e.g. "essay-thought"
  activeTopic?: string;
  activePage?: string;       // "home" | "about"
}

const { activeCategory, activeTopic, activePage } = Astro.props;
---

<aside
  id="left-rail"
  class="hidden lg:block border-r border-border shrink-0"
  style="width:var(--left-rail-w, 232px); position:sticky; top:56px; height:calc(100vh - 56px); overflow:hidden; transition:width 280ms cubic-bezier(0.4,0,0.2,1); align-self:flex-start;"
>
<div style="width:232px; height:100%; overflow-y:auto; padding:28px 24px 28px 28px;" class="flex flex-col">
  <!-- Home -->
  <a
    href="/"
    class:list={[
      "flex items-center gap-2 text-sm font-medium py-1.5 rounded transition-colors hover:text-accent",
      activePage === "home" ? "text-accent font-semibold" : "text-[color:var(--fg-mute)]",
    ]}
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
      <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
    </svg>
    Home
  </a>

  <!-- About -->
  <a
    href="/about"
    class:list={[
      "flex items-center gap-2 text-sm font-medium py-1.5 rounded transition-colors hover:text-accent",
      activePage === "about" ? "text-accent font-semibold" : "text-[color:var(--fg-mute)]",
    ]}
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
      <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
    </svg>
    About
  </a>

  <hr class="my-2.5 border-border" />

  <!-- Category tree -->
  {Object.entries(PARENTS).map(([parentKey, parentMeta]) => {
    const { parent: activeParent } = activeCategory ? parseCategory(activeCategory) : { parent: "" };
    const isParentActive = activeParent === parentKey;
    return (
      <div class="sidebar-category" data-parent={parentKey}>
        <!-- Parent link + toggle button -->
        <div class="flex items-center">
          <a
            href={`/${parentKey}`}
            class:list={[
              "flex items-center gap-2 py-1.5 text-sm rounded transition-colors flex-1 hover:text-accent",
              isParentActive ? "text-accent font-semibold" : "text-foreground",
            ]}
          >
            <span class="cat-dot shrink-0" style={`background:${parentMeta.color}`} />
            {parentMeta.label}
          </a>
          <button
            class="sidebar-toggle flex items-center justify-center rounded hover:text-accent transition-colors shrink-0"
            style="width: 32px; height: 32px; color: var(--fg-faint);"
            data-target={parentKey}
            aria-expanded={isParentActive ? "true" : "false"}
            aria-label={`${parentMeta.label} 서브카테고리 열기`}
          >
            <svg
              class:list={["size-3 transition-transform duration-200", isParentActive ? "rotate-90" : ""]}
              xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            >
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </button>
        </div>

        <!-- Sub-categories (collapsible) -->
        <div
          id={`sub-wrap-${parentKey}`}
          class="overflow-hidden"
          style={`max-height: ${isParentActive ? "200px" : "0"}; transition: max-height 220ms cubic-bezier(0.4, 0, 0.2, 1);`}
        >
          <ul
            id={`sub-${parentKey}`}
            class="mt-0.5 ml-[26px] relative flex flex-col border-l border-border"
          >
            <!-- Sliding accent indicator -->
            <span
              id={`sub-indicator-${parentKey}`}
              class="absolute pointer-events-none rounded-full bg-accent"
              style="left: -1px; width: 2px; top: 0; height: 0; opacity: 0;"
            ></span>

            {Object.entries(parentMeta.subs).map(([subKey, subMeta]) => {
              const catKey = `${parentKey}-${subKey}`;
              const isSubActive = activeCategory === catKey;
              return (
                <li>
                  <a
                    href={`/${parentKey}/${subKey}`}
                    class:list={[
                      "block text-[12.5px] py-1 pl-4 rounded-r transition-colors hover:text-accent",
                      isSubActive
                        ? "text-accent font-medium bg-accent/10"
                        : "text-[color:var(--fg-mute)]",
                    ]}
                  >
                    {subMeta.label}
                    {subMeta.desc && (
                      <span class="block text-[11px] leading-tight mt-0.5" style="color: var(--fg-faint);">{subMeta.desc}</span>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    );
  })}

  <!-- PINNED (hydrated from localStorage) -->
  <div id="pinned-section" class="hidden mt-2">
    <hr class="my-2.5 border-border" />
    <p class="bd-overline mb-2">Pinned</p>
    <ul id="pinned-list" class="flex flex-col gap-2"></ul>
  </div>
</div>
</aside>

<script>
  let controller = new AbortController();
  let savedIndicators: Record<string, { top: number; height: number }> = {};

  function positionIndicator(parentKey: string, from?: { top: number; height: number }) {
    const ul = document.getElementById(`sub-${parentKey}`);
    const indicator = document.getElementById(`sub-indicator-${parentKey}`);
    if (!ul || !indicator) return;

    const activeLink = ul.querySelector<HTMLAnchorElement>("a.text-accent");
    if (!activeLink) {
      indicator.style.opacity = "0";
      indicator.style.height = "0px";
      return;
    }

    const ulRect = ul.getBoundingClientRect();
    const linkRect = activeLink.getBoundingClientRect();
    const toTop = linkRect.top - ulRect.top;
    const toHeight = linkRect.height;

    indicator.style.top = `${toTop}px`;
    indicator.style.height = `${toHeight}px`;
    indicator.style.opacity = "1";

    const fromTop = from && from.height > 0 ? from.top : toTop;
    const fromHeight = from && from.height > 0 ? from.height : 0;
    const fromOpacity = from && from.height > 0 ? 1 : 0;

    indicator.animate(
      [
        { top: `${fromTop}px`, height: `${fromHeight}px`, opacity: fromOpacity },
        { top: `${toTop}px`, height: `${toHeight}px`, opacity: 1 },
      ],
      { duration: 200, easing: "cubic-bezier(0.4, 0, 0.2, 1)" }
    );
  }

  function openCategory(key: string) {
    const btn = document.querySelector<HTMLButtonElement>(`.sidebar-toggle[data-target="${key}"]`);
    const wrap = document.getElementById(`sub-wrap-${key}`);
    const ul = document.getElementById(`sub-${key}`);
    if (!btn || !wrap) return;
    btn.setAttribute("aria-expanded", "true");
    btn.setAttribute("aria-label", btn.getAttribute("aria-label")?.replace("열기", "닫기") ?? "");
    btn.querySelector("svg")?.classList.add("rotate-90");
    wrap.style.maxHeight = ul ? `${ul.scrollHeight + 8}px` : "200px";
  }

  function closeCategory(key: string) {
    const btn = document.querySelector<HTMLButtonElement>(`.sidebar-toggle[data-target="${key}"]`);
    const wrap = document.getElementById(`sub-wrap-${key}`);
    if (!btn || !wrap) return;
    btn.setAttribute("aria-expanded", "false");
    btn.setAttribute("aria-label", btn.getAttribute("aria-label")?.replace("닫기", "열기") ?? "");
    btn.querySelector("svg")?.classList.remove("rotate-90");
    wrap.style.maxHeight = "0";
  }

  function initSidebar() {
    const sig = { signal: controller.signal };

    // Chevron toggle buttons
    document.querySelectorAll<HTMLButtonElement>(".sidebar-toggle").forEach(btn => {
      btn.addEventListener("click", () => {
        const key = btn.dataset.target!;
        const isOpen = btn.getAttribute("aria-expanded") === "true";
        if (isOpen) {
          closeCategory(key);
        } else {
          openCategory(key);
        }
      }, sig);
    });

    // Restore indicator positions
    document.querySelectorAll<HTMLButtonElement>(".sidebar-toggle").forEach(btn => {
      const key = btn.dataset.target!;
      if (btn.getAttribute("aria-expanded") !== "true") return;
      positionIndicator(key, savedIndicators[key]?.height > 0 ? savedIndicators[key] : undefined);
    });

    savedIndicators = {};
  }

  initSidebar();

  document.addEventListener("astro:before-swap", () => {
    document.querySelectorAll<HTMLElement>("[id^='sub-indicator-']").forEach(el => {
      const key = el.id.replace("sub-indicator-", "");
      savedIndicators[key] = {
        top: parseFloat(el.style.top) || 0,
        height: parseFloat(el.style.height) || 0,
      };
    });
    controller.abort();
    controller = new AbortController();
  });

  document.addEventListener("astro:after-swap", initSidebar);
</script>
