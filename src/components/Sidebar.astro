---
import { PARENTS, parseCategory } from "@/utils/getCategories";

interface Props {
  activeCategory?: string;   // e.g. "essay-thought"
  activeTopic?: string;
  activePage?: string;       // "home" | "about"
}

const { activeCategory, activeTopic, activePage } = Astro.props;
---

<aside
  id="left-rail"
  class="hidden lg:flex flex-col border-r border-border shrink-0"
  style="width:232px; padding: 28px 24px 28px 28px; overflow-y:auto;"
>
  <!-- Home -->
  <a
    href="/"
    class:list={[
      "flex items-center gap-2 text-sm font-medium py-1.5 rounded transition-colors hover:text-accent",
      activePage === "home" ? "text-accent font-semibold" : "text-[color:var(--fg-mute)]",
    ]}
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
      <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
    </svg>
    Home
  </a>

  <!-- About -->
  <a
    href="/about"
    class:list={[
      "flex items-center gap-2 text-sm font-medium py-1.5 rounded transition-colors hover:text-accent",
      activePage === "about" ? "text-accent font-semibold" : "text-[color:var(--fg-mute)]",
    ]}
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
      <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
    </svg>
    About
  </a>

  <hr class="my-2.5 border-border" />

  <!-- Category tree -->
  {Object.entries(PARENTS).map(([parentKey, parentMeta]) => {
    const { parent: activeParent } = activeCategory ? parseCategory(activeCategory) : { parent: "" };
    const isParentActive = activeParent === parentKey;
    return (
      <div class="sidebar-category" data-parent={parentKey}>
        <!-- Toggle button + parent link -->
        <div class="flex items-center gap-1">
          <button
            class="sidebar-toggle p-1 rounded hover:text-accent transition-colors shrink-0"
            data-target={parentKey}
            aria-expanded={isParentActive ? "true" : "false"}
            style="color: var(--fg-faint);"
          >
            <svg
              class:list={["size-[9px] transition-transform duration-200", isParentActive ? "rotate-90" : ""]}
              xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            >
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </button>
          <a
            href={`/${parentKey}`}
            class:list={[
              "flex items-center gap-2 py-1.5 text-sm rounded transition-colors flex-1 hover:text-accent",
              isParentActive ? "text-accent font-semibold" : "text-foreground",
            ]}
          >
            <span class="cat-dot shrink-0" style={`background:${parentMeta.color}`} />
            {parentMeta.label}
          </a>
        </div>

        <!-- Sub-categories (collapsible) -->
        <ul
          id={`sub-${parentKey}`}
          class:list={[
            "mt-0.5 ml-[26px] flex flex-col gap-0.5 overflow-hidden transition-all duration-200",
            isParentActive ? "" : "hidden",
          ]}
        >
          {Object.entries(parentMeta.subs).map(([subKey, subMeta]) => {
            const catKey = `${parentKey}-${subKey}`;
            const isSubActive = activeCategory === catKey;
            return (
              <li class:list={[
                "border-l pl-2 transition-colors",
                isSubActive ? "border-accent" : "border-border",
              ]}>
                <a
                  href={`/${parentKey}/${subKey}`}
                  class:list={[
                    "block text-[12.5px] py-1 pl-2 rounded transition-colors hover:text-accent",
                    isSubActive
                      ? "text-accent font-medium bg-accent/10"
                      : "text-[color:var(--fg-mute)]",
                  ]}
                >
                  {subMeta.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    );
  })}

  <!-- PINNED (hydrated from localStorage) -->
  <div id="pinned-section" class="hidden mt-2">
    <hr class="my-2.5 border-border" />
    <p class="bd-overline mb-2">Pinned</p>
    <ul id="pinned-list" class="flex flex-col gap-2"></ul>
  </div>
</aside>

<script>
  function initSidebar() {
    const toggles = document.querySelectorAll<HTMLButtonElement>(".sidebar-toggle");
    toggles.forEach(btn => {
      btn.addEventListener("click", () => {
        const key = btn.dataset.target!;
        const ul = document.getElementById(`sub-${key}`);
        const svg = btn.querySelector("svg");
        const expanded = btn.getAttribute("aria-expanded") === "true";

        btn.setAttribute("aria-expanded", expanded ? "false" : "true");
        ul?.classList.toggle("hidden", expanded);
        svg?.classList.toggle("rotate-90", !expanded);
      });
    });
  }

  initSidebar();
  document.addEventListener("astro:after-swap", initSidebar);
</script>
