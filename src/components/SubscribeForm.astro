---
// No server-side props needed
---

<section class="subscribe-section">
  <p class="subscribe-heading">새 글 알림 받기</p>
  <form id="subscribe-form" class="subscribe-form" novalidate>
    <input
      id="subscribe-email"
      type="email"
      name="email"
      placeholder="이메일 주소"
      autocomplete="email"
      required
      class="subscribe-input"
    />
    <button type="submit" class="subscribe-btn">구독</button>
  </form>
  <p id="subscribe-msg" class="subscribe-msg" aria-live="polite"></p>
</section>

<style>
  .subscribe-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 0 0.5rem;
  }

  .subscribe-heading {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--foreground);
    margin: 0;
  }

  .subscribe-form {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .subscribe-input {
    flex: 1;
    min-width: 12rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--background);
    color: var(--foreground);
    font-size: 0.875rem;
    outline: none;
    transition: border-color 0.15s;
  }

  .subscribe-input::placeholder {
    color: var(--fg-mute);
  }

  .subscribe-input:focus {
    border-color: var(--foreground);
  }

  .subscribe-btn {
    padding: 0.4rem 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--foreground);
    color: var(--background);
    font-size: 0.875rem;
    cursor: pointer;
    transition: opacity 0.15s;
    white-space: nowrap;
  }

  .subscribe-btn:hover {
    opacity: 0.8;
  }

  .subscribe-msg {
    font-size: 0.8rem;
    color: var(--fg-mute);
    margin: 0;
    min-height: 1.2em;
  }
</style>

<script>
  const form = document.getElementById("subscribe-form") as HTMLFormElement | null;
  const emailInput = document.getElementById("subscribe-email") as HTMLInputElement | null;
  const msg = document.getElementById("subscribe-msg") as HTMLParagraphElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = emailInput?.value.trim() ?? "";
    if (!email) return;

    const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = "처리 중...";

    try {
      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });

      if (res.ok) {
        if (msg) msg.textContent = "구독해주셔서 감사합니다!";
        form.reset();
      } else {
        if (msg) msg.textContent = "오류가 발생했습니다. 다시 시도해주세요.";
      }
    } catch {
      if (msg) msg.textContent = "오류가 발생했습니다. 다시 시도해주세요.";
    } finally {
      btn.disabled = false;
      btn.textContent = "구독";
    }
  });
</script>
