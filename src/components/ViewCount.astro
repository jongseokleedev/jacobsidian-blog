---
interface Props { postId: string; }
const { postId } = Astro.props;
---
<span class="view-count-mount" data-post-id={postId}></span>

<script>
  import { getSupabase } from "@/components/comments/lib";
  import { bucketViewCount } from "@/utils/viewCount";

  async function loadViewCounts() {
    const mounts = document.querySelectorAll<HTMLElement>(".view-count-mount");
    if (!mounts.length) return;

    const postIds = [...new Set([...mounts].map(el => el.dataset.postId!))];
    const sb = getSupabase();

    for (const postId of postIds) {
      const { count } = await sb
        .from("page_views")
        .select("id", { count: "exact", head: true })
        .eq("post_id", postId);

      const label = bucketViewCount(count ?? 0);
      if (!label) continue;

      document.querySelectorAll<HTMLElement>(`.view-count-mount[data-post-id="${postId}"]`).forEach(el => {
        el.textContent = label;
        el.className = "text-xs";
        el.style.color = "var(--fg-mute)";
      });
    }
  }

  document.addEventListener("astro:page-load", loadViewCounts);
</script>
