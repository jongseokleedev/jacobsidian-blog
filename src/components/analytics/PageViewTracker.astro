---
interface Props {
  postId: string;
}
const { postId } = Astro.props;
---

<span id="pvt-post-id" data-post-id={postId} style="display:none" aria-hidden="true"></span>

<script>
  (async () => {
    if (/bot|crawl|spider|headless/i.test(navigator.userAgent)) return;

    const el = document.getElementById("pvt-post-id");
    if (!el) return;
    const postId = el.dataset.postId;
    if (!postId) return;

    const { getSupabase } = await import("@/components/comments/lib");
    const db = getSupabase();

    const ref = document.referrer;
    let referrer = "other";
    if (!ref) referrer = "direct";
    else if (/google|bing|naver|daum|yahoo/i.test(ref)) referrer = "search";
    else if (/twitter|x\.com|linkedin|facebook|instagram/i.test(ref)) referrer = "sns";

    let visitorId = localStorage.getItem("visitor_id");
    if (!visitorId) {
      visitorId = crypto.randomUUID();
      localStorage.setItem("visitor_id", visitorId);
    }

    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const table = (db as any).from("page_views");

    try {
      await table.insert({ post_id: postId, referrer, scroll_depth: 0, visitor_id: visitorId });
    } catch { /* fire and forget */ }

    const milestones = new Set<number>();
    function onScroll() {
      const pct = Math.round(
        ((window.scrollY + window.innerHeight) / document.documentElement.scrollHeight) * 100
      );
      for (const m of [25, 50, 75, 100]) {
        if (pct >= m && !milestones.has(m)) {
          milestones.add(m);
          table.insert({ post_id: postId, referrer, scroll_depth: m, visitor_id: visitorId }).then(() => {});
        }
      }
      if (milestones.size === 4) {
        window.removeEventListener("scroll", onScroll);
      }
    }
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>
