---
interface Props {
  postId: string;
}
const { postId } = Astro.props;
---

<form
  id="comment-form-root"
  class="comment-form mt-4 flex flex-col gap-3"
  data-post-id={postId}
>
  <!-- Honeypot: 봇만 채움, 사람에게 보이지 않음 -->
  <input
    type="text"
    name="honeypot"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;"
  />

  <div class="comment-field-group rounded border overflow-hidden transition-colors" style="border-color: var(--border);">
    <!-- 닉네임 행 -->
    <div class="flex items-center" style="border-bottom: 1px solid var(--border);">
      <input
        type="text"
        name="nickname"
        placeholder="닉네임"
        maxlength="30"
        class="comment-nickname-input min-w-0 flex-1 px-3 py-2 text-sm bg-background text-foreground outline-none"
      />
      <button
        type="button"
        class="comment-nick-random shrink-0 px-3 py-2 text-base transition-colors hover:text-accent"
        style="color: var(--fg-mute); border-left: 1px solid var(--border); background: var(--muted);"
        title="닉네임 바꾸기"
      >🎲</button>
    </div>
    <!-- 댓글 입력 행 -->
    <textarea
      name="body"
      placeholder="댓글을 입력하세요"
      maxlength="1000"
      rows="3"
      class="w-full px-3 py-2 text-sm resize-none bg-background text-foreground outline-none block"
    ></textarea>
  </div>

  <div class="flex items-center gap-2">
    <button
      type="submit"
      class="comment-submit-btn text-sm px-4 py-1.5 rounded font-medium transition-opacity"
      style="background: var(--accent); color: #fff;"
    >등록</button>
    <span class="comment-error text-xs hidden" style="color: #e53e3e;"></span>
  </div>
</form>

<style>
  .comment-field-group:focus-within {
    border-color: var(--accent);
  }
</style>
