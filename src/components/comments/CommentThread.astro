---
import type { Comment } from "./lib";

interface Props {
  comments: Comment[];
  postId: string;
  isReply?: boolean;
}

const { comments, postId, isReply = false } = Astro.props;

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString("ko-KR", {
    year: "numeric", month: "long", day: "numeric",
    hour: "2-digit", minute: "2-digit",
  });
}

const topLevel = isReply ? comments : comments.filter(c => !c.parent_id);
const getReplies = (parentId: string) => comments.filter(c => c.parent_id === parentId);
---

<ul
  class:list={["space-y-4", isReply && "ml-6 mt-3 border-l pl-4"]}
  style={isReply ? "border-color: var(--border);" : ""}
>
  {topLevel.map(comment => (
    <li class="comment-item" data-id={comment.id}>
      <div class="flex items-start justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="text-sm font-medium" style="color: var(--foreground);">{comment.nickname}</span>
          <span class="text-xs" style="color: var(--fg-mute);">{formatDate(comment.created_at)}</span>
        </div>
        {!isReply && (
          <button
            class="reply-btn text-xs transition-colors"
            style="color: var(--fg-mute);"
            data-comment-id={comment.id}
            data-nickname={comment.nickname}
          >답글</button>
        )}
      </div>
      <p class="mt-1 text-sm leading-relaxed whitespace-pre-wrap" style="color: var(--foreground);">{comment.body}</p>

      {getReplies(comment.id).length > 0 && (
        <Astro.self comments={getReplies(comment.id)} postId={postId} isReply={true} />
      )}

      <div class="reply-form-mount" data-parent-id={comment.id} data-nickname={comment.nickname}></div>
    </li>
  ))}
</ul>
