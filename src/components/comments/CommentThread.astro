---
import type { Comment } from "./lib";

interface Props {
  comments: Comment[];
  postId: string;
  isReply?: boolean;
}

const { comments, postId, isReply = false } = Astro.props;

function formatDate(iso: string) {
  const d = new Date(iso);
  const yyyy = d.getFullYear();
  const mm = String(d.getMonth() + 1).padStart(2, "0");
  const dd = String(d.getDate()).padStart(2, "0");
  const hh = String(d.getHours()).padStart(2, "0");
  const min = String(d.getMinutes()).padStart(2, "0");
  return `${yyyy}. ${mm}. ${dd}. ${hh}:${min}`;
}

const topLevel = isReply ? comments : comments.filter(c => !c.parent_id);
const getReplies = (parentId: string) => comments.filter(c => c.parent_id === parentId);
---

<ul class:list={["space-y-4", isReply && "mt-3 space-y-3"]}>
  {topLevel.map(comment => (
    <li
      class:list={["comment-item", isReply ? "reply-item pl-3 py-2 rounded-lg" : "px-4 py-3.5 rounded-xl"]}
      data-id={comment.id}
      style={
        isReply
          ? "border-left: 2px solid var(--border); background: var(--muted);"
          : "background: color-mix(in srgb, var(--muted) 45%, transparent); border: 1px solid var(--border);"
      }
    >
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2 flex-wrap">
          {isReply && <span class="text-xs" style="color: var(--fg-mute);">↳</span>}
          <span class="text-sm font-medium" style="color: var(--foreground);">{comment.nickname}</span>
          <span
            class="my-comment-badge hidden text-xs px-1.5 py-0.5 rounded-full font-medium"
            data-nickname={comment.nickname}
            style="background: var(--accent-soft); color: var(--accent);"
          >나</span>
          <span class="text-xs" style="color: var(--fg-mute);">{formatDate(comment.created_at)}</span>
        </div>
        {!isReply && (
          <button
            class="reply-btn text-xs transition-colors hover:text-accent shrink-0"
            style="color: var(--fg-mute);"
            data-comment-id={comment.id}
            data-nickname={comment.nickname}
          >답글</button>
        )}
      </div>
      <p class="mt-1.5 text-sm leading-relaxed whitespace-pre-wrap" style="color: var(--foreground);">{comment.body}</p>

      <div class="reaction-bar flex flex-wrap items-center gap-1.5 mt-3"
        data-target-type="comment"
        data-target-id={comment.id}
      >
        <button
          type="button"
          class="reaction-add-btn flex items-center gap-0.5 px-3 py-1.5 rounded-full transition-colors hover:border-[var(--accent)] hover:bg-[var(--accent)]/10 cursor-pointer"
          style="border: 1px solid var(--border);"
          aria-label="이모지 반응 추가"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--fg-mute); flex-shrink:0;">
            <path d="M22 11v1a10 10 0 1 1-9-10"/>
            <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
            <line x1="9" x2="9.01" y1="9" y2="9"/>
            <line x1="15" x2="15.01" y1="9" y2="9"/>
            <path d="M16 5h6"/>
            <path d="M19 2v6"/>
          </svg>
        </button>
      </div>

      {getReplies(comment.id).length > 0 && (
        <div class="ml-6 mt-3 pl-4" style="border-left: 2px solid var(--border);">
          <Astro.self comments={getReplies(comment.id)} postId={postId} isReply={true} />
        </div>
      )}

      <div class="reply-form-mount" data-parent-id={comment.id} data-nickname={comment.nickname}></div>
    </li>
  ))}
</ul>
