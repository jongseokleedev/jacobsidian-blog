---
import CommentThread from "./CommentThread.astro";
import CommentForm from "./CommentForm.astro";
import type { Comment } from "./lib";

interface Props {
  postId: string;
}
const { postId } = Astro.props;

let initialComments: Comment[] = [];
try {
  const url = `${import.meta.env.PUBLIC_SUPABASE_URL}/rest/v1/comments?post_id=eq.${encodeURIComponent(postId)}&honeypot=is.null&order=created_at.asc&limit=10&select=*`;
  const res = await fetch(url, {
    headers: {
      apikey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
      Authorization: `Bearer ${import.meta.env.PUBLIC_SUPABASE_ANON_KEY}`,
    },
  });
  if (res.ok) initialComments = await res.json();
} catch {
  // 빌드타임 fetch 실패 시 빈 배열로 시작
}
---

<section
  id="comments-section"
  class="mt-12 pt-8"
  style="border-top: 1px solid var(--border);"
  data-post-id={postId}
  data-admin-pw={import.meta.env.PUBLIC_ADMIN_PASSWORD ?? ""}
>
  <h2 class="flex items-center gap-3 text-base font-semibold mb-6" style="color: var(--foreground);">
    댓글 <span id="comments-count" class="text-sm font-normal" style="color: var(--fg-mute);">({initialComments.length})</span>
    <select
      id="sort-select"
      class="text-xs ml-auto rounded px-2 py-0.5 outline-none cursor-pointer"
      style="background: var(--muted); color: var(--fg-mute); border: 1px solid var(--border);"
    >
      <option value="asc">등록순</option>
      <option value="desc">최신순</option>
    </select>
  </h2>

  <div id="comments-list">
    {initialComments.length > 0
      ? <CommentThread comments={initialComments} postId={postId} />
      : <p id="no-comments" class="text-sm mb-6" style="color: var(--fg-mute);">아직 댓글이 없습니다. 첫 번째 댓글을 남겨보세요.</p>
    }
  </div>

  <div id="load-more-wrap" class:list={["mt-2", initialComments.length < 10 && "hidden"]}>
    <button id="load-more-btn" class="text-sm transition-colors" style="color: var(--fg-mute);">
      댓글 더 보기
    </button>
  </div>

  <div class="mt-6">
    <CommentForm postId={postId} />
  </div>

  <div class="mt-6 flex justify-end">
    <button id="admin-toggle" class="text-xs" style="color: var(--fg-veryfaint);">관리</button>
  </div>
</section>

<script>
  import { getNickname, saveNickname, generateNickname, getSupabase, getLikedIds, toggleLike } from "./lib";
  import type { Comment } from "./lib";

  function formatDate(iso: string) {
    const d = new Date(iso);
    const yyyy = d.getFullYear();
    const mm = String(d.getMonth() + 1).padStart(2, "0");
    const dd = String(d.getDate()).padStart(2, "0");
    const hh = String(d.getHours()).padStart(2, "0");
    const min = String(d.getMinutes()).padStart(2, "0");
    return `${yyyy}. ${mm}. ${dd}. ${hh}:${min}`;
  }

  function buildCommentEl(comment: Comment, isReply: boolean): HTMLLIElement {
    const li = document.createElement("li");
    li.className = "comment-item space-y-1";
    li.dataset.id = comment.id;

    const header = document.createElement("div");
    header.className = "flex items-start justify-between gap-2";

    const meta = document.createElement("div");
    meta.className = "flex items-center gap-2";

    const nick = document.createElement("span");
    nick.className = "text-sm font-medium";
    nick.style.color = "var(--foreground)";
    nick.textContent = comment.nickname;

    const date = document.createElement("span");
    date.className = "text-xs";
    date.style.color = "var(--fg-mute)";
    date.textContent = formatDate(comment.created_at);

    const badge = document.createElement("span");
    badge.className = "my-comment-badge text-xs px-1.5 py-0.5 rounded-full font-medium";
    badge.style.cssText = "background:var(--accent-soft);color:var(--accent);display:none;";
    badge.textContent = "나";
    badge.dataset.nickname = comment.nickname;

    const deleteBtn = document.createElement("button");
    deleteBtn.className = "delete-btn text-xs ml-2 transition-colors";
    deleteBtn.style.cssText = "color:#e53e3e;display:none;";
    deleteBtn.dataset.commentId = comment.id;
    deleteBtn.textContent = "삭제";

    meta.appendChild(nick);
    meta.appendChild(badge);
    meta.appendChild(date);
    meta.appendChild(deleteBtn);
    header.appendChild(meta);

    if (!isReply) {
      const replyBtn = document.createElement("button");
      replyBtn.className = "reply-btn text-xs transition-colors";
      replyBtn.style.color = "var(--fg-mute)";
      replyBtn.dataset.commentId = comment.id;
      replyBtn.dataset.nickname = comment.nickname;
      replyBtn.textContent = "답글";
      header.appendChild(replyBtn);
    }

    const body = document.createElement("p");
    body.className = "mt-1 text-sm leading-relaxed whitespace-pre-wrap";
    body.style.color = "var(--foreground)";
    body.textContent = comment.body;

    const mount = document.createElement("div");
    mount.className = "reply-form-mount";
    mount.dataset.parentId = comment.id;
    mount.dataset.nickname = comment.nickname;

    const likeBtn = document.createElement("button");
    likeBtn.className = "like-btn mt-1 flex items-center gap-1 text-xs transition-colors";
    likeBtn.dataset.commentId = comment.id;
    likeBtn.setAttribute("aria-label", "좋아요");

    const svgNS = "http://www.w3.org/2000/svg";
    const svg = document.createElementNS(svgNS, "svg");
    svg.setAttribute("viewBox", "0 0 24 24");
    svg.setAttribute("fill", "none");
    svg.setAttribute("stroke", "currentColor");
    svg.setAttribute("stroke-width", "2");
    svg.setAttribute("stroke-linecap", "round");
    svg.setAttribute("stroke-linejoin", "round");
    svg.classList.add("size-3.5");
    const heartPath = document.createElementNS(svgNS, "path");
    heartPath.setAttribute("d", "M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z");
    svg.appendChild(heartPath);

    const likeLabel = document.createElement("span");
    likeLabel.className = "like-label";
    likeLabel.textContent = comment.like_count > 0 ? String(comment.like_count) : "좋아요";

    likeBtn.appendChild(svg);
    likeBtn.appendChild(likeLabel);

    li.appendChild(header);
    li.appendChild(body);
    li.appendChild(likeBtn);
    if (!isReply) li.appendChild(mount);

    return li;
  }

  function initComments() {
    const section = document.getElementById("comments-section");
    if (!section) return;
    const postId = section.dataset.postId!;
    const supabase = getSupabase();

    function updateCount(delta: number) {
      const el = document.getElementById("comments-count");
      if (!el) return;
      const n = parseInt(el.textContent?.replace(/\D/g, "") ?? "0") + delta;
      el.textContent = `(${n})`;
    }

    function getOrCreateTopList(): HTMLUListElement {
      let list = document.querySelector<HTMLUListElement>("#comments-list > ul");
      if (!list) {
        document.getElementById("no-comments")?.remove();
        list = document.createElement("ul");
        list.className = "space-y-4";
        document.getElementById("comments-list")!.appendChild(list);
      }
      return list;
    }

    function appendComment(comment: Comment, parentId?: string) {
      updateCount(1);
      let newEl: HTMLLIElement;
      if (parentId) {
        const parentLi = document.querySelector<HTMLLIElement>(`.comment-item[data-id="${parentId}"]`);
        if (!parentLi) return;
        let replyList = parentLi.querySelector<HTMLUListElement>("ul");
        if (!replyList) {
          replyList = document.createElement("ul");
          replyList.className = "ml-6 mt-3 border-l pl-4 space-y-4";
          replyList.style.borderColor = "var(--border)";
          parentLi.querySelector(".reply-form-mount")?.before(replyList);
        }
        newEl = buildCommentEl(comment, true);
        replyList.appendChild(newEl);
      } else {
        newEl = buildCommentEl(comment, false);
        getOrCreateTopList().appendChild(newEl);
        attachReplyListeners();
      }
      setTimeout(() => newEl.scrollIntoView({ behavior: "smooth", block: "nearest" }), 50);
      syncMyBadges();
      syncLikeButtons();
      attachLikeListeners();
      attachDeleteListeners();
      if (adminMode) setAdminMode(true);
    }

    function initNickname(form: HTMLFormElement) {
      const input = form.querySelector<HTMLInputElement>(".comment-nickname-input");
      const randomBtn = form.querySelector<HTMLButtonElement>(".comment-nick-random");
      if (!input) return;
      input.value = getNickname();
      input.addEventListener("change", () => {
        const v = input.value.trim();
        if (v) saveNickname(v);
      });
      randomBtn?.addEventListener("click", () => {
        const nick = generateNickname();
        input.value = nick;
        saveNickname(nick);
      });
    }

    function handleSubmit(form: HTMLFormElement, parentId?: string) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const honeypot = form.querySelector<HTMLInputElement>("[name=honeypot]")?.value;
        if (honeypot) return;

        const nicknameInput = form.querySelector<HTMLInputElement>("[name=nickname]");
        const bodyInput = form.querySelector<HTMLTextAreaElement>("[name=body]");
        const errorEl = form.querySelector<HTMLSpanElement>(".comment-error");
        const submitBtn = form.querySelector<HTMLButtonElement>(".comment-submit-btn");

        const nickname = nicknameInput?.value.trim() || getNickname();
        const body = bodyInput?.value.trim() ?? "";

        if (!body) {
          if (errorEl) { errorEl.textContent = "댓글 내용을 입력해주세요."; errorEl.classList.remove("hidden"); }
          return;
        }

        if (submitBtn) submitBtn.disabled = true;
        errorEl?.classList.add("hidden");

        const { data, error } = await supabase
          .from("comments")
          // eslint-disable-next-line @typescript-eslint/no-explicit-any
          .insert({ post_id: postId, parent_id: parentId ?? null, nickname, body, honeypot: null } as any)
          .select()
          .single();

        if (submitBtn) submitBtn.disabled = false;

        if (error || !data) {
          if (errorEl) { errorEl.textContent = "등록 실패. 잠시 후 다시 시도해주세요."; errorEl.classList.remove("hidden"); }
          return;
        }

        saveNickname(nickname);
        appendComment(data as Comment, parentId);
        if (bodyInput) bodyInput.value = "";
        if (parentId) form.closest<HTMLDivElement>(".reply-form-wrapper")?.remove();
      });
    }

    function buildReplyForm(commentId: string, nickname: string): HTMLDivElement {
      const wrapper = document.createElement("div");
      wrapper.className = "reply-form-wrapper mt-3";

      const info = document.createElement("p");
      info.className = "text-sm mb-2";
      info.style.color = "var(--fg-mute)";

      const atSpan = document.createElement("span");
      atSpan.style.color = "var(--accent)";
      atSpan.textContent = `@${nickname}`;
      info.appendChild(atSpan);
      info.appendChild(document.createTextNode(" 에게 답글"));

      const cancelBtn = document.createElement("button");
      cancelBtn.type = "button";
      cancelBtn.className = "text-xs px-3 py-1 rounded ml-2";
      cancelBtn.style.cssText = "color:var(--fg-mute);border:1px solid var(--border);";
      cancelBtn.textContent = "취소";
      cancelBtn.addEventListener("click", () => wrapper.remove());
      info.appendChild(cancelBtn);

      const form = document.createElement("form");
      form.className = "comment-form flex flex-col gap-3 mt-2";

      const hp = document.createElement("input");
      hp.type = "text";
      hp.name = "honeypot";
      hp.tabIndex = -1;
      hp.autocomplete = "off";
      hp.setAttribute("aria-hidden", "true");
      hp.style.cssText = "position:absolute;left:-9999px;width:1px;height:1px;opacity:0;";

      const fieldGroup = document.createElement("div");
      fieldGroup.className = "rounded border overflow-hidden";
      fieldGroup.style.borderColor = "var(--border)";

      const nickRow = document.createElement("div");
      nickRow.className = "flex items-center";
      nickRow.style.borderBottom = "1px solid var(--border)";

      const nickInput = document.createElement("input");
      nickInput.type = "text";
      nickInput.name = "nickname";
      nickInput.placeholder = "닉네임";
      nickInput.maxLength = 30;
      nickInput.className = "comment-nickname-input min-w-0 flex-1 px-3 py-2 text-sm bg-background text-foreground outline-none";

      const randBtn = document.createElement("button");
      randBtn.type = "button";
      randBtn.className = "comment-nick-random shrink-0 px-3 py-2 text-base transition-colors hover:text-accent";
      randBtn.style.cssText = "color:var(--fg-mute);border-left:1px solid var(--border);background:var(--muted);";
      randBtn.title = "닉네임 바꾸기";
      randBtn.textContent = "🎲";

      nickRow.appendChild(nickInput);
      nickRow.appendChild(randBtn);

      const textarea = document.createElement("textarea");
      textarea.name = "body";
      textarea.placeholder = "답글을 입력하세요";
      textarea.maxLength = 1000;
      textarea.rows = 2;
      textarea.className = "w-full px-3 py-2 text-sm resize-none bg-background text-foreground outline-none block";

      fieldGroup.appendChild(nickRow);
      fieldGroup.appendChild(textarea);

      const submitRow = document.createElement("div");
      submitRow.className = "flex items-center gap-2";

      const submitBtn = document.createElement("button");
      submitBtn.type = "submit";
      submitBtn.className = "comment-submit-btn text-sm px-4 py-1.5 rounded font-medium";
      submitBtn.style.cssText = "background:var(--accent);color:#fff;";
      submitBtn.textContent = "등록";

      const errorEl = document.createElement("span");
      errorEl.className = "comment-error text-xs hidden";
      errorEl.style.color = "#e53e3e";

      submitRow.appendChild(submitBtn);
      submitRow.appendChild(errorEl);

      form.appendChild(hp);
      form.appendChild(fieldGroup);
      form.appendChild(submitRow);

      wrapper.appendChild(info);
      wrapper.appendChild(form);

      initNickname(form);
      handleSubmit(form, commentId);

      return wrapper;
    }

    function attachReplyListeners(root: HTMLElement | Document = document) {
      root.querySelectorAll<HTMLButtonElement>(".reply-btn:not([data-bound])").forEach(btn => {
        btn.dataset.bound = "1";
        btn.addEventListener("click", () => {
          const commentId = btn.dataset.commentId!;
          const nickname = btn.dataset.nickname!;
          const mount = document.querySelector<HTMLDivElement>(`.reply-form-mount[data-parent-id="${commentId}"]`);
          if (!mount) return;
          document.querySelectorAll(".reply-form-wrapper").forEach(w => w.remove());
          mount.appendChild(buildReplyForm(commentId, nickname));
          mount.querySelector<HTMLTextAreaElement>("[name=body]")?.focus();
        });
      });
    }

    const rootForm = document.querySelector<HTMLFormElement>("#comment-form-root");
    if (rootForm) {
      initNickname(rootForm);
      handleSubmit(rootForm);
    }

    attachReplyListeners();

    function syncMyBadges() {
      const myNick = getNickname();
      document.querySelectorAll<HTMLSpanElement>(".my-comment-badge").forEach(b => {
        b.style.display = b.dataset.nickname === myNick ? "" : "none";
      });
    }
    syncMyBadges();

    const adminPw = section.dataset.adminPw ?? "";
    let adminMode = false;

    function setAdminMode(on: boolean) {
      adminMode = on;
      document.querySelectorAll<HTMLButtonElement>(".delete-btn").forEach(btn => {
        btn.style.display = on ? "" : "none";
      });
    }

    function attachDeleteListeners(root: HTMLElement | Document = document) {
      root.querySelectorAll<HTMLButtonElement>(".delete-btn:not([data-del-bound])").forEach(btn => {
        btn.dataset.delBound = "1";
        const id = btn.dataset.commentId!;
        btn.addEventListener("click", async () => {
          if (!confirm("댓글을 삭제하시겠습니까?")) return;
          const { error } = await supabase.from("comments").delete().eq("id", id);
          if (error) { alert("삭제 실패"); return; }
          btn.closest<HTMLLIElement>(".comment-item")?.remove();
          updateCount(-1);
        });
      });
    }

    document.getElementById("admin-toggle")?.addEventListener("click", () => {
      if (adminMode) { setAdminMode(false); return; }
      const pw = prompt("관리자 비밀번호");
      if (pw === adminPw) setAdminMode(true);
      else if (pw !== null) alert("비밀번호가 틀렸습니다.");
    });

    attachDeleteListeners();

    function syncLikeButtons() {
      const liked = getLikedIds();
      document.querySelectorAll<HTMLButtonElement>(".like-btn").forEach(btn => {
        const isLiked = liked.has(btn.dataset.commentId ?? "");
        btn.style.color = isLiked ? "var(--accent)" : "var(--fg-mute)";
        const svgEl = btn.querySelector("svg");
        if (svgEl) svgEl.setAttribute("fill", isLiked ? "currentColor" : "none");
      });
    }

    function attachLikeListeners(root: HTMLElement | Document = document) {
      root.querySelectorAll<HTMLButtonElement>(".like-btn:not([data-like-bound])").forEach(btn => {
        btn.dataset.likeBound = "1";
        btn.addEventListener("click", async () => {
          const { liked, count } = await toggleLike(btn.dataset.commentId!);
          btn.style.color = liked ? "var(--accent)" : "var(--fg-mute)";
          const svgEl = btn.querySelector("svg");
          if (svgEl) svgEl.setAttribute("fill", liked ? "currentColor" : "none");
          const label = btn.querySelector<HTMLSpanElement>(".like-label");
          if (label) label.textContent = count > 0 ? String(count) : "좋아요";
        });
      });
    }

    syncLikeButtons();
    attachLikeListeners();

    const PAGE = 10;
    let currentOrder: "asc" | "desc" = "asc";

    const loadMoreBtn = document.getElementById("load-more-btn") as HTMLButtonElement | null;
    const loadMoreWrap = document.getElementById("load-more-wrap");

    async function refreshComments() {
      const { data } = await supabase
        .from("comments")
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        .select("*" as any)
        .eq("post_id", postId)
        .is("honeypot", null)
        .order("created_at", { ascending: currentOrder === "asc" })
        .range(0, PAGE - 1);

      if (!data) return;
      const comments = data as Comment[];

      document.getElementById("no-comments")?.remove();
      const listContainer = document.getElementById("comments-list")!;
      let list = listContainer.querySelector<HTMLUListElement>("ul");
      if (!list) {
        list = document.createElement("ul");
        list.className = "space-y-4";
        listContainer.appendChild(list);
      }
      list.replaceChildren();

      comments.filter(c => !c.parent_id).forEach(c => list!.appendChild(buildCommentEl(c, false)));
      comments.filter(c => !!c.parent_id).forEach(c => {
        const parentLi = list!.querySelector<HTMLLIElement>(`.comment-item[data-id="${c.parent_id}"]`);
        if (!parentLi) return;
        let replyList = parentLi.querySelector<HTMLUListElement>("ul");
        if (!replyList) {
          replyList = document.createElement("ul");
          replyList.className = "ml-6 mt-3 border-l pl-4 space-y-4";
          replyList.style.borderColor = "var(--border)";
          parentLi.querySelector(".reply-form-mount")?.before(replyList);
        }
        replyList.appendChild(buildCommentEl(c, true));
      });

      const countEl = document.getElementById("comments-count");
      if (countEl) countEl.textContent = `(${comments.filter(c => !c.parent_id).length})`;

      attachReplyListeners();
      syncLikeButtons();
      attachLikeListeners();
      syncMyBadges();
      attachDeleteListeners();
      if (adminMode) setAdminMode(true);

      offset = comments.filter(c => !c.parent_id).length;
      if (comments.filter(c => !c.parent_id).length < PAGE) {
        loadMoreWrap?.classList.add("hidden");
      } else {
        loadMoreWrap?.classList.remove("hidden");
      }
    }

    let offset = PAGE;

    loadMoreBtn?.addEventListener("click", async () => {
      loadMoreBtn.textContent = "불러오는 중...";
      loadMoreBtn.disabled = true;

      const { data } = await supabase
        .from("comments")
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        .select("*" as any)
        .eq("post_id", postId)
        .is("honeypot", null)
        .is("parent_id", null)
        .order("created_at", { ascending: true })
        .range(offset, offset + PAGE - 1);

      if (data && (data as Comment[]).length > 0) {
        const list = getOrCreateTopList();
        (data as Comment[]).forEach(c => list.appendChild(buildCommentEl(c, false)));
        attachReplyListeners();
        syncLikeButtons();
        attachLikeListeners();
        syncMyBadges();
        attachDeleteListeners();
        if (adminMode) setAdminMode(true);
        offset += (data as Comment[]).length;
        if ((data as Comment[]).length < PAGE) loadMoreWrap?.classList.add("hidden");
      } else {
        loadMoreWrap?.classList.add("hidden");
      }

      loadMoreBtn.textContent = "댓글 더 보기";
      loadMoreBtn.disabled = false;
    });

    async function loadAllComments(order: "asc" | "desc") {
      const { data } = await supabase
        .from("comments")
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        .select("*" as any)
        .eq("post_id", postId)
        .is("honeypot", null)
        .order("created_at", { ascending: order === "asc" });

      if (!data) return;
      const list = getOrCreateTopList();
      list.replaceChildren();

      (data as Comment[]).filter(c => !c.parent_id).forEach(c => list.appendChild(buildCommentEl(c, false)));
      (data as Comment[]).filter(c => !!c.parent_id).forEach(c => {
        const parentLi = list.querySelector<HTMLLIElement>(`.comment-item[data-id="${c.parent_id}"]`);
        if (!parentLi) return;
        let replyList = parentLi.querySelector<HTMLUListElement>("ul");
        if (!replyList) {
          replyList = document.createElement("ul");
          replyList.className = "ml-6 mt-3 border-l pl-4 space-y-4";
          replyList.style.borderColor = "var(--border)";
          parentLi.querySelector(".reply-form-mount")?.before(replyList);
        }
        replyList.appendChild(buildCommentEl(c, true));
      });

      attachReplyListeners();
      syncLikeButtons();
      attachLikeListeners();
      syncMyBadges();
      attachDeleteListeners();
      if (adminMode) setAdminMode(true);
    }

    const sortSelect = document.getElementById("sort-select") as HTMLSelectElement | null;
    sortSelect?.addEventListener("change", async () => {
      const order = sortSelect.value as "asc" | "desc";
      if (currentOrder === order) return;
      currentOrder = order;
      await loadAllComments(order);
    });

    refreshComments();
  }

  document.addEventListener("astro:page-load", initComments);
</script>
