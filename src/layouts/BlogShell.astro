---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Sidebar from "@/components/Sidebar.astro";
import RightRail from "@/components/RightRail.astro";
import Layout from "./Layout.astro";

type RailVariant = "discovery" | "category" | "reading";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  mode?: "discovery" | "reading";
  rail?: RailVariant;
  activeCategory?: string;
  activeTopic?: string;
  activePage?: string;
  postId?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  description,
  ogImage,
  mode = "discovery",
  rail = "discovery",
  activeCategory,
  activeTopic,
  activePage,
  postId,
  headings,
} = Astro.props;
---

<Layout title={title ?? "jacobsidian"} description={description} ogImage={ogImage}>
  <!-- FOUC 방지: 사이드바 상태를 paint 전에 적용 -->
  <script is:inline>
    (function () {
      const L = localStorage.getItem("jb:sidebar-left");
      const R = localStorage.getItem("jb:sidebar-right");
      if (L === "closed") {
        document.documentElement.style.setProperty("--left-rail-w", "0px");
      } else {
        document.documentElement.style.setProperty("--left-rail-w", "232px");
      }
      if (R === "closed") {
        document.documentElement.style.setProperty("--right-rail-w", "0px");
      } else {
        document.documentElement.style.setProperty("--right-rail-w", "260px");
      }
    })();
  </script>

  <Header />
  <div id="shell-body" class="flex flex-1 min-h-0">
    <Sidebar {activeCategory} {activeTopic} {activePage} />

    <main
      id="main-content"
      transition:name="main-content"
      class:list={[
        "flex-1 min-w-0",
        mode === "reading" ? "flex justify-center reading-shell" : "discovery-shell",
      ]}
    >
      {mode === "reading" ? (
        <div class="w-full max-w-reading">
          <slot />
        </div>
      ) : (
        <slot />
      )}
    </main>

    <RightRail
      variant={rail}
      {postId}
      categoryKey={activeCategory}
      {headings}
    />
  </div>
  <Footer class="!max-w-none !px-6 !mx-0 w-full" />
</Layout>

<script>
  // ── 사이드바 접기/펼치기 ──────────────────────────────────────
  function initRailToggles() {
    const leftRail  = document.getElementById("left-rail") as HTMLElement | null;
    const rightRail = document.getElementById("right-rail") as HTMLElement | null;
    const leftBtn   = document.getElementById("toggle-left-rail") as HTMLElement | null;
    const rightBtn  = document.getElementById("toggle-right-rail") as HTMLElement | null;
    const leftIcon  = document.getElementById("toggle-left-icon") as HTMLElement | null;
    const rightIcon = document.getElementById("toggle-right-icon") as HTMLElement | null;

    if (!leftRail || !rightRail) return;

    const LEFT_W  = "232px";
    const RIGHT_W = "260px";

    function applyLeft(open: boolean, animate = true) {
      if (!animate) leftRail!.style.transition = "none";
      leftRail!.style.width = open ? LEFT_W : "0px";
      if (!animate) requestAnimationFrame(() => { leftRail!.style.transition = ""; });
      // rotate chevron: open=pointing left(←), closed=pointing right(→)
      leftIcon?.style.setProperty("transform", open ? "" : "rotate(180deg)");
      localStorage.setItem("jb:sidebar-left", open ? "open" : "closed");
    }

    function applyRight(open: boolean, animate = true) {
      if (!animate) rightRail!.style.transition = "none";
      rightRail!.style.width = open ? RIGHT_W : "0px";
      if (!animate) requestAnimationFrame(() => { rightRail!.style.transition = ""; });
      rightIcon?.style.setProperty("transform", open ? "" : "rotate(180deg)");
      localStorage.setItem("jb:sidebar-right", open ? "open" : "closed");
    }

    // 초기 상태 (FOUC 없이) — transition 없이 즉시 적용
    const leftOpen  = localStorage.getItem("jb:sidebar-left")  !== "closed";
    const rightOpen = localStorage.getItem("jb:sidebar-right") !== "closed";
    applyLeft(leftOpen, false);
    applyRight(rightOpen, false);

    leftBtn?.addEventListener("click", () => {
      applyLeft(leftRail!.style.width === "0px");
    });
    rightBtn?.addEventListener("click", () => {
      applyRight(rightRail!.style.width === "0px");
    });
  }

  document.addEventListener("astro:page-load", initRailToggles);

  // ── localStorage hydration: Now Reading + Pinned ─────────────
  let lastPinnedKey: string | null = null;

  function hydratePersonalization() {
    // Now Reading
    const nrSection = document.getElementById("now-reading-section");
    if (nrSection) {
      let nr: { postId: string; title: string; author: string; category: string; url: string; progress: number } | null = null;
      try { nr = JSON.parse(localStorage.getItem("jb:now-reading") ?? "null"); } catch { /* empty */ }

      if (nr) {
        nrSection.classList.remove("hidden");
        const titleEl = nrSection.querySelector<HTMLAnchorElement>("#now-reading-title");
        const authorEl = nrSection.querySelector("#now-reading-author");
        const barEl = nrSection.querySelector<HTMLElement>("#now-reading-bar");
        const pctEl = nrSection.querySelector("#now-reading-pct");
        const thumbEl = document.getElementById("now-reading-thumb");
        if (titleEl) { titleEl.textContent = nr.title; titleEl.href = nr.url ?? "#"; }
        if (authorEl) authorEl.textContent = nr.author ?? "";
        if (barEl) barEl.style.width = `${nr.progress}%`;
        if (pctEl) pctEl.textContent = `${nr.progress}%`;
        if (thumbEl) thumbEl.classList.toggle("hidden", nr.category !== "book");
      } else {
        nrSection.classList.add("hidden");
      }
    }

    // Pinned
    const section = document.getElementById("pinned-section");
    const list = document.getElementById("pinned-list");
    if (section && list) {
      let pinned: { id: string; title: string; url: string; category: string }[] = [];
      try { pinned = JSON.parse(localStorage.getItem("jb:pinned") ?? "[]"); } catch { /* empty */ }

      const newKey = pinned.map(p => p.id).join(",");
      if (lastPinnedKey === newKey) return;
      lastPinnedKey = newKey;

      list.replaceChildren();
      if (pinned.length > 0) {
        section.classList.remove("hidden");
        for (const p of pinned) {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = p.url;
          a.className = "flex items-center gap-2 text-[12.5px] leading-snug hover:text-accent transition-colors";
          a.style.color = "var(--fg-mute)";

          const dot = document.createElement("span");
          dot.className = "cat-dot shrink-0";
          const catParent = p.category.includes("-") ? p.category.split("-")[0] : p.category;
          dot.style.background = `var(--cat-${catParent})`;

          const text = document.createElement("span");
          text.className = "truncate";
          text.textContent = p.title;

          a.appendChild(dot);
          a.appendChild(text);
          li.appendChild(a);
          list.appendChild(li);
        }
      } else {
        section.classList.add("hidden");
      }
    }
  }

  document.addEventListener("astro:page-load", hydratePersonalization);
</script>
