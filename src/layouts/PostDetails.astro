---
import { render, type CollectionEntry } from "astro:content";
import BlogShell from "@/layouts/BlogShell.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import { getCategoryMeta, PARENTS } from "@/utils/getCategories";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";
import { getLangFromUrl } from "@/i18n";
import { getSeriesSlug } from "@/utils/getSeriesSlug";
import GraphCanvas from "@/components/GraphCanvas.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import Comments from "@/components/comments/Comments.astro";
import PostReactions from "@/components/reactions/PostReactions.astro";
import PageViewTracker from "@/components/analytics/PageViewTracker.astro";
import ViewCount from "@/components/ViewCount.astro";

type Entry = CollectionEntry<"posts">;

type Props = {
  post: Entry;
  posts: Entry[];
  hreflangPairs?: { ko: string; en?: string };
  koFallback?: boolean;
};

const { post, posts, hreflangPairs, koFallback = false } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
} = post.data;

const { Content, headings } = await render(post);

const readingTime = Math.max(1, Math.ceil((post.body ?? "").split(/\s+/).length / 200));

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage.
// Derive path from current URL so /en/... pages get /en/.../og.png correctly.
if (!ogImageUrl && SITE.dynamicOgImage) {
  const pagePath = Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname
    : Astro.url.pathname + "/";
  ogImageUrl = `${pagePath}og.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

/* ========== Category helpers ========== */

const categoryKey = post.data.category;
const catMeta = getCategoryMeta(categoryKey);
const [catParent, catSub] = categoryKey.split("-");
const catUrlPath = `${catParent}/${catSub}`;

/* ========== Breadcrumbs ========== */
const parentMeta = PARENTS[catParent];
const breadcrumbs = [
  { name: "Home", url: new URL("/", Astro.url.origin).href },
  { name: parentMeta?.label ?? catParent, url: new URL(`/${catParent}/`, Astro.url.origin).href },
  { name: catMeta?.label ?? catSub, url: new URL(`/${catUrlPath}/`, Astro.url.origin).href },
  { name: title, url: new URL(getPath(post), Astro.url.origin).href },
];

/* ========== Prev/Next Posts ========== */

const currentPostIndex = posts.findIndex(a => a.id === post.id);

const prevPost = currentPostIndex > 0 ? posts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex !== -1 && currentPostIndex < posts.length - 1
    ? posts[currentPostIndex + 1]
    : null;

/* ========== Series ========== */

const seriesName = post.data.series;
const seriesChapters = seriesName
  ? posts
      .filter(p => p.data.series === seriesName && !p.data.draft)
      .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];
const seriesIndex = seriesChapters.findIndex(p => p.id === post.id);
const prevChapter = seriesIndex > 0 ? seriesChapters[seriesIndex - 1] : null;
const nextChapter = seriesIndex !== -1 && seriesIndex < seriesChapters.length - 1
  ? seriesChapters[seriesIndex + 1]
  : null;
const seriesSlug = seriesName ? await getSeriesSlug(seriesName) : null;
---

<BlogShell
  mode="reading"
  rail="reading"
  activeCategory={categoryKey}
  postId={post.id}
  headings={headings}
  title={`${title} | ${SITE.title}`}
  description={description}
  ogImage={ogImage}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  tags={tags}
  breadcrumbs={breadcrumbs}
  hreflangPairs={hreflangPairs}
>
  <!-- Back link (series: name + chapter indicator merged) -->
  <a
    href={seriesSlug ? `/series/${seriesSlug}` : `/${catUrlPath}`}
    class="flex items-center gap-1 text-sm mb-4 transition-colors hover:text-accent"
    style="color: var(--fg-mute);"
  >
    <IconChevronLeft class="size-3.5" />
    {seriesName ?? (catMeta?.label ?? catUrlPath)}
    {seriesName && seriesChapters.length > 0 && (
      <span class="font-mono text-[11px]" style="color: var(--fg-faint);">· {seriesIndex + 1} / {seriesChapters.length}화</span>
    )}
  </a>

  <!-- English fallback notice -->
  {koFallback && (
    <div class="mb-4 flex items-center gap-2 rounded-md border border-border px-3 py-2 text-[13px]" style="color: var(--fg-mute); background: color-mix(in srgb, var(--accent) 6%, transparent);">
      <span>🌐</span>
      <span>English version coming soon. Showing the original Korean post.</span>
    </div>
  )}

  <!-- Cinema poster + title row -->
  <div class:list={["flex gap-4", post.data.category === "review-cinema" && post.data.poster ? "items-start" : ""]}>
    {post.data.category === "review-cinema" && post.data.poster && (
      <img
        src={post.data.poster}
        alt={title}
        class="shrink-0 rounded w-[80px] object-cover shadow-sm"
        style="aspect-ratio: 2/3;"
      />
    )}
    <div class="flex-1 min-w-0">
      <!-- Title -->
      <h1 class="block text-[28px] font-bold tracking-[-0.02em] leading-snug text-foreground mb-2">
        {title}
      </h1>
      {post.data.category === "review-book" && (
        <p class="mt-1 text-base text-foreground/50">{author}</p>
      )}
    {description && (
      <p class="mt-2 text-base text-foreground/60 leading-relaxed">{description}</p>
    )}
    <div class="my-2 flex items-center gap-2">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      <ViewCount postId={post.id} />
      <span aria-hidden="true" class="text-foreground/30">·</span>
      <span class="text-sm opacity-80">{readingTime} min read</span>
      <span
        aria-hidden="true"
        class:list={[
          "max-sm:hidden",
          { hidden: !SITE.editPost.enabled || hideEditPost },
        ]}>|</span
      >
      <EditPost {hideEditPost} {post} class="max-sm:hidden" />
      <div class="ml-auto flex items-center gap-0 sm:gap-2">
        <!-- Pin 토글 -->
        <button
          id="pin-btn"
          data-post-id={post.id}
          data-title={title}
          data-url={`/${catUrlPath}/${post.data.slug ?? post.id}`}
          data-category={post.data.category}
          class="flex items-center gap-1.5 text-sm text-foreground/40 hover:text-accent transition-colors sm:px-0 sm:py-0"
          style="min-width:44px; min-height:44px; justify-content:center;"
          aria-label="Pin this post"
        >
          <svg id="pin-icon" xmlns="http://www.w3.org/2000/svg" class="size-5 sm:size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="17" x2="12" y2="22"/><path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z"/>
          </svg>
          <span id="pin-btn-label" class="max-sm:hidden">Pin</span>
        </button>
        <!-- Share -->
        <div class="relative" id="share-container">
          <button
            id="share-btn"
            aria-haspopup="true"
            aria-expanded="false"
            class="flex items-center gap-1.5 text-sm text-foreground/40 hover:text-accent transition-colors"
            style="min-width:44px; min-height:44px; justify-content:center;"
          >
            <svg id="share-icon" xmlns="http://www.w3.org/2000/svg" class="size-5 sm:size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
            </svg>
            <svg id="share-check-icon" xmlns="http://www.w3.org/2000/svg" class="size-5 sm:size-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span id="share-label" class="max-sm:hidden">Share</span>
          </button>

          <div
            id="share-dropdown"
            class="hidden absolute right-0 top-full mt-1 z-50 min-w-[160px] rounded-lg border border-(--border) bg-(--background) shadow-lg py-1"
            role="menu"
          >
            <button
              id="share-copy"
              class="w-full flex items-center gap-2.5 px-3 py-2 text-sm text-foreground/70 hover:text-foreground hover:bg-(--muted) transition-colors"
              role="menuitem"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
              </svg>
              링크 복사
            </button>

            <a
              id="share-twitter"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2.5 px-3 py-2 text-sm text-foreground/70 hover:text-foreground hover:bg-(--muted) transition-colors"
              role="menuitem"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              X (Twitter)
            </a>

            <a
              id="share-kakao"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2.5 px-3 py-2 text-sm text-foreground/70 hover:text-foreground hover:bg-(--muted) transition-colors"
              role="menuitem"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 3C6.477 3 2 6.477 2 10.8c0 2.7 1.566 5.08 3.938 6.538L5.1 21l4.688-2.85c.72.11 1.46.17 2.212.17 5.523 0 10-3.477 10-7.77C22 6.477 17.523 3 12 3z"/>
              </svg>
              카카오톡
            </a>

            <a
              id="share-facebook"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2.5 px-3 py-2 text-sm text-foreground/70 hover:text-foreground hover:bg-(--muted) transition-colors"
              role="menuitem"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              Facebook
            </a>
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>
  <article
    id="article"
    class="app-prose mt-8 w-full prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    data-pagefind-body
    data-pagefind-filter={`lang:${currentLang}`}
    data-category={post.data.category}
    data-post-id={post.id}
    data-title={title}
    data-author={author ?? ""}
  >
    <Content />
  </article>
  <!-- 텍스트 인용 공유 팝업 -->
  <div
    id="quote-share-popup"
    class="hidden fixed z-[100] flex items-center gap-1 rounded-full border border-(--border) bg-(--background) px-3 py-1.5 shadow-lg cursor-pointer"
    style="pointer-events:auto; transform: translateX(-50%);"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-foreground/50 shrink-0" viewBox="0 0 24 24" fill="currentColor">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
    </svg>
    <span class="text-xs text-foreground/70 whitespace-nowrap">인용 공유</span>
  </div>
  <RelatedPosts currentPost={post} allPosts={posts} />
  <BackToTopButton headings={headings} />

  <div class="mt-12 lg:hidden">
    <div class="rounded-lg border border-border overflow-hidden">
      <div class="flex items-center justify-between px-4 py-2.5 border-b border-border bg-background">
        <span class="text-sm font-medium">Graph View</span>
        <button
          id="graph-expand-btn"
          title="전체 그래프 보기"
          class="text-foreground/40 hover:text-accent transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="5" cy="12" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="19" cy="19" r="2"/>
            <path d="M7 12h10M17 7l-4 3M17 17l-4-3"/>
          </svg>
        </button>
      </div>
      <GraphCanvas focusId={post.id} height={240} />
    </div>
  </div>

  <!-- Graph overlay -->
  <div
    id="graph-overlay"
    class="fixed inset-0 z-[100] hidden items-center justify-center p-6"
  >
    <div
      id="graph-overlay-backdrop"
      class="absolute inset-0 bg-background/60 backdrop-blur-sm"
    ></div>
    <div class="relative z-10 w-full max-w-3xl rounded-xl border border-border overflow-hidden shadow-2xl">
      <div class="flex items-center justify-between px-4 py-2.5 border-b border-border bg-background">
        <span class="text-sm font-medium">Graph View</span>
        <button
          id="graph-overlay-close"
          class="text-foreground/40 hover:text-accent transition-colors"
          title="닫기"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <GraphCanvas height={560} />
    </div>
  </div>

  <PageViewTracker postId={post.id} />
  <PostReactions postId={post.id} />
  {!post.data.disableComments && <Comments postId={post.id} />}

  <hr class="my-8 border-dashed" />

  <EditPost class="sm:hidden" {hideEditPost} {post} />

  {tags.filter(t => t !== "post" && t !== "book" && t !== "others").length > 0 && (
    <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {tags
        .filter(t => t !== "post" && t !== "book" && t !== "others")
        .map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>
  )}

  <!-- Series chapter navigation -->
  {seriesName && seriesChapters.length > 0 && (
    <>
      <hr class="my-6 border-dashed" />
      <div data-pagefind-ignore class="rounded-lg border border-border overflow-hidden mb-2">
        <!-- 헤더 -->
        <a
          href={`/series/${seriesSlug}`}
          class="flex items-center justify-between px-4 py-2.5 border-b border-border text-[12px] font-medium hover:text-accent transition-colors"
          style="color: var(--fg-mute);"
        >
          <span>◎ {seriesName}</span>
          <span style="color: var(--fg-faint);">목차 →</span>
        </a>
        <!-- 전체 챕터 목록 -->
        <ol class="divide-y divide-border">
          {seriesChapters.map((chapter) => {
            const isCurrent = chapter.id === post.id;
            return (
              <li>
                <a
                  href={getPath(chapter)}
                  class:list={[
                    "flex items-center gap-3 px-4 py-2.5 text-[13px] transition-colors hover:text-accent",
                    isCurrent ? "font-semibold" : "",
                  ]}
                  aria-current={isCurrent ? "page" : undefined}
                >
                  <span class="font-mono text-[11px] shrink-0 w-5 text-right" style="color: var(--fg-faint);">
                    {String(chapter.data.seriesOrder ?? 0).padStart(2, "0")}
                  </span>
                  <span class:list={["truncate", isCurrent ? "" : ""]} style={isCurrent ? "" : "color: var(--fg-mute);"}>
                    {chapter.data.title}
                  </span>
                  {isCurrent && <span class="ml-auto shrink-0 font-mono text-[10px]" style="color: var(--fg-faint);">reading</span>}
                </a>
              </li>
            );
          })}
        </ol>
        <!-- prev / next -->
        {(prevChapter || nextChapter) && (
          <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-border border-t border-border">
            {prevChapter ? (
              <a href={getPath(prevChapter)} class="flex items-start gap-3 px-4 py-3 hover:bg-border/30 transition-colors">
                <IconChevronLeft class="size-3.5 mt-0.5 shrink-0" style="color: var(--fg-mute);" />
                <div class="min-w-0">
                  <p class="text-[11px] mb-0.5" style="color: var(--fg-mute);">{prevChapter.data.seriesOrder}화</p>
                  <p class="text-sm font-medium truncate">{prevChapter.data.title}</p>
                </div>
              </a>
            ) : <div />}
            {nextChapter && (
              <a href={getPath(nextChapter)} class="flex items-start justify-end gap-3 px-4 py-3 hover:bg-border/30 transition-colors text-end">
                <div class="min-w-0">
                  <p class="text-[11px] mb-0.5" style="color: var(--fg-mute);">{nextChapter.data.seriesOrder}화</p>
                  <p class="text-sm font-medium truncate">{nextChapter.data.title}</p>
                </div>
                <IconChevronRight class="size-3.5 mt-0.5 shrink-0" style="color: var(--fg-mute);" />
              </a>
            )}
          </div>
        )}
      </div>
    </>
  )}

  <!-- Previous/Next Post Buttons -->
  {(prevPost || nextPost) && <hr class="my-6 border-dashed" />}
  <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    {
      prevPost && (
        <a
          href={getPath(prevPost)}
          class="flex w-full gap-1 hover:opacity-75"
        >
          <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
          <div>
            <span>이전 글</span>
            <div class="text-sm text-accent/85">{prevPost.data.title}</div>
          </div>
        </a>
      )
    }
    {
      nextPost && (
        <a
          href={getPath(nextPost)}
          class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
        >
          <div>
            <span>다음 글</span>
            <div class="text-sm text-accent/85">{nextPost.data.title}</div>
          </div>
          <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
        </a>
      )
    }
  </div>
</BlogShell>

<script>
  function initTocSpy() {
    const items = document.querySelectorAll<HTMLAnchorElement>(".bd-toc-item");
    if (!items.length) return;
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            items.forEach(item => {
              const active = item.dataset.heading === id;
              item.style.borderLeftWidth = active ? "2px" : "1px";
              item.style.borderLeftColor = active ? "var(--accent)" : "var(--border)";
              item.style.color = active ? "var(--accent)" : "";
            });
          }
        });
      },
      { rootMargin: "0px 0px -60% 0px" }
    );
    document.querySelectorAll("article h2[id], article h3[id]").forEach(h => observer.observe(h));
  }

  initTocSpy();
  document.addEventListener("astro:after-swap", initTocSpy);
</script>

<script>
  function initGraphOverlay() {
    const expandBtn = document.getElementById("graph-expand-btn");
    const overlay = document.getElementById("graph-overlay");
    const closeBtn = document.getElementById("graph-overlay-close");
    const backdrop = document.getElementById("graph-overlay-backdrop");
    if (!expandBtn || !overlay || !closeBtn || !backdrop) return;

    const open = () => {
      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      document.body.style.overflow = "hidden";
      // Trigger lazy init for the overlay's GraphCanvas
      overlay.querySelectorAll("[data-is-mini]").forEach(c =>
        c.dispatchEvent(new CustomEvent("graph:show"))
      );
    };
    const close = () => {
      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
      document.body.style.overflow = "";
    };

    expandBtn.addEventListener("click", open);
    closeBtn.addEventListener("click", close);
    backdrop.addEventListener("click", close);
    document.addEventListener("keydown", e => { if (e.key === "Escape") close(); });
  }

  initGraphOverlay();
  document.addEventListener("astro:after-swap", initGraphOverlay);

  function buildShareUrl(medium: string): string {
    const url = new URL(location.href);
    ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"].forEach(
      (k) => url.searchParams.delete(k)
    );
    url.searchParams.set("utm_source", "share");
    url.searchParams.set("utm_medium", medium);
    return url.toString();
  }

  function showCopiedFeedback() {
    const shareIcon = document.getElementById("share-icon");
    const checkIcon = document.getElementById("share-check-icon");
    const label = document.getElementById("share-label");
    if (shareIcon) shareIcon.classList.add("hidden");
    if (checkIcon) checkIcon.classList.remove("hidden");
    if (label) label.textContent = "Copied!";
    setTimeout(() => {
      if (shareIcon) shareIcon.classList.remove("hidden");
      if (checkIcon) checkIcon.classList.add("hidden");
      if (label) label.textContent = "Share";
    }, 1500);
  }

  // Module-level — abort previous listeners to prevent accumulation on astro:after-swap
  let shareAbortCtrl: AbortController | null = null;

  function initShareButton() {
    // Abort previous listeners to prevent accumulation on astro:after-swap
    shareAbortCtrl?.abort();
    shareAbortCtrl = new AbortController();
    const signal = shareAbortCtrl.signal;

    const btn = document.getElementById("share-btn");
    const dropdown = document.getElementById("share-dropdown");
    const container = document.getElementById("share-container");
    if (!btn || !dropdown) return;

    function closeDropdown() {
      dropdown!.classList.add("hidden");
      btn!.setAttribute("aria-expanded", "false");
    }

    function openDropdown() {
      const twitterUrl = `https://twitter.com/intent/tweet?url=${encodeURIComponent(buildShareUrl("twitter"))}&text=${encodeURIComponent(document.title)}`;
      const kakaoUrl = `https://story.kakao.com/share?url=${encodeURIComponent(buildShareUrl("kakao"))}`;
      const fbUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(buildShareUrl("facebook"))}`;
      (document.getElementById("share-twitter") as HTMLAnchorElement).href = twitterUrl;
      (document.getElementById("share-kakao") as HTMLAnchorElement).href = kakaoUrl;
      (document.getElementById("share-facebook") as HTMLAnchorElement).href = fbUrl;
      dropdown!.classList.remove("hidden");
      btn!.setAttribute("aria-expanded", "true");
    }

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      if (!dropdown!.classList.contains("hidden")) {
        closeDropdown();
      } else {
        openDropdown();
      }
    }, { signal });

    document.getElementById("share-copy")?.addEventListener("click", async () => {
      await navigator.clipboard.writeText(buildShareUrl("copy"));
      closeDropdown();
      showCopiedFeedback();
    }, { signal });

    document.addEventListener("click", (e) => {
      if (!container?.contains(e.target as Node)) closeDropdown();
    }, { signal });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeDropdown();
    }, { signal });
  }
  let quoteHideTimer: ReturnType<typeof setTimeout> | null = null;
  let quoteAbortCtrl: AbortController | null = null;

  function initQuoteShare() {
    quoteAbortCtrl?.abort();
    if (quoteHideTimer) { clearTimeout(quoteHideTimer); quoteHideTimer = null; }
    quoteAbortCtrl = new AbortController();
    const signal = quoteAbortCtrl.signal;

    const article = document.getElementById("article");
    const popup = document.getElementById("quote-share-popup") as HTMLElement | null;
    if (!article || !popup) return;

    function hidePopup() {
      popup!.classList.add("hidden");
    }

    document.addEventListener("selectionchange", () => {
      if (quoteHideTimer) clearTimeout(quoteHideTimer);
      const selection = window.getSelection();
      const text = selection?.toString().trim() ?? "";

      if (text.length < 10 || !article.contains(selection?.anchorNode ?? null)) {
        quoteHideTimer = setTimeout(hidePopup, 300);
        return;
      }

      const range = selection!.getRangeAt(0);
      const rect = range.getBoundingClientRect();
      const top = rect.bottom + 8;
      const left = rect.left + rect.width / 2;
      popup.style.top = `${top}px`;
      popup.style.left = `${left}px`;
      popup.classList.remove("hidden");

      popup.onclick = () => {
        const url = buildShareUrl("quote");
        const tweet = `"${text}"\n\n— ${document.title}\n${url}`;
        const twitterUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(tweet)}`;
        window.open(twitterUrl, "_blank", "noopener,noreferrer");
        hidePopup();
      };
    }, { signal });

    popup.addEventListener("mousedown", (e) => e.preventDefault(), { signal });
  }

  initShareButton();
  document.addEventListener("astro:after-swap", initShareButton);
  initQuoteShare();
  document.addEventListener("astro:after-swap", initQuoteShare);
</script>

<script>
  // ── Pin button ───────────────────────────────────────────────
  function initPinButton() {
    const btn = document.getElementById("pin-btn") as HTMLButtonElement | null;
    if (!btn) return;
    const pinBtn = btn;

    const { postId, title, url, category } = btn.dataset as Record<string, string>;
    const label = document.getElementById("pin-btn-label");
    const icon = document.getElementById("pin-icon");

    function getPinned(): { id: string; title: string; url: string; category: string }[] {
      try { return JSON.parse(localStorage.getItem("jb:pinned") ?? "[]"); } catch { return []; }
    }
    function setPinned(list: typeof pinned) {
      localStorage.setItem("jb:pinned", JSON.stringify(list));
    }

    let pinned = getPinned();

    function syncUI() {
      const isPinned = pinned.some(p => p.id === postId);
      if (label) label.textContent = isPinned ? "Pinned" : "Pin";
      if (icon) icon.setAttribute("fill", isPinned ? "currentColor" : "none");
      pinBtn.style.color = isPinned ? "var(--accent)" : "";
    }

    syncUI();

    btn.addEventListener("click", () => {
      pinned = getPinned();
      const idx = pinned.findIndex(p => p.id === postId);
      if (idx >= 0) {
        pinned.splice(idx, 1);
      } else {
        pinned.push({ id: postId, title, url, category });
      }
      setPinned(pinned);
      syncUI();
    });
  }

  // ── Now Reading 위치 복구 토스트 ─────────────────────────────
  function initResumeReading() {
    const article = document.getElementById("article");
    if (!article) return;
    const currentPostId = article.dataset.postId;

    let saved: { postId: string; progress: number } | null = null;
    try { saved = JSON.parse(localStorage.getItem("jb:now-reading") ?? "null"); } catch { /* empty */ }
    if (!saved || saved.postId !== currentPostId || saved.progress < 5) return;

    const pct = saved.progress;

    const toast = document.createElement("div");
    toast.id = "resume-toast";
    toast.setAttribute("style", [
      "position:fixed", "top:12px", "right:16px", "z-index:50",
      "display:flex", "align-items:center", "gap:10px",
      "padding:8px 14px",
      "background:var(--background)", "border:1px solid var(--border)",
      "border-radius:8px", "font-size:13px", "color:var(--foreground)",
      "box-shadow:0 4px 16px rgba(0,0,0,0.18)",
      "opacity:0", "transform:translateY(-8px)",
      "transition:opacity 200ms ease,transform 200ms ease",
    ].join(";"));

    const label = document.createElement("span");
    label.style.color = "var(--fg-mute)";
    label.textContent = `${pct}% 읽었습니다`;

    const resumeBtn = document.createElement("button");
    resumeBtn.id = "resume-btn";
    resumeBtn.style.cssText = "color:var(--accent);font-weight:500;white-space:nowrap;cursor:pointer;";
    resumeBtn.textContent = "이어서 읽기 →";

    const dismissBtn = document.createElement("button");
    dismissBtn.id = "resume-dismiss";
    dismissBtn.style.cssText = "color:var(--fg-faint);cursor:pointer;padding:0 2px;font-size:16px;line-height:1;";
    dismissBtn.setAttribute("aria-label", "닫기");
    dismissBtn.textContent = "×";

    toast.appendChild(label);
    toast.appendChild(resumeBtn);
    toast.appendChild(dismissBtn);
    document.body.appendChild(toast);

    requestAnimationFrame(() => requestAnimationFrame(() => {
      toast.style.opacity = "1";
      toast.style.transform = "translateY(0)";
    }));

    function dismiss() {
      toast.style.opacity = "0";
      toast.style.transform = "translateY(-8px)";
      setTimeout(() => toast.remove(), 200);
    }

    resumeBtn.addEventListener("click", () => {
      const art = document.getElementById("article");
      if (art) {
        const articleEnd = art.getBoundingClientRect().bottom + window.scrollY - window.innerHeight;
        window.scrollTo({ top: Math.round((pct / 100) * articleEnd), behavior: "smooth" });
      }
      clearTimeout(timer);
      dismiss();
    }, { once: true });

    dismissBtn.addEventListener("click", () => { clearTimeout(timer); dismiss(); }, { once: true });

    const timer = setTimeout(dismiss, 8000);
  }

  // ── Now Reading 자동 추적 (모든 콘텐츠) ──────────────────────
  function initNowReadingTracker() {
    const article = document.getElementById("article");
    if (!article) return;

    const { postId, title, author, category } = article.dataset as Record<string, string>;
    const url = window.location.pathname;

    function getScrollPct() {
      const articleEnd = article!.getBoundingClientRect().bottom + window.scrollY - window.innerHeight;
      return articleEnd > 0 ? Math.min(100, Math.round((window.scrollY / articleEnd) * 100)) : 0;
    }

    function save() {
      const progress = getScrollPct();
      localStorage.setItem("jb:now-reading", JSON.stringify({ postId, title, author, category, url, progress }));
    }

    // 페이지 진입 시 즉시 등록 (진행도는 현재 scroll 위치)
    save();

    let rafId: ReturnType<typeof requestAnimationFrame> | null = null;
    window.addEventListener("scroll", () => {
      if (rafId) return;
      rafId = requestAnimationFrame(() => { save(); rafId = null; });
    }, { passive: true });

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") save();
    });
  }

  initResumeReading();
  initPinButton();
  initNowReadingTracker();
  document.addEventListener("astro:after-swap", () => {
    initResumeReading();
    initPinButton();
    initNowReadingTracker();
  });
</script>

<script is:inline data-astro-rerun>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-20 h-0.5 w-full";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline hidden md:inline md:opacity-0 md:group-hover:opacity-75 md:focus:opacity-75";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      // Check if --file-name-offset custom property exists
      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      // Determine the top positioning class
      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
      copyButton.textContent = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );
</script>
