---
import { render, type CollectionEntry } from "astro:content";
import BlogShell from "@/layouts/BlogShell.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import { getCategoryMeta } from "@/utils/getCategories";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";
import GraphCanvas from "@/components/GraphCanvas.astro";

type Entry = CollectionEntry<"posts">;

type Props = {
  post: Entry;
  posts: Entry[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
} = post.data;

const { Content, headings } = await render(post);

const readingTime = Math.max(1, Math.ceil((post.body ?? "").split(/\s+/).length / 200));

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post)}index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

/* ========== Category helpers ========== */

const categoryKey = post.data.category;
const catMeta = getCategoryMeta(categoryKey);
const catUrlPath =
  categoryKey === "thought"
    ? "thoughts"
    : categoryKey === "book"
      ? "books"
      : categoryKey;

/* ========== Prev/Next Posts ========== */

const currentPostIndex = posts.findIndex(a => a.id === post.id);

const prevPost = currentPostIndex > 0 ? posts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex !== -1 && currentPostIndex < posts.length - 1
    ? posts[currentPostIndex + 1]
    : null;
---

<BlogShell
  mode="reading"
  rail="reading"
  activeCategory={categoryKey}
  postId={post.id}
  headings={headings}
  title={`${title} | ${SITE.title}`}
  description={description}
  ogImage={ogImage}
>
  <!-- Back link -->
  <a
    href={`/${catUrlPath}`}
    class="flex items-center gap-1 text-sm mb-4 transition-colors hover:text-accent"
    style="color: var(--fg-mute);"
  >
    <IconChevronLeft class="size-3.5" />
    {catMeta?.label ?? catUrlPath}
  </a>

  <!-- Title -->
  <h1 class="block text-[28px] font-bold tracking-[-0.02em] leading-snug text-foreground mb-2">
    {title}
  </h1>
    {post.data.category === "book" && (
      <p class="mt-1 text-base text-foreground/50">{author}</p>
    )}
    {description && (
      <p class="mt-2 text-base text-foreground/60 leading-relaxed">{description}</p>
    )}
    <div class="my-2 flex items-center gap-2">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      <span aria-hidden="true" class="text-foreground/30">·</span>
      <span class="text-sm opacity-80">{readingTime} min read</span>
      <span
        aria-hidden="true"
        class:list={[
          "max-sm:hidden",
          { hidden: !SITE.editPost.enabled || hideEditPost },
        ]}>|</span
      >
      <EditPost {hideEditPost} {post} class="max-sm:hidden" />
      <div class="ml-auto flex items-center gap-2">
        <!-- Now Reading (책 카테고리 전용) -->
        {post.data.category === "book" && (
          <button
            id="now-reading-btn"
            data-post-id={post.id}
            data-title={title}
            data-author={author ?? ""}
            class="flex items-center gap-1.5 text-sm text-foreground/40 hover:text-accent transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
            <span id="now-reading-btn-label">읽는 중</span>
          </button>
        )}
        <!-- Pin 토글 -->
        <button
          id="pin-btn"
          data-post-id={post.id}
          data-title={title}
          data-url={`/${catUrlPath}/${post.data.slug ?? post.id}`}
          data-category={post.data.category}
          class="flex items-center gap-1.5 text-sm text-foreground/40 hover:text-accent transition-colors"
        >
          <svg id="pin-icon" xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="17" x2="12" y2="22"/><path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z"/>
          </svg>
          <span id="pin-btn-label">Pin</span>
        </button>
        <!-- Share -->
        <button
          id="share-btn"
          class="flex items-center gap-1.5 text-sm text-foreground/40 hover:text-accent transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
          </svg>
          <span>Share</span>
        </button>
      </div>
    </div>
  <article
    id="article"
    class="app-prose mt-8 w-full max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    data-pagefind-body
  >
    <Content />
  </article>
  <BackToTopButton />

  <div class="mt-12">
    <div class="rounded-lg border border-border overflow-hidden">
      <div class="flex items-center justify-between px-4 py-2.5 border-b border-border bg-background">
        <span class="text-sm font-medium">Graph View</span>
        <button
          id="graph-expand-btn"
          title="전체 그래프 보기"
          class="text-foreground/40 hover:text-accent transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="5" cy="12" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="19" cy="19" r="2"/>
            <path d="M7 12h10M17 7l-4 3M17 17l-4-3"/>
          </svg>
        </button>
      </div>
      <GraphCanvas focusId={post.id} height={240} />
    </div>
  </div>

  <!-- Graph overlay -->
  <div
    id="graph-overlay"
    class="fixed inset-0 z-[100] hidden items-center justify-center p-6"
  >
    <div
      id="graph-overlay-backdrop"
      class="absolute inset-0 bg-background/60 backdrop-blur-sm"
    ></div>
    <div class="relative z-10 w-full max-w-3xl rounded-xl border border-border overflow-hidden shadow-2xl">
      <div class="flex items-center justify-between px-4 py-2.5 border-b border-border bg-background">
        <span class="text-sm font-medium">Graph View</span>
        <button
          id="graph-overlay-close"
          class="text-foreground/40 hover:text-accent transition-colors"
          title="닫기"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <GraphCanvas height={560} />
    </div>
  </div>

  <hr class="my-8 border-dashed" />

  <EditPost class="sm:hidden" {hideEditPost} {post} />

  {tags.filter(t => t !== "post" && t !== "book" && t !== "others").length > 0 && (
    <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {tags
        .filter(t => t !== "post" && t !== "book" && t !== "others")
        .map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>
  )}

  <!-- Previous/Next Post Buttons -->
  {(prevPost || nextPost) && <hr class="my-6 border-dashed" />}
  <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    {
      prevPost && (
        <a
          href={getPath(prevPost)}
          class="flex w-full gap-1 hover:opacity-75"
        >
          <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
          <div>
            <span>이전 글</span>
            <div class="text-sm text-accent/85">{prevPost.data.title}</div>
          </div>
        </a>
      )
    }
    {
      nextPost && (
        <a
          href={getPath(nextPost)}
          class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
        >
          <div>
            <span>다음 글</span>
            <div class="text-sm text-accent/85">{nextPost.data.title}</div>
          </div>
          <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
        </a>
      )
    }
  </div>
</BlogShell>

<script>
  function initTocSpy() {
    const items = document.querySelectorAll<HTMLAnchorElement>(".bd-toc-item");
    if (!items.length) return;
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            items.forEach(item => {
              const active = item.dataset.heading === id;
              item.style.borderLeftWidth = active ? "2px" : "1px";
              item.style.borderLeftColor = active ? "var(--accent)" : "var(--border)";
              item.style.color = active ? "var(--accent)" : "";
            });
          }
        });
      },
      { rootMargin: "0px 0px -60% 0px" }
    );
    document.querySelectorAll("article h2[id], article h3[id]").forEach(h => observer.observe(h));
  }

  initTocSpy();
  document.addEventListener("astro:after-swap", initTocSpy);
</script>

<script>
  function initGraphOverlay() {
    const expandBtn = document.getElementById("graph-expand-btn");
    const overlay = document.getElementById("graph-overlay");
    const closeBtn = document.getElementById("graph-overlay-close");
    const backdrop = document.getElementById("graph-overlay-backdrop");
    if (!expandBtn || !overlay || !closeBtn || !backdrop) return;

    const open = () => {
      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      document.body.style.overflow = "hidden";
      // Trigger lazy init for the overlay's GraphCanvas
      overlay.querySelectorAll("[data-is-mini]").forEach(c =>
        c.dispatchEvent(new CustomEvent("graph:show"))
      );
    };
    const close = () => {
      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
      document.body.style.overflow = "";
    };

    expandBtn.addEventListener("click", open);
    closeBtn.addEventListener("click", close);
    backdrop.addEventListener("click", close);
    document.addEventListener("keydown", e => { if (e.key === "Escape") close(); });
  }

  initGraphOverlay();
  document.addEventListener("astro:after-swap", initGraphOverlay);

  function initShareButton() {
    const btn = document.getElementById("share-btn");
    if (!btn) return;
    btn.addEventListener("click", async () => {
      if (navigator.share) {
        await navigator.share({ title: document.title, url: location.href });
      } else {
        await navigator.clipboard.writeText(location.href);
        const label = btn.querySelector("span") as HTMLElement | null;
        if (label) {
          const orig = label.textContent;
          label.textContent = "Copied!";
          setTimeout(() => { label.textContent = orig; }, 1500);
        }
      }
    });
  }
  initShareButton();
  document.addEventListener("astro:after-swap", initShareButton);
</script>

<script>
  // ── Pin button ───────────────────────────────────────────────
  function initPinButton() {
    const btn = document.getElementById("pin-btn") as HTMLButtonElement | null;
    if (!btn) return;

    const { postId, title, url, category } = btn.dataset as Record<string, string>;
    const label = document.getElementById("pin-btn-label");
    const icon = document.getElementById("pin-icon");

    function getPinned(): { id: string; title: string; url: string; category: string }[] {
      try { return JSON.parse(localStorage.getItem("jb:pinned") ?? "[]"); } catch { return []; }
    }
    function setPinned(list: typeof pinned) {
      localStorage.setItem("jb:pinned", JSON.stringify(list));
    }

    let pinned = getPinned();

    function syncUI() {
      const isPinned = pinned.some(p => p.id === postId);
      if (label) label.textContent = isPinned ? "Pinned" : "Pin";
      if (icon) icon.setAttribute("fill", isPinned ? "currentColor" : "none");
      btn.style.color = isPinned ? "var(--accent)" : "";
    }

    syncUI();

    btn.addEventListener("click", () => {
      pinned = getPinned();
      const idx = pinned.findIndex(p => p.id === postId);
      if (idx >= 0) {
        pinned.splice(idx, 1);
      } else {
        pinned.push({ id: postId, title, url, category });
      }
      setPinned(pinned);
      syncUI();
    });
  }

  // ── Now Reading button (books only) ──────────────────────────
  function initNowReadingButton() {
    const btn = document.getElementById("now-reading-btn") as HTMLButtonElement | null;
    if (!btn) return;

    const { postId, title, author } = btn.dataset as Record<string, string>;
    const label = document.getElementById("now-reading-btn-label");

    function getCurrent(): { postId: string; progress: number } | null {
      try { return JSON.parse(localStorage.getItem("jb:now-reading") ?? "null"); } catch { return null; }
    }

    function syncUI() {
      const cur = getCurrent();
      const isActive = cur?.postId === postId;
      if (label) label.textContent = isActive ? `읽는 중 (${cur!.progress}%)` : "읽는 중";
      btn.style.color = isActive ? "var(--accent)" : "";
    }

    syncUI();

    btn.addEventListener("click", () => {
      const cur = getCurrent();
      if (cur?.postId === postId) {
        // 이미 설정된 경우 → 진행도 업데이트 프롬프트
        const input = prompt("읽은 진행도를 입력하세요 (0-100):", String(cur.progress));
        if (input === null) return;
        const pct = Math.min(100, Math.max(0, parseInt(input, 10) || 0));
        localStorage.setItem("jb:now-reading", JSON.stringify({ postId, title, author, progress: pct }));
      } else {
        const input = prompt("읽은 진행도를 입력하세요 (0-100):", "0");
        if (input === null) return;
        const pct = Math.min(100, Math.max(0, parseInt(input, 10) || 0));
        localStorage.setItem("jb:now-reading", JSON.stringify({ postId, title, author, progress: pct }));
      }
      syncUI();
    });
  }

  initPinButton();
  initNowReadingButton();
  document.addEventListener("astro:after-swap", () => {
    initPinButton();
    initNowReadingButton();
  });
</script>

<script is:inline data-astro-rerun>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-20 h-0.5 w-full";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline hidden md:inline md:opacity-0 md:group-hover:opacity-75 md:focus:opacity-75";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      // Check if --file-name-offset custom property exists
      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      // Determine the top positioning class
      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
      copyButton.textContent = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );
</script>
