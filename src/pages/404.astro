---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout flex flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-start">
      <p class="text-sm text-foreground/40 mb-4">404</p>
      <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
        Page not found
      </h1>
      <p class="mt-3 text-foreground/60">
        This page doesn't exist or has been moved.
      </p>
      <LinkButton
        href="/"
        class="mt-8 text-sm text-foreground/50 hover:text-accent transition-colors"
      >
        ← Back to home
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
