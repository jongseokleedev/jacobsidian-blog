---
import { getCollection } from "astro:content";
import BlogShell from "@/layouts/BlogShell.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getCategoryMeta, PARENTS } from "@/utils/getCategories";
import { getSeriesSlug } from "@/utils/getSeriesSlug";

export async function getStaticPaths() {
  return Object.entries(PARENTS).flatMap(([parent, pm]) =>
    Object.keys(pm.subs).map(sub => ({ params: { parent, sub } }))
  );
}

const { parent, sub } = Astro.params;
const catKey = `${parent}-${sub}`;
const meta = getCategoryMeta(catKey)!;

const all = await getCollection("posts", ({ data }) => data.category === catKey && !data.draft);
const posts = getSortedPosts(all);

// Group series posts into single display items
type PostItem = { kind: "post"; post: (typeof posts)[number] };
type SeriesItem = {
  kind: "series";
  name: string;
  slug: string;
  chapters: (typeof posts)[number][];
  latestDate: Date;
};
type DisplayItem = PostItem | SeriesItem;

const seriesMap = new Map<string, (typeof posts)[number][]>();
const displayItems: DisplayItem[] = [];
const seenSeries = new Set<string>();

for (const post of posts) {
  if (post.data.series) {
    const arr = seriesMap.get(post.data.series) ?? [];
    arr.push(post);
    seriesMap.set(post.data.series, arr);
  }
}

for (const post of posts) {
  if (!post.data.series) {
    displayItems.push({ kind: "post", post });
  } else if (!seenSeries.has(post.data.series)) {
    seenSeries.add(post.data.series);
    const chapters = (seriesMap.get(post.data.series) ?? []).sort(
      (a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0)
    );
    displayItems.push({
      kind: "series",
      name: post.data.series,
      slug: await getSeriesSlug(post.data.series),
      chapters,
      latestDate: new Date(post.data.pubDatetime),
    });
  }
}
---

<BlogShell mode="discovery" rail="category" activeCategory={catKey} title={meta.label}>
  <header class="mb-6">
    <div class="flex items-center gap-2 mb-1">
      <span class="cat-dot" style={`background:${meta.color}`} />
      <p class="bd-overline">Category</p>
    </div>
    <h1 class="text-[28px] font-bold tracking-[-0.02em]">{meta.label}</h1>
    <p class="mt-1 text-[15px]" style="color: var(--fg-mute);">{meta.desc}</p>
  </header>

  {meta.topics.length > 0 && (
    <div id="topic-filter-row" class="flex gap-2 flex-wrap py-3 mb-4 border-b border-border overflow-x-auto">
      <button
        class="topic-pill cat-filter-pill active-pill rounded-full border border-border px-3 py-1 text-[12.5px] transition-all hover:border-accent hover:text-accent"
        data-topic="all"
      >
        모두 보기
      </button>
      {meta.topics.map(t => (
        <button
          class="topic-pill cat-filter-pill rounded-full border border-border px-3 py-1 text-[12.5px] transition-all hover:border-accent hover:text-accent"
          data-topic={t.key}
        >
          {t.label}
        </button>
      ))}
    </div>
  )}

  {displayItems.length > 0 ? (
    <section>
      <ul id="post-list" class="archives-list">
        {displayItems.map((item, i) => (
          <li data-tags={JSON.stringify(item.kind === "post" ? (item.post.data.tags ?? []) : ["series"])} class={i >= 10 ? "hidden" : ""}>
            {item.kind === "post" ? (
              <a
                href={`/${parent}/${sub}/${item.post.id.split("/").pop()}`}
                class="group post-grid-home py-[10px] border-b transition-colors duration-150 hover:text-accent"
                style="border-color: var(--border-soft);"
              >
                <div class="flex items-center justify-between sm:contents">
                  <span class="font-mono text-[11px] tabular-nums whitespace-nowrap" style="color: var(--fg-faint);">
                    {new Date(item.post.data.pubDatetime).toLocaleDateString("ko-KR", { year: "numeric", month: "2-digit", day: "2-digit" })}
                  </span>
                </div>
                <span class="font-medium text-[14px] sm:truncate self-center inline-flex items-center gap-2 transition-transform duration-150 group-hover:translate-x-[3px]">
                  <span class="cat-dot shrink-0" style={`background: ${meta.color}`} />
                  {item.post.data.title}
                </span>
                <span class="hidden sm:block" />
              </a>
            ) : (
              <a
                href={`/series/${item.slug}`}
                class="group post-grid-home py-[10px] border-b transition-colors duration-150 hover:text-accent"
                style="border-color: var(--border-soft);"
              >
                <div class="flex items-center justify-between sm:contents">
                  <span class="font-mono text-[11px] tabular-nums whitespace-nowrap" style="color: var(--fg-faint);">
                    {item.latestDate.toLocaleDateString("ko-KR", { year: "numeric", month: "2-digit", day: "2-digit" })}
                  </span>
                </div>
                <span class="font-medium text-[14px] sm:truncate self-center inline-flex items-center gap-2 transition-transform duration-150 group-hover:translate-x-[3px]">
                  <span class="text-[10px] font-mono px-1.5 py-0.5 rounded border" style={`color: ${meta.color}; border-color: ${meta.color}; opacity: 0.8;`}>
                    연재
                  </span>
                  {item.name}
                </span>
                <span class="hidden sm:block text-[12px] tabular-nums" style="color: var(--fg-faint);">
                  {item.chapters.length}화
                </span>
              </a>
            )}
          </li>
        ))}
      </ul>
      <div id="load-sentinel" class="mt-4 flex justify-center" aria-hidden="true">
        <div id="load-spinner" class="hidden h-4 w-4 rounded-full border-2 border-border border-t-accent animate-spin"></div>
      </div>
    </section>
  ) : (
    <p class="pt-12 text-sm text-foreground/40 text-center">아직 글이 없습니다.</p>
  )}

  <script>
    document.addEventListener("astro:page-load", () => {
      const pills = Array.from(document.querySelectorAll<HTMLButtonElement>(".topic-pill"));
      const items = Array.from(document.querySelectorAll<HTMLElement>("#post-list li[data-tags]"));
      const sentinel = document.getElementById("load-sentinel");
      const spinner = document.getElementById("load-spinner");

      const PAGE = 10;
      let activeFilter = "all";
      let shown = PAGE;
      let loading = false;
      let observer: IntersectionObserver | null = null;

      function filteredItems() {
        return items.filter(el => {
          if (activeFilter === "all") return true;
          const tags: string[] = JSON.parse(el.dataset.tags ?? "[]");
          return tags.includes(activeFilter);
        });
      }

      function showItems() {
        const toShow = filteredItems().slice(0, shown);
        const toShowSet = new Set(toShow);
        items.forEach(el => {
          if (el.style.display !== "none" && !toShowSet.has(el)) {
            el.style.transition = "opacity 100ms ease";
            el.style.opacity = "0";
          }
        });
        setTimeout(() => {
          items.forEach(el => {
            el.classList.remove("hidden");
            el.style.display = "none";
            el.style.opacity = "0";
            el.style.transition = "";
          });
          toShow.forEach((el, i) => {
            el.style.display = "";
            requestAnimationFrame(() => {
              setTimeout(() => {
                el.style.transition = "opacity 150ms ease";
                el.style.opacity = "1";
              }, i * 18);
            });
          });
        }, 110);
      }

      function appendItems(prevShown: number) {
        filteredItems().slice(prevShown, shown).forEach((el, i) => {
          el.classList.remove("hidden");
          el.style.display = "";
          el.style.opacity = "0";
          el.style.transition = "";
          requestAnimationFrame(() => {
            setTimeout(() => {
              el.style.transition = "opacity 150ms ease";
              el.style.opacity = "1";
            }, i * 18);
          });
        });
      }

      function loadMore() {
        const total = filteredItems().length;
        if (loading || shown >= total) return;
        loading = true;
        spinner?.classList.remove("hidden");
        const prev = shown;
        shown = Math.min(shown + PAGE, total);
        setTimeout(() => {
          appendItems(prev);
          loading = false;
          spinner?.classList.add("hidden");
          setupObserver();
        }, 400);
      }

      function setupObserver() {
        observer?.disconnect();
        if (!sentinel) return;
        observer = new IntersectionObserver(
          entries => { if (entries[0].isIntersecting) loadMore(); },
          { rootMargin: "0px", threshold: 0 }
        );
        observer.observe(sentinel);
      }

      function applyFilter(key: string) {
        activeFilter = key;
        shown = PAGE;
        showItems();
        pills.forEach(p => p.classList.toggle("active-pill", p.dataset.topic === key));
        setTimeout(setupObserver, 120);
      }

      if (pills.length) {
        pills.forEach(p => p.addEventListener("click", () => applyFilter(p.dataset.topic ?? "all")));
      }
      setupObserver();
    });
  </script>
</BlogShell>
