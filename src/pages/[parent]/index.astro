---
import { getCollection } from "astro:content";
import BlogShell from "@/layouts/BlogShell.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { PARENTS } from "@/utils/getCategories";
import { slugifyStr } from "@/utils/slugify";

export async function getStaticPaths() {
  return Object.keys(PARENTS).map(parent => ({ params: { parent } }));
}

const { parent } = Astro.params;
const parentMeta = PARENTS[parent]!;

const all = await getCollection("posts", ({ data }) =>
  data.category.startsWith(`${parent}-`) && !data.draft
);
const posts = getSortedPosts(all);
const subKeys = Object.keys(parentMeta.subs);

const subCounts = posts.reduce<Record<string, number>>((acc, p) => {
  acc[p.data.category] = (acc[p.data.category] ?? 0) + 1;
  return acc;
}, {});
---

<BlogShell mode="discovery" rail="category" activeCategory={parent} title={parentMeta.label}>
  <header class="mb-6">
    <div class="flex items-center gap-2 mb-1">
      <span class="cat-dot" style={`background:${parentMeta.color}`} />
      <p class="bd-overline">Category</p>
    </div>
    <h1 class="text-[28px] font-bold tracking-[-0.02em]">{parentMeta.label}</h1>
  </header>

  <!-- Sub-category filter tabs -->
  <div id="sub-filter-row" class="flex gap-2 flex-wrap py-3 mb-4 border-b border-border overflow-x-auto">
    <button
      class="sub-filter-pill active-pill flex items-center gap-1.5 rounded-full border border-border px-3 py-1 text-[12.5px] transition-all hover:border-accent hover:text-accent"
      data-sub="all"
    >
      All
      <span class="font-mono text-[11px] opacity-50">{posts.length}</span>
    </button>
    {subKeys.map(subKey => {
      const count = subCounts[`${parent}-${subKey}`] ?? 0;
      return (
        <button
          class="sub-filter-pill flex items-center gap-1.5 rounded-full border border-border px-3 py-1 text-[12.5px] transition-all hover:border-accent hover:text-accent"
          data-sub={`${parent}-${subKey}`}
        >
          {parentMeta.subs[subKey].label}
          {count > 0 && <span class="font-mono text-[11px] opacity-50">{count}</span>}
        </button>
      );
    })}
  </div>

  {posts.length > 0 ? (
    <section>
      <ul id="post-list" class="archives-list">
        {posts.map(({ data, id }, i) => {
          const [, sub] = data.category.split("-");
          const subMeta = parentMeta.subs[sub];
          return (
            <li data-category={data.category} class={i >= 10 ? "hidden" : ""}>
              <a
                href={`/${parent}/${sub}/${slugifyStr(id.split("/").pop() ?? id)}`}
                class="group post-grid-home py-[10px] border-b transition-colors duration-150 hover:text-accent"
                style="border-color: var(--border-soft);"
              >
                <div class="flex items-center justify-between sm:contents">
                  <span class="font-mono text-[11px] tabular-nums whitespace-nowrap" style="color: var(--fg-faint);">
                    {new Date(data.pubDatetime).toLocaleDateString("ko-KR", { year: "numeric", month: "2-digit", day: "2-digit" })}
                  </span>
                  <span class="font-mono text-[11px] sm:hidden" style="color: var(--fg-faint);">
                    {subMeta?.label}
                  </span>
                </div>
                <span class="font-medium text-[14px] sm:truncate self-center inline-flex items-center gap-2 transition-transform duration-150 group-hover:translate-x-[3px]">
                  <span class="cat-dot shrink-0" style={`background: ${parentMeta.color}`} />
                  {data.title}
                </span>
                <span class="hidden sm:block font-mono text-[11px] self-center text-right" style="color: var(--fg-faint);">
                  {subMeta?.label}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
      <div id="load-sentinel" class="mt-4 flex justify-center" aria-hidden="true">
        <div id="load-spinner" class="hidden h-4 w-4 rounded-full border-2 border-border border-t-accent animate-spin"></div>
      </div>
    </section>
  ) : (
    <p class="pt-12 text-sm text-foreground/40 text-center">아직 글이 없습니다.</p>
  )}

  <script>
    document.addEventListener("astro:page-load", () => {
      const pills = Array.from(document.querySelectorAll<HTMLButtonElement>(".sub-filter-pill"));
      const items = Array.from(document.querySelectorAll<HTMLElement>("#post-list li[data-category]"));
      const sentinel = document.getElementById("load-sentinel");
      const spinner = document.getElementById("load-spinner");

      const PAGE = 10;
      let activeFilter = "all";
      let shown = PAGE;
      let loading = false;
      let observer: IntersectionObserver | null = null;

      function filteredItems() {
        return items.filter(el => activeFilter === "all" || el.dataset.category === activeFilter);
      }

      function showItems() {
        const toShow = filteredItems().slice(0, shown);
        const toShowSet = new Set(toShow);
        items.forEach(el => {
          if (el.style.display !== "none" && !toShowSet.has(el)) {
            el.style.transition = "opacity 100ms ease";
            el.style.opacity = "0";
          }
        });
        setTimeout(() => {
          items.forEach(el => {
            el.classList.remove("hidden");
            el.style.display = "none";
            el.style.opacity = "0";
            el.style.transition = "";
          });
          toShow.forEach((el, i) => {
            el.style.display = "";
            requestAnimationFrame(() => {
              setTimeout(() => {
                el.style.transition = "opacity 150ms ease";
                el.style.opacity = "1";
              }, i * 18);
            });
          });
        }, 110);
      }

      function appendItems(prevShown: number) {
        filteredItems().slice(prevShown, shown).forEach((el, i) => {
          el.classList.remove("hidden");
          el.style.display = "";
          el.style.opacity = "0";
          el.style.transition = "";
          requestAnimationFrame(() => {
            setTimeout(() => {
              el.style.transition = "opacity 150ms ease";
              el.style.opacity = "1";
            }, i * 18);
          });
        });
      }

      function loadMore() {
        const total = filteredItems().length;
        if (loading || shown >= total) return;
        loading = true;
        spinner?.classList.remove("hidden");
        const prev = shown;
        shown = Math.min(shown + PAGE, total);
        setTimeout(() => {
          appendItems(prev);
          loading = false;
          spinner?.classList.add("hidden");
          // Re-observe so the observer fires again if sentinel is still visible
          setupObserver();
        }, 400);
      }

      function setupObserver() {
        observer?.disconnect();
        if (!sentinel) return;
        observer = new IntersectionObserver(
          entries => { if (entries[0].isIntersecting) loadMore(); },
          { rootMargin: "0px", threshold: 0 }
        );
        observer.observe(sentinel);
      }

      function applyFilter(key: string) {
        activeFilter = key;
        shown = PAGE;
        showItems();
        pills.forEach(p => p.classList.toggle("active-pill", p.dataset.sub === key));
      }

      pills.forEach(p => p.addEventListener("click", () => applyFilter(p.dataset.sub ?? "all")));
      setupObserver();
    });
  </script>
</BlogShell>
