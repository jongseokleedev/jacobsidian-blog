---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { SITE } from "@/config";

if (!SITE.showArchives) {
  return Astro.redirect("/404");
}

const all = await getCollection("posts", ({ data }) => !data.draft);
const posts = getSortedPosts(all);

const categoryLabel: Record<string, string> = {
  thought: "Thoughts",
  writing: "Writing",
  tech: "Tech",
};
---

<Layout title={`모든 글 | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout pt-12 pb-16">
    <section class="pb-10 border-b border-border">
      <h1 class="text-2xl font-semibold tracking-tight mb-1">모든 글</h1>
      <p class="text-sm text-foreground/60">{posts.length}개의 글</p>
    </section>

    <section class="pt-8">
      <ul class="divide-y divide-border">
        {posts.map(post => (
          <li>
            <a
              href={getPath(post)}
              class="group post-grid-home py-4 transition-colors duration-150 hover:text-accent"
            >
              <span class="text-xs text-foreground/40 tabular-nums self-center">
                {new Date(post.data.pubDatetime).toLocaleDateString("ko-KR", {
                  year: "numeric",
                  month: "2-digit",
                  day: "2-digit",
                })}
              </span>
              <span class="font-medium truncate self-center transition-transform duration-150 group-hover:translate-x-1">
                {post.data.title}
              </span>
              <span class="text-xs text-foreground/40 self-center text-right">
                {categoryLabel[post.data.category] ?? post.data.category}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
