---
import { type CollectionEntry, getCollection } from "astro:content";
import PostDetails from "@/layouts/PostDetails.astro";
import { slugifyStr } from "@/utils/slugify";

export async function getStaticPaths() {
  const books = await getCollection("books", ({ data }) => !data.draft);
  return books.map(book => ({
    params: { slug: slugifyStr(book.id.split("/").pop() ?? book.id) },
    props: { post: book },
  }));
}

type Props = { post: CollectionEntry<"books"> };
const { post } = Astro.props;

const all = await getCollection("books", ({ data }) => !data.draft);
const sortedBooks = all.sort(
  (a, b) =>
    new Date(b.data.modDatetime ?? b.data.pubDatetime).getTime() -
    new Date(a.data.modDatetime ?? a.data.pubDatetime).getTime()
);
---

<PostDetails post={post} posts={sortedBooks} />
