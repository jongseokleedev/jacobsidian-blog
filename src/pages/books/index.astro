---
import { getCollection } from "astro:content";
import BlogShell from "@/layouts/BlogShell.astro";
import BookCard from "@/components/BookCard.astro";
import { getCategoryMeta } from "@/utils/getCategories";

const catKey = "book";
const meta = getCategoryMeta(catKey)!;

const rawBooks = await getCollection("posts");
const all = rawBooks.filter(p => p.data.category === "book" && !p.data.draft);
const books = all.sort(
  (a, b) =>
    new Date(b.data.modDatetime ?? b.data.pubDatetime).getTime() -
    new Date(a.data.modDatetime ?? a.data.pubDatetime).getTime()
);
---

<BlogShell mode="discovery" rail="category" activeCategory={catKey} title={meta.label}>
  <header class="mb-6">
    <div class="flex items-center gap-2 mb-1">
      <span class="cat-dot" style={`background:${meta.color}`} />
      <p class="bd-overline">Category</p>
    </div>
    <h1 class="text-[28px] font-bold tracking-[-0.02em]">{meta.label}</h1>
    <p class="mt-1 text-[15px]" style="color: var(--fg-mute);">{meta.desc}</p>
  </header>

  <ul class:list={["grid gap-4", books.length === 1 ? "grid-cols-1 max-w-[200px]" : "grid-cols-2 sm:grid-cols-3 md:grid-cols-4"]}>
    {books.map(entry => <BookCard {...entry} />)}
  </ul>
</BlogShell>
