---
import { getCollection } from "astro:content";
import BlogShell from "@/layouts/BlogShell.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getCategoryMeta, PARENTS } from "@/utils/getCategories";
import { slugifyStr } from "@/utils/slugify";
import { EN_CATEGORIES } from "@/config";

export async function getStaticPaths() {
  return Object.entries(PARENTS).flatMap(([parent, pm]) =>
    Object.keys(pm.subs)
      .filter(sub => EN_CATEGORIES.has(`${parent}-${sub}` as never))
      .map(sub => ({ params: { parent, sub } }))
  );
}

const { parent, sub } = Astro.params;
const catKey = `${parent}-${sub}`;
const meta = getCategoryMeta(catKey)!;

const allKo = await getCollection("posts", ({ data }) =>
  data.category === catKey && !data.draft && data.lang !== "en"
);
const allEn = await getCollection("posts", ({ data }) =>
  data.category === catKey && !data.draft && data.lang === "en"
);
const enById = new Map(allEn.map(p => [p.id.replace(/\.en$/, ""), p]));

const posts = getSortedPosts(allKo);
---

<BlogShell mode="discovery" rail="category" activeCategory={catKey} title={`${meta.label} | jacobsidian`}>
  <header class="mb-6">
    <div class="flex items-center gap-2 mb-1">
      <span class="cat-dot" style={`background:${meta.color}`} />
      <p class="bd-overline">Category</p>
    </div>
    <h1 class="text-[28px] font-bold tracking-[-0.02em]">{meta.label}</h1>
    <p class="mt-1 text-[15px]" style="color: var(--fg-mute);">{meta.desc}</p>
  </header>

  {posts.length > 0 ? (
    <section>
      <ul id="post-list" class="archives-list">
        {posts.map(({ data, id }, i) => {
          const enPost = enById.get(id);
          const slug = slugifyStr(id.split("/").pop() ?? id);
          return (
            <li class={i >= 10 ? "hidden" : ""}>
              <a
                href={`/en/${parent}/${sub}/${slug}`}
                class="group post-grid-home py-[10px] border-b transition-colors duration-150 hover:text-accent"
                style="border-color: var(--border-soft);"
              >
                <div class="flex items-center justify-between sm:contents">
                  <span class="font-mono text-[11px] tabular-nums whitespace-nowrap" style="color: var(--fg-faint);">
                    {new Date(data.pubDatetime).toLocaleDateString("en-US", { year: "numeric", month: "2-digit", day: "2-digit" })}
                  </span>
                </div>
                <span class="font-medium text-[14px] sm:truncate self-center inline-flex items-center gap-2 transition-transform duration-150 group-hover:translate-x-[3px]">
                  <span class="cat-dot shrink-0" style={`background: ${meta.color}`} />
                  {enPost ? enPost.data.title : data.title}
                  {!enPost && <span class="text-[11px] font-mono shrink-0" style="color: var(--fg-faint);">[KO]</span>}
                </span>
                <span class="hidden sm:block" />
              </a>
            </li>
          );
        })}
      </ul>
      <div id="load-sentinel" class="mt-4 flex justify-center" aria-hidden="true">
        <div id="load-spinner" class="hidden h-4 w-4 rounded-full border-2 border-border border-t-accent animate-spin"></div>
      </div>
    </section>
  ) : (
    <p class="pt-12 text-sm text-foreground/40 text-center">No posts yet.</p>
  )}

  <script>
    document.addEventListener("astro:page-load", () => {
      const sentinel = document.getElementById("load-sentinel");
      const spinner = document.getElementById("load-spinner");
      const items = Array.from(document.querySelectorAll<HTMLElement>("#post-list li"));
      const PAGE = 10;
      let shown = PAGE;
      let loading = false;
      let observer: IntersectionObserver | null = null;
      function loadMore() {
        const remaining = items.slice(shown);
        if (loading || !remaining.length) return;
        loading = true;
        spinner?.classList.remove("hidden");
        const batch = remaining.slice(0, PAGE);
        shown += batch.length;
        setTimeout(() => {
          batch.forEach((el, i) => { el.classList.remove("hidden"); el.style.display = ""; el.style.opacity = "0"; requestAnimationFrame(() => { setTimeout(() => { el.style.transition = "opacity 150ms ease"; el.style.opacity = "1"; }, i * 18); }); });
          loading = false;
          spinner?.classList.add("hidden");
          setupObserver();
        }, 400);
      }
      function setupObserver() {
        observer?.disconnect();
        if (!sentinel) return;
        observer = new IntersectionObserver(entries => { if (entries[0].isIntersecting) loadMore(); }, { rootMargin: "0px", threshold: 0 });
        observer.observe(sentinel);
      }
      setupObserver();
    });
  </script>
</BlogShell>
