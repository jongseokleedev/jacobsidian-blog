---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import GraphCanvas from "@/components/GraphCanvas.astro";
import { SITE } from "@/config";
---

<Layout title={`Graph | ${SITE.title}`} description="노트 간 연결 그래프">
  <Header />
  <main id="main-content" class="app-layout pt-12 pb-16">
    <section class="pb-10 border-b border-border">
      <h1 class="text-2xl font-semibold tracking-tight mb-1">Graph</h1>
      <p class="text-sm text-foreground/60">노트 간 연결 지도</p>
    </section>
    <section class="pt-8">
      <div class="rounded-lg border border-border overflow-hidden">
        <GraphCanvas height={600} />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
