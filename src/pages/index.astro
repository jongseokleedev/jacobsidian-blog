---
import { getCollection } from "astro:content";
import BlogShell from "@/layouts/BlogShell.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { PARENTS, getCategoryMeta, parseCategory } from "@/utils/getCategories";
import GraphCanvas from "@/components/GraphCanvas.astro";
import FeaturedCard from "@/components/FeaturedCard.astro";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const posts = getSortedPosts(allPosts);

const allItems = posts.map(p => ({
  href: getPath(p),
  date: new Date(p.data.pubDatetime),
  title: p.data.title,
  category: p.data.category,
  label: getCategoryMeta(p.data.category)?.label ?? p.data.category,
  color: getCategoryMeta(p.data.category)?.color ?? "var(--fg-faint)",
}));

const total = allItems.length;

const parentCounts = allItems.reduce<Record<string, number>>((acc, item) => {
  const { parent } = parseCategory(item.category);
  acc[parent] = (acc[parent] ?? 0) + 1;
  return acc;
}, {});

function extractFirstImage(body: string): string | null {
  const m = body.match(/!\[.*?\]\((https?:\/\/[^)]+)\)/);
  return m ? m[1] : null;
}

// Featured: top 3 posts by graph connection score
const scoredPosts = posts.map(post => {
  const outgoing = post.data.links?.length ?? 0;
  const postBasename = post.id.split("/").pop()?.replace(/\.md$/, "") ?? post.id;
  const incoming = posts.filter(other =>
    other.id !== post.id &&
    (other.data.links ?? []).some(
      l => l === postBasename || l === post.data.title
    )
  ).length;
  return { post, score: outgoing + incoming };
});
scoredPosts.sort((a, b) => b.score - a.score);
const topPosts = scoredPosts.slice(0, 3).map(({ post }) => ({
  href: getPath(post),
  ogSrc: getPath(post) + "og.png",
  poster: post.data.poster ?? extractFirstImage(post.body ?? "") ?? null,
  title: post.data.title,
  description: post.data.description,
  date: new Date(post.data.pubDatetime),
  category: post.data.category,
  label: getCategoryMeta(post.data.category)?.label ?? post.data.category,
  color: getCategoryMeta(post.data.category)?.color ?? "var(--fg-faint)",
}));

// Featured: latest 1 post per unique parent category, max 3
const seenParents = new Set<string>();
const latestPosts = posts
  .filter(post => {
    const { parent } = parseCategory(post.data.category);
    if (seenParents.has(parent)) return false;
    seenParents.add(parent);
    return true;
  })
  .slice(0, 3)
  .map(post => ({
    href: getPath(post),
    ogSrc: getPath(post) + "og.png",
    poster: post.data.poster ?? extractFirstImage(post.body ?? "") ?? null,
    title: post.data.title,
    description: post.data.description,
    date: new Date(post.data.pubDatetime),
    category: post.data.category,
    label: getCategoryMeta(post.data.category)?.label ?? post.data.category,
    color: getCategoryMeta(post.data.category)?.color ?? "var(--fg-faint)",
  }));
---

<BlogShell mode="discovery" rail="discovery" activePage="home" data-layout="index">
  <!-- Hero: ASCII + Filter + Graph -->
  <section class="pb-10 border-b border-border">
    <div class="overflow-x-hidden mb-6">
      <pre class="text-[1.15vw] leading-[1.2] sm:text-[0.6rem] md:text-[0.7rem] font-mono select-none ascii-gradient" aria-hidden="true">     ██╗ █████╗  ██████╗ ██████╗ ██████╗ ███████╗██╗██████╗ ██╗ █████╗ ███╗   ██╗
     ██║██╔══██╗██╔════╝██╔═══██╗██╔══██╗██╔════╝██║██╔══██╗██║██╔══██╗████╗  ██║
     ██║███████║██║     ██║   ██║██████╔╝███████╗██║██║  ██║██║███████║██╔██╗ ██║
██   ██║██╔══██║██║     ██║   ██║██╔══██╗╚════██║██║██║  ██║██║██╔══██║██║╚██╗██║
╚█████╔╝██║  ██║╚██████╗╚██████╔╝██████╔╝███████║██║██████╔╝██║██║  ██║██║ ╚████║
 ╚════╝ ╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚═════╝ ╚══════╝╚═╝╚═════╝ ╚═╝╚═╝  ╚═╝╚═╝  ╚═══╝</pre>
    </div>
    <h1 class="sr-only">jacobsidian</h1>

    <!-- Category filter pills — unified filter for graph + archives -->
    <div id="cat-filter-row" class="flex gap-2 overflow-x-auto py-2 mb-3 scrollbar-none" style="scrollbar-width:none;">
      <button
        class="cat-filter-pill shrink-0 flex items-center gap-1.5 rounded-full border border-border px-3 py-1 text-[13px] transition-all hover:border-accent hover:text-accent active-pill"
        data-cat="all"
      >
        All
        <span class="font-mono text-[11px] opacity-50">{total}</span>
      </button>
      {Object.entries(PARENTS).map(([parentKey, parentMeta]) => (
        <button
          class="cat-filter-pill shrink-0 flex items-center gap-1.5 rounded-full border border-border px-3 py-1 text-[13px] transition-all hover:border-accent hover:text-accent"
          data-cat={parentKey}
          style={`--pill-color:${parentMeta.color}`}
        >
          <span class="cat-dot shrink-0" style={`background:${parentMeta.color}`} />
          {parentMeta.label}
          <span class="font-mono text-[11px] opacity-50">{parentCounts[parentKey] ?? 0}</span>
        </button>
      ))}
    </div>

    <div class="rounded-lg border border-border overflow-hidden">
      <GraphCanvas height={340} />
    </div>
  </section>


  <!-- Featured -->
  <section class="py-10 border-b border-border">
    <div class="flex items-end justify-between mb-5">
      <div>
        <div class="bd-overline mb-1">Curated</div>
        <h2 class="text-base font-semibold tracking-tight">Featured</h2>
      </div>
      <div class="flex gap-2">
        <button
          class="featured-tab active-tab shrink-0 rounded-full border border-border px-3 py-1 text-[13px] transition-all hover:border-accent hover:text-accent"
          data-tab="core"
        >Core</button>
        <button
          class="featured-tab shrink-0 rounded-full border border-border px-3 py-1 text-[13px] transition-all hover:border-accent hover:text-accent"
          data-tab="latest"
        >Latest</button>
      </div>
    </div>

    <!-- Core panel -->
    <div id="featured-core" class="featured-panel">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 items-stretch">
        {topPosts.map((item, i) => <FeaturedCard item={item} index={i} />)}
      </div>
    </div>

    <!-- Latest panel -->
    <div id="featured-latest" class="featured-panel hidden">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 items-stretch">
        {latestPosts.map((item, i) => <FeaturedCard item={item} index={i} />)}
      </div>
    </div>
  </section>

  <!-- Archives -->
  {allItems.length > 0 && (
    <section>
      <div class="flex items-baseline justify-between mb-3">
        <div>
          <div class="bd-overline mb-1">Latest</div>
          <h2 class="text-base font-semibold tracking-tight">Archives</h2>
        </div>
        <span id="archives-count" class="font-mono text-[11px]" style="color: var(--fg-faint);">{total} records</span>
      </div>

      <ul id="post-list" class="archives-list">
        {allItems.map((item, i) => (
          <li data-index={i} data-category={item.category} class={i >= 10 ? "hidden" : ""}>
            <a
              href={item.href}
              class="group post-grid-home py-[10px] border-b transition-colors duration-150 hover:text-accent"
              style="border-color: var(--border-soft);"
            >
              <!-- 모바일: 1행 (날짜 + 카테고리), 데스크탑: 날짜 컬럼 -->
              <div class="flex items-center justify-between sm:contents">
                <span class="font-mono text-[11px] tabular-nums whitespace-nowrap" style="color: var(--fg-faint);">
                  {item.date.toLocaleDateString("ko-KR", {
                    year: "numeric",
                    month: "2-digit",
                    day: "2-digit",
                  })}
                </span>
                <span class="font-mono text-[11px] sm:hidden" style="color: var(--fg-faint);">
                  {item.label}
                </span>
              </div>
              <!-- 제목 (모바일: 2행 전체 너비, 데스크탑: 중간 컬럼) -->
              <span class="font-medium text-[14px] sm:truncate self-center inline-flex items-center gap-2 transition-transform duration-150 group-hover:translate-x-[3px]">
                <span class="cat-dot shrink-0" style={`background: ${item.color}`} />
                {item.title}
              </span>
              <!-- 카테고리 레이블: 데스크탑에서만 표시 -->
              <span class="hidden sm:block font-mono text-[11px] self-center text-right" style="color: var(--fg-faint);">
                {item.label}
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div id="load-sentinel" class="mt-4 flex justify-center" aria-hidden="true">
        <div id="load-spinner" class="hidden h-4 w-4 rounded-full border-2 border-border border-t-accent animate-spin"></div>
      </div>
    </section>
  )}
</BlogShell>

<style>
  .ascii-gradient {
    background: linear-gradient(90deg, var(--foreground) 0%, #7c3aed 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .cat-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    display: inline-block;
  }
  .active-pill {
    border-color: var(--accent);
    color: var(--accent);
  }
  .active-tab {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>

<script>
  function initCatFilter() {
    const pills = document.querySelectorAll<HTMLButtonElement>(".cat-filter-pill");
    const items = document.querySelectorAll<HTMLElement>("#post-list li[data-index]");
    const sentinel = document.getElementById("load-sentinel");

    if (!pills.length) return;

    const PAGE = 10;
    let activeFilter = "all";
    let shown = PAGE;
    let loading = false;
    let observer: IntersectionObserver | null = null;

    const spinner = document.getElementById("load-spinner");

    function filteredItems() {
      return [...items].filter(el => {
        if (activeFilter === "all") return true;
        const cat = el.dataset.category ?? "";
        return cat === activeFilter || cat.startsWith(`${activeFilter}-`);
      });
    }

    // 필터 변경 시: 전체 재렌더 (fade out → fade in)
    function showItems() {
      const toShow = filteredItems().slice(0, shown);
      const toShowSet = new Set(toShow);

      items.forEach(el => {
        if (el.style.display !== "none" && !toShowSet.has(el)) {
          el.style.transition = "opacity 100ms ease";
          el.style.opacity = "0";
        }
      });

      setTimeout(() => {
        items.forEach(el => {
          el.classList.remove("hidden");
          el.style.display = "none";
          el.style.opacity = "0";
          el.style.transition = "";
        });
        toShow.forEach((el, i) => {
          el.style.display = "";
          requestAnimationFrame(() => {
            setTimeout(() => {
              el.style.transition = "opacity 150ms ease";
              el.style.opacity = "1";
            }, i * 18);
          });
        });
      }, 110);
    }

    // 무한 스크롤 시: 새 항목만 append
    function appendItems(prevShown: number) {
      const next = filteredItems().slice(prevShown, shown);
      next.forEach((el, i) => {
        el.classList.remove("hidden");
        el.style.display = "";
        el.style.opacity = "0";
        el.style.transition = "";
        requestAnimationFrame(() => {
          setTimeout(() => {
            el.style.transition = "opacity 150ms ease";
            el.style.opacity = "1";
          }, i * 18);
        });
      });
    }

    function loadMore() {
      const total = filteredItems().length;
      if (loading || shown >= total) return;
      loading = true;
      spinner?.classList.remove("hidden");
      const prev = shown;
      shown = Math.min(shown + PAGE, total);
      setTimeout(() => {
        appendItems(prev);
        loading = false;
        spinner?.classList.add("hidden");
      }, 400);
    }

    function setupObserver() {
      observer?.disconnect();
      if (!sentinel) return;
      observer = new IntersectionObserver(
        entries => { if (entries[0].isIntersecting) loadMore(); },
        { rootMargin: "0px", threshold: 0 }
      );
      observer.observe(sentinel);
    }

    const countEl = document.getElementById("archives-count");

    function applyFilter(key: string) {
      activeFilter = key;
      shown = PAGE;
      showItems();
      pills.forEach(p => p.classList.toggle("active-pill", p.dataset.cat === key));
      document.dispatchEvent(new CustomEvent("graph:filter", { detail: { category: key } }));

      const cnt = filteredItems().length;
      if (countEl) countEl.textContent = `${cnt} records`;
    }

    pills.forEach(pill => {
      pill.addEventListener("click", () => applyFilter(pill.dataset.cat ?? "all"));
    });

    setupObserver();
    applyFilter("all");
  }

  function initFeaturedTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>(".featured-tab");
    const panels = document.querySelectorAll<HTMLElement>(".featured-panel");
    if (!tabs.length) return;

    tabs.forEach(tab => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.tab;
        tabs.forEach(t => t.classList.toggle("active-tab", t.dataset.tab === target));
        panels.forEach(p => {
          const isTarget = p.id === `featured-${target}`;
          if (isTarget) {
            p.classList.remove("hidden");
            p.style.opacity = "0";
            p.style.transition = "";
            requestAnimationFrame(() => {
              p.style.transition = "opacity 150ms ease";
              p.style.opacity = "1";
            });
          } else {
            p.classList.add("hidden");
            p.style.opacity = "";
            p.style.transition = "";
          }
        });
      });
    });
  }

  function initIndexPage() {
    const mainContent = document.querySelector("#main-content") as HTMLElement | null;
    if (mainContent) {
      sessionStorage.setItem("backUrl", "/");
    }
    initCatFilter();
    initFeaturedTabs();
  }

  document.addEventListener("astro:page-load", initIndexPage);
  document.addEventListener("astro:after-swap", initCatFilter);
</script>
