</BlogShell>

<script>
  import { getSupabase } from "@/components/comments/lib";

  async function loadTrending() {
    const panel = document.getElementById("featured-trending") as HTMLElement | null;
    const track = document.getElementById("trending-carousel-track");
    if (!panel || !track || track.children.length > 0) return;

    const since = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString();
    const sb = getSupabase();

    const { data } = await sb
      .from("page_views")
      .select("post_id")
      .gte("visited_at", since);

    if (!data?.length) return;

    const counts: Record<string, number> = {};
    for (const { post_id } of data) {
      counts[post_id] = (counts[post_id] ?? 0) + 1;
    }

    const topIds = Object.entries(counts)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 10)
      .map(([id]) => id);

    if (!topIds.length) return;

    type PostMeta = { href: string; title: string; description: string; label: string; color: string };
    const allPosts: PostMeta[] = JSON.parse(panel.dataset.posts || "[]");

    const cards = topIds
      .map(id => allPosts.find(p => p.href.includes(id)))
      .filter((p): p is PostMeta => !!p);

    if (!cards.length) return;

    track.replaceChildren(
      ...cards.map(post => {
        const a = document.createElement("a");
        a.href = post.href;
        a.style.cssText = "scroll-snap-align: start;";
        a.className = "group flex flex-row rounded-lg border border-border overflow-hidden hover:border-accent transition-colors outline-none shrink-0 w-[200px] h-[120px] sm:w-[280px] sm:h-[140px]";

        const left = document.createElement("div");
        left.className = "shrink-0 overflow-hidden w-[70px] sm:w-[100px] flex items-center justify-center";
        left.style.cssText = `background: linear-gradient(135deg, color-mix(in srgb, ${post.color} 25%, transparent), color-mix(in srgb, ${post.color} 6%, transparent))`;

        // placeholder icon (same SVG as FeaturedCard)
        const ns = "http://www.w3.org/2000/svg";
        const svg = document.createElementNS(ns, "svg");
        svg.setAttribute("viewBox", "0 0 32 32");
        svg.classList.add("w-16", "h-16", "opacity-[0.08]");
        svg.setAttribute("aria-hidden", "true");
        const g = document.createElementNS(ns, "g");
        g.setAttribute("transform", "translate(16 16) scale(0.85) translate(-16 -16)");
        g.setAttribute("fill", "currentColor");
        g.setAttribute("stroke", "currentColor");
        [
          ["7","9","22","22"],
          ["22","22","25","8"],
          ["7","9","25","8"],
        ].forEach(([x1,y1,x2,y2], i) => {
          const line = document.createElementNS(ns, "line");
          line.setAttribute("x1", x1); line.setAttribute("y1", y1);
          line.setAttribute("x2", x2); line.setAttribute("y2", y2);
          line.setAttribute("stroke-width", "1.9");
          line.setAttribute("stroke-linecap", "round");
          if (i === 2) line.setAttribute("opacity", "0.4");
          g.appendChild(line);
        });
        [["7","9","3.2"],["22","22","4"],["25","8","2.4"]].forEach(([cx,cy,r]) => {
          const circle = document.createElementNS(ns, "circle");
          circle.setAttribute("cx", cx); circle.setAttribute("cy", cy);
          circle.setAttribute("r", r); circle.setAttribute("stroke", "none");
          g.appendChild(circle);
        });
        svg.appendChild(g);
        left.appendChild(svg);

        const right = document.createElement("div");
        right.className = "flex flex-col flex-1 p-3 gap-1.5 min-w-0 overflow-hidden";

        const meta = document.createElement("span");
        meta.className = "flex items-center gap-1 font-mono text-[10px] sm:text-[11px] whitespace-nowrap overflow-hidden";
        meta.style.color = "var(--fg-faint)";

        const dot = document.createElement("span");
        dot.className = "cat-dot shrink-0 size-1.5";
        dot.style.background = post.color;

        const labelSpan = document.createElement("span");
        labelSpan.className = "hidden sm:inline shrink-0";
        labelSpan.style.color = post.color;
        labelSpan.textContent = post.label + "\u2002";

        meta.appendChild(dot);
        meta.appendChild(labelSpan);

        const title = document.createElement("p");
        title.className = "font-semibold text-[14px] leading-snug line-clamp-3 group-hover:text-accent transition-colors";
        title.textContent = post.title;

        const desc = document.createElement("p");
        desc.className = "text-[12.5px] leading-snug line-clamp-2 mt-auto";
        desc.style.color = "var(--fg-mute)";
        desc.textContent = post.description;

        right.appendChild(meta);
        right.appendChild(title);
        right.appendChild(desc);
        a.appendChild(left);
        a.appendChild(right);
        return a;
      })
    );
  }

  document.addEventListener("astro:page-load", loadTrending);
</script>

<style>
  .ascii-gradient {
    background: linear-gradient(90deg, var(--foreground) 0%, #7c3aed 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .cat-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    display: inline-block;
  }
  .active-pill {
    border-color: var(--accent);
    color: var(--accent);
  }
  .active-tab {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ── Carousel ── */
  .featured-carousel {
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
  }
  .featured-carousel::-webkit-scrollbar { display: none; }
  .featured-carousel-track {
    display: flex;
    gap: 12px;
  }
  /* ── Carousel header nav buttons ── */
  .carousel-header-divider {
    width: 1px;
    height: 16px;
    background: var(--border);
    margin: 0 2px;
  }
  .carousel-header-nav {
    display: flex; align-items: center; justify-content: center;
    width: 26px; height: 26px;
    border-radius: 50%;
    border: 1px solid var(--border);
    color: var(--foreground);
    cursor: pointer;
    transition: color 150ms, border-color 150ms, opacity 150ms;
  }
  .carousel-header-nav:hover { color: var(--accent); border-color: var(--accent); }
  .carousel-header-nav[data-hidden] { opacity: 0.25; pointer-events: none; }
</style>

<script>
  function initCatFilter() {
    const pills = document.querySelectorAll<HTMLButtonElement>(".cat-filter-pill");
    const items = document.querySelectorAll<HTMLElement>("#post-list li[data-index]");
    const sentinel = document.getElementById("load-sentinel");

    if (!pills.length) return;

    const PAGE = 10;
    let activeFilter = "all";
    let activeParent = "all";
    let shown = PAGE;
    let loading = false;
    let observer: IntersectionObserver | null = null;

    const spinner = document.getElementById("load-spinner");

    function filteredItems() {
      return [...items].filter(el => {
        const cat = el.dataset.category ?? "";
        const matchGraph = activeFilter === "all" || cat === activeFilter || cat.startsWith(`${activeFilter}-`);
        const matchParent = activeParent === "all" || cat.startsWith(`${activeParent}-`);
        return matchGraph && matchParent;
      });
    }

    // 필터 변경 시: 전체 재렌더 (fade out → fade in)
    function showItems() {
      const toShow = filteredItems().slice(0, shown);
      const toShowSet = new Set(toShow);

      items.forEach(el => {
        if (el.style.display !== "none" && !toShowSet.has(el)) {
          el.style.transition = "opacity 100ms ease";
          el.style.opacity = "0";
        }
      });

      setTimeout(() => {
        items.forEach(el => {
          el.classList.remove("hidden");
          el.style.display = "none";
          el.style.opacity = "0";
          el.style.transition = "";
        });
        toShow.forEach((el, i) => {
          el.style.display = "";
          requestAnimationFrame(() => {
            setTimeout(() => {
              el.style.transition = "opacity 150ms ease";
              el.style.opacity = "1";
            }, i * 18);
          });
        });
      }, 110);
    }

    // 무한 스크롤 시: 새 항목만 append
    function appendItems(prevShown: number) {
      const next = filteredItems().slice(prevShown, shown);
      next.forEach((el, i) => {
        el.classList.remove("hidden");
        el.style.display = "";
        el.style.opacity = "0";
        el.style.transition = "";
        requestAnimationFrame(() => {
          setTimeout(() => {
            el.style.transition = "opacity 150ms ease";
            el.style.opacity = "1";
          }, i * 18);
        });
      });
    }

    function loadMore() {
      const total = filteredItems().length;
      if (loading || shown >= total) return;
      loading = true;
      spinner?.classList.remove("hidden");
      const prev = shown;
      shown = Math.min(shown + PAGE, total);
      setTimeout(() => {
        appendItems(prev);
        loading = false;
        spinner?.classList.add("hidden");
      }, 400);
    }

    function setupObserver() {
      observer?.disconnect();
      if (!sentinel) return;
      observer = new IntersectionObserver(
        entries => { if (entries[0].isIntersecting) loadMore(); },
        { rootMargin: "0px", threshold: 0 }
      );
      observer.observe(sentinel);
    }

    const countEl = document.getElementById("archives-count");

    function applyFilter(key: string) {
      activeFilter = key;
      shown = PAGE;
      showItems();
      pills.forEach(p => p.classList.toggle("active-pill", p.dataset.cat === key));
      document.dispatchEvent(new CustomEvent("graph:filter", { detail: { category: key } }));

      const cnt = filteredItems().length;
      if (countEl) countEl.textContent = `${cnt} records`;
    }

    pills.forEach(pill => {
      pill.addEventListener("click", () => applyFilter(pill.dataset.cat ?? "all"));
    });

    const archivesPills = document.querySelectorAll<HTMLButtonElement>(".archives-filter-pill");
    archivesPills.forEach(pill => {
      pill.addEventListener("click", () => {
        activeParent = pill.dataset.parent ?? "all";
        shown = PAGE;
        showItems();
        archivesPills.forEach(p => p.classList.toggle("active-pill", p.dataset.parent === activeParent));
        const cnt = filteredItems().length;
        if (countEl) countEl.textContent = `${cnt} records`;
      });
    });

    setupObserver();
    applyFilter("all");
  }

  function initFeaturedTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>(".featured-tab");
    const panels = document.querySelectorAll<HTMLElement>(".featured-panel");
    if (!tabs.length) return;

    tabs.forEach(tab => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.tab;
        tabs.forEach(t => t.classList.toggle("active-tab", t.dataset.tab === target));
        panels.forEach(p => {
          const isTarget = p.id === `featured-${target}`;
          if (isTarget) {
            p.classList.remove("hidden");
            p.style.opacity = "0";
            p.style.transition = "";
            requestAnimationFrame(() => {
              p.style.transition = "opacity 150ms ease";
              p.style.opacity = "1";
            });
          } else {
            p.classList.add("hidden");
            p.style.opacity = "";
            p.style.transition = "";
          }
        });
        // sync carousel edge state for the newly visible panel
        const prev = document.getElementById("carousel-prev-btn");
        const next = document.getElementById("carousel-next-btn");
        const carousel = document.querySelector<HTMLElement>(".featured-panel:not(.hidden) .featured-carousel");
        if (prev && next && carousel) {
          const { scrollLeft, scrollWidth, clientWidth } = carousel;
          scrollLeft < 8 ? prev.setAttribute("data-hidden", "") : prev.removeAttribute("data-hidden");
          scrollLeft > scrollWidth - clientWidth - 8
            ? next.setAttribute("data-hidden", "")
            : next.removeAttribute("data-hidden");
        }
      });
    });
  }

  function initCarouselNav() {
    const prev = document.getElementById("carousel-prev-btn") as HTMLButtonElement | null;
    const next = document.getElementById("carousel-next-btn") as HTMLButtonElement | null;
    if (!prev || !next) return;

    const activeCarousel = () =>
      document.querySelector<HTMLElement>(".featured-panel:not(.hidden) .featured-carousel");

    const cardWidth = (carousel: HTMLElement) => {
      const first = carousel.querySelector<HTMLElement>(".featured-carousel-track > *");
      return first ? first.offsetWidth + 12 : 220;
    };

    const updateEdge = () => {
      const carousel = activeCarousel();
      if (!carousel) return;
      const { scrollLeft, scrollWidth, clientWidth } = carousel;
      scrollLeft < 8 ? prev.setAttribute("data-hidden", "") : prev.removeAttribute("data-hidden");
      scrollLeft > scrollWidth - clientWidth - 8
        ? next.setAttribute("data-hidden", "")
        : next.removeAttribute("data-hidden");
    };

    prev.addEventListener("click", () => {
      const c = activeCarousel();
      if (c) c.scrollBy({ left: -cardWidth(c), behavior: "smooth" });
    });
    next.addEventListener("click", () => {
      const c = activeCarousel();
      if (c) c.scrollBy({ left: cardWidth(c), behavior: "smooth" });
    });

    // re-bind scroll listener when panel switches
    document.querySelectorAll<HTMLElement>(".featured-carousel").forEach(c => {
      c.addEventListener("scroll", updateEdge, { passive: true });
    });

    updateEdge();
  }

  function initIndexPage() {
    const mainContent = document.querySelector("#main-content") as HTMLElement | null;
    if (mainContent) {
      sessionStorage.setItem("backUrl", "/");
    }
    initCatFilter();
    initFeaturedTabs();
    initCarouselNav();
  }

  document.addEventListener("astro:page-load", initIndexPage);
  document.addEventListener("astro:after-swap", initCatFilter);
</script>
