---
import { getCollection } from "astro:content";
import BlogShell from "@/layouts/BlogShell.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { allCategories } from "@/utils/getCategories";
import GraphCanvas from "@/components/GraphCanvas.astro";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const posts = getSortedPosts(allPosts);

const allBooks = await getCollection("books", ({ data }) => !data.draft);
const books = allBooks.sort(
  (a, b) =>
    new Date(b.data.modDatetime ?? b.data.pubDatetime).getTime() -
    new Date(a.data.modDatetime ?? a.data.pubDatetime).getTime()
);

type EntryItem = {
  href: string;
  date: Date;
  title: string;
  category: string;
  label: string;
};

const CATEGORY_LABEL: Record<string, string> = {
  thought: "Thoughts",
  writing: "Writing",
  tech: "Tech",
  book: "Books",
};

const allItems: EntryItem[] = [
  ...posts.map(p => ({
    href: getPath(p),
    date: new Date(p.data.pubDatetime),
    title: p.data.title,
    category: p.data.category,
    label: CATEGORY_LABEL[p.data.category] ?? p.data.category,
  })),
  ...books.map(b => ({
    href: `/books/${b.id}`,
    date: new Date(b.data.pubDatetime),
    title: b.data.title,
    category: "book",
    label: "Books",
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const total = allItems.length;
---

<BlogShell mode="discovery" rail="discovery" activePage="home" data-layout="index">
  <!-- Hero: ASCII + Graph -->
  <section class="pb-10 border-b border-border">
    <div class="overflow-x-auto mb-8">
      <pre class="text-[0.45rem] leading-[1.2] sm:text-[0.6rem] md:text-[0.7rem] font-mono select-none ascii-gradient" aria-hidden="true">     ██╗ █████╗  ██████╗ ██████╗ ██████╗ ███████╗██╗██████╗ ██╗ █████╗ ███╗   ██╗
     ██║██╔══██╗██╔════╝██╔═══██╗██╔══██╗██╔════╝██║██╔══██╗██║██╔══██╗████╗  ██║
     ██║███████║██║     ██║   ██║██████╔╝███████╗██║██║  ██║██║███████║██╔██╗ ██║
██   ██║██╔══██║██║     ██║   ██║██╔══██╗╚════██║██║██║  ██║██║██╔══██║██║╚██╗██║
╚█████╔╝██║  ██║╚██████╗╚██████╔╝██████╔╝███████║██║██████╔╝██║██║  ██║██║ ╚████║
 ╚════╝ ╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚═════╝ ╚══════╝╚═╝╚═════╝ ╚═╝╚═╝  ╚═╝╚═╝  ╚═══╝</pre>
    </div>
    <h1 class="sr-only">jacobsidian</h1>
    <div class="rounded-lg border border-border overflow-hidden">
      <GraphCanvas height={340} />
    </div>
  </section>

  <!-- Category filter pills -->
  <div id="cat-filter-row" class="flex gap-2 overflow-x-auto pb-1 mb-5 flex-wrap mt-8">
    <button
      class="cat-filter-pill flex items-center gap-1.5 rounded-full border border-border px-3 py-1 text-[13px] transition-all hover:border-accent hover:text-accent active-pill"
      data-cat="all"
    >
      All
    </button>
    {allCategories().map(([key, meta]) => (
      <button
        class="cat-filter-pill flex items-center gap-1.5 rounded-full border border-border px-3 py-1 text-[13px] transition-all hover:border-accent hover:text-accent"
        data-cat={key}
        style={`--pill-color:${meta.color}`}
      >
        <span class="cat-dot shrink-0" style={`background:${meta.color}`} />
        {meta.label}
      </button>
    ))}
  </div>

  <!-- Archives -->
  {allItems.length > 0 && (
    <section>
      <div class="flex items-baseline justify-between mb-5">
        <h2 class="text-base font-semibold tracking-tight">Archives</h2>
        <span class="text-xs text-foreground/40">{total} records</span>
      </div>

      <ul id="post-list" class="divide-y divide-border">
        {allItems.map((item, i) => (
          <li data-index={i} data-category={item.category} data-postcat={item.category} class={i >= 10 ? "hidden" : ""}>
            <a
              href={item.href}
              class="group post-grid-home py-4 transition-colors duration-150 hover:text-accent"
            >
              <span class="text-xs text-foreground/40 tabular-nums self-center">
                {item.date.toLocaleDateString("ko-KR", {
                  year: "numeric",
                  month: "2-digit",
                  day: "2-digit",
                })}
              </span>
              <span class="font-medium truncate self-center transition-transform duration-150 group-hover:translate-x-1">
                {item.title}
              </span>
              <span class="text-xs text-foreground/40 self-center text-right">
                {item.label}
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div id="load-more-wrap" class="hidden mt-6 text-center">
        <button
          id="load-more-btn"
          class="text-sm text-foreground/50 hover:text-accent transition-colors border border-border rounded-full px-5 py-2 hover:border-accent"
        >
          Load more
        </button>
      </div>
    </section>
  )}
</BlogShell>

<style>
  .ascii-gradient {
    background: linear-gradient(90deg, var(--foreground) 0%, #7c3aed 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .cat-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    display: inline-block;
  }
  .active-pill {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>

<script>
  function initCatFilter() {
    const pills = document.querySelectorAll<HTMLButtonElement>(".cat-filter-pill");
    const rows = document.querySelectorAll<HTMLElement>("[data-postcat]");
    const items = document.querySelectorAll<HTMLElement>("#post-list li[data-index]");
    const loadMoreWrap = document.getElementById("load-more-wrap");
    const loadMoreBtn = document.getElementById("load-more-btn");

    if (!pills.length) return;

    const PAGE = 10;
    let activeFilter = "all";
    let shown = PAGE;

    function filteredItems() {
      return [...items].filter(el =>
        activeFilter === "all" || el.dataset.category === activeFilter
      );
    }

    function updateLoadMore() {
      const hasMore = filteredItems().length > shown;
      loadMoreWrap?.classList.toggle("hidden", !hasMore);
    }

    function showItems() {
      const all = filteredItems();
      items.forEach(el => (el.style.display = "none"));
      all.slice(0, shown).forEach(el => (el.style.display = ""));
      updateLoadMore();
    }

    function applyFilter(key: string) {
      activeFilter = key;
      shown = PAGE;
      showItems();
      pills.forEach(p => p.classList.toggle("active-pill", p.dataset.cat === key));
      document.dispatchEvent(new CustomEvent("graph:filter", { detail: { category: key } }));
    }

    pills.forEach(pill => {
      pill.addEventListener("click", () => applyFilter(pill.dataset.cat ?? "all"));
    });

    loadMoreBtn?.addEventListener("click", () => {
      shown += PAGE;
      showItems();
    });

    applyFilter("all");
  }

  function initIndexPage() {
    const mainContent = document.querySelector("#main-content") as HTMLElement | null;
    if (mainContent) {
      sessionStorage.setItem("backUrl", "/");
    }
    initCatFilter();
  }

  document.addEventListener("astro:page-load", initIndexPage);
  document.addEventListener("astro:after-swap", initCatFilter);
</script>
