---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { SITE } from "@/config";
import GraphCanvas from "@/components/GraphCanvas.astro";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const posts = getSortedPosts(allPosts);

const allBooks = await getCollection("books", ({ data }) => !data.draft);
const books = allBooks.sort(
  (a, b) =>
    new Date(b.data.modDatetime ?? b.data.pubDatetime).getTime() -
    new Date(a.data.modDatetime ?? a.data.pubDatetime).getTime()
);

type EntryItem = {
  href: string;
  date: Date;
  title: string;
  category: string;
  label: string;
};

const CATEGORY_LABEL: Record<string, string> = {
  thought: "Thoughts",
  writing: "Writing",
  tech: "Tech",
  book: "Books",
};

const allItems: EntryItem[] = [
  ...posts.map(p => ({
    href: getPath(p),
    date: new Date(p.data.pubDatetime),
    title: p.data.title,
    category: p.data.category,
    label: CATEGORY_LABEL[p.data.category] ?? p.data.category,
  })),
  ...books.map(b => ({
    href: `/books/${b.id}`,
    date: new Date(b.data.pubDatetime),
    title: b.data.title,
    category: "book",
    label: "Books",
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const total = allItems.length;
const counts: Record<string, number> = { all: total, book: books.length };
for (const post of posts) {
  counts[post.data.category] = (counts[post.data.category] ?? 0) + 1;
}

const filters = [
  { key: "all",     label: "All"      },
  { key: "thought", label: "Thoughts" },
  { key: "writing", label: "Writing"  },
  { key: "tech",    label: "Tech"     },
  { key: "book",    label: "Books"    },
].filter(f => f.key === "all" || counts[f.key]);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout pt-12 pb-16">
    <!-- Hero: ASCII -->
    <section class="pb-10 border-b border-border">
      <div class="overflow-x-auto rounded-lg border border-border bg-muted/30 px-4 py-6">
        <pre class="text-[0.45rem] leading-[1.2] sm:text-[0.6rem] md:text-[0.7rem] font-mono select-none ascii-gradient" aria-hidden="true">     ██╗ █████╗  ██████╗ ██████╗ ██████╗ ███████╗██╗██████╗ ██╗ █████╗ ███╗   ██╗
     ██║██╔══██╗██╔════╝██╔═══██╗██╔══██╗██╔════╝██║██╔══██╗██║██╔══██╗████╗  ██║
     ██║███████║██║     ██║   ██║██████╔╝███████╗██║██║  ██║██║███████║██╔██╗ ██║
██   ██║██╔══██║██║     ██║   ██║██╔══██╗╚════██║██║██║  ██║██║██╔══██║██║╚██╗██║
╚█████╔╝██║  ██║╚██████╗╚██████╔╝██████╔╝███████║██║██████╔╝██║██║  ██║██║ ╚████║
 ╚════╝ ╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚═════╝ ╚══════╝╚═╝╚═════╝ ╚═╝╚═╝  ╚═╝╚═╝  ╚═══╝</pre>
      </div>
      <h1 class="sr-only">jacobsidian</h1>
    </section>

    <!-- Graph -->
    <section class="py-10 border-b border-border">
      <div class="mb-4">
        <span class="text-sm font-medium text-foreground/60">Graph</span>
      </div>
      <div class="rounded-lg border border-border overflow-hidden">
        <GraphCanvas height={340} />
      </div>
    </section>

    <!-- Archives -->
    {allItems.length > 0 && (
      <section class="pt-8">
        <div class="flex items-baseline justify-between mb-5">
          <h2 class="text-base font-semibold tracking-tight">Archives</h2>
          <span class="text-xs text-foreground/40">{total} records</span>
        </div>

        <!-- Category filter badges -->
        <div class="flex gap-2 overflow-x-auto pb-5 scrollbar-none -mx-4 px-4 sm:mx-0 sm:px-0">
          {filters.map(f => (
            <button
              data-filter={f.key}
              class:list={[
                "filter-btn shrink-0 flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-sm font-medium",
                "border transition-colors duration-150 cursor-pointer",
                "border-border text-foreground/60 hover:border-accent hover:text-accent",
              ]}
            >
              {f.label}
              <span class="text-xs opacity-60">{counts[f.key]}</span>
            </button>
          ))}
        </div>

        <ul id="post-list" class="divide-y divide-border">
          {allItems.map((item, i) => (
            <li data-index={i} data-category={item.category} class={i >= 10 ? "hidden" : ""}>
              <a
                href={item.href}
                class="group post-grid-home py-4 transition-colors duration-150 hover:text-accent"
              >
                <span class="text-xs text-foreground/40 tabular-nums self-center">
                  {item.date.toLocaleDateString("ko-KR", {
                    year: "numeric",
                    month: "2-digit",
                    day: "2-digit",
                  })}
                </span>
                <span class="font-medium truncate self-center transition-transform duration-150 group-hover:translate-x-1">
                  {item.title}
                </span>
                <span class="text-xs text-foreground/40 self-center text-right">
                  {item.label}
                </span>
              </a>
            </li>
          ))}
        </ul>

        <div id="load-more-wrap" class="hidden mt-6 text-center">
          <button
            id="load-more-btn"
            class="text-sm text-foreground/50 hover:text-accent transition-colors border border-border rounded-full px-5 py-2 hover:border-accent"
          >
            Load more
          </button>
        </div>
      </section>
    )}
  </main>
  <Footer />
</Layout>

<style>
  .scrollbar-none { scrollbar-width: none; }
  .scrollbar-none::-webkit-scrollbar { display: none; }
  .ascii-gradient {
    background: linear-gradient(90deg, var(--foreground) 0%, #7c3aed 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>

<script>
  function initArchives() {
    const items = document.querySelectorAll<HTMLElement>("#post-list li[data-index]");
    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const loadMoreWrap = document.getElementById("load-more-wrap");
    const loadMoreBtn = document.getElementById("load-more-btn");
    if (!items.length) return;

    const PAGE = 10;
    let activeFilter = "all";
    let shown = PAGE;

    function filteredItems() {
      return [...items].filter(el =>
        activeFilter === "all" || el.dataset.category === activeFilter
      );
    }

    function updateLoadMore() {
      const hasMore = filteredItems().length > shown;
      loadMoreWrap?.classList.toggle("hidden", !hasMore);
    }

    function showItems() {
      const all = filteredItems();
      items.forEach(el => el.classList.add("hidden"));
      all.slice(0, shown).forEach(el => el.classList.remove("hidden"));
      updateLoadMore();
    }

    function applyFilter(key: string) {
      activeFilter = key;
      shown = PAGE;
      showItems();
      buttons.forEach(btn => {
        const isActive = btn.dataset.filter === key;
        btn.classList.toggle("border-accent", isActive);
        btn.classList.toggle("text-accent", isActive);
        btn.classList.toggle("border-border", !isActive);
        btn.classList.toggle("text-foreground/60", !isActive);
      });
    }

    buttons.forEach(btn =>
      btn.addEventListener("click", () => applyFilter(btn.dataset.filter ?? "all"))
    );

    loadMoreBtn?.addEventListener("click", () => {
      shown += PAGE;
      showItems();
    });

    applyFilter("all");
  }

  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
      initArchives();
    }
  });
</script>
