---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.filter(({ data }) => !data.draft);

const categoryLabel = (category: string) => {
  if (category === "thought") return "Thoughts";
  if (category === "tech") return "Tech";
  if (category === "writing") return "Writing";
  return category;
};

const categoryPath = (category: string) => {
  if (category === "thought") return "thoughts";
  if (category === "tech") return "tech";
  if (category === "writing") return "writing";
  return category;
};
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout pt-12 pb-16">
    <!-- Hero: minimal -->
    <section class="pb-10 border-b border-border">
      <h1 class="text-2xl font-semibold tracking-tight mb-1">Jacob Lee</h1>
      <p class="text-sm text-foreground/60">글쓰기를 좋아하는 어느 개발자의 기록 저장소.</p>
    </section>

    <!-- Recent posts list -->
    {recentPosts.length > 0 && (
      <section class="pt-8">
        <ul class="divide-y divide-border">
          {recentPosts.slice(0, SITE.postPerIndex).map(({ data, id }) => (
            <li>
              <a
                href={`/${categoryPath(data.category)}/${id}`}
                class="group grid py-4 gap-x-4 transition-colors duration-150 hover:text-accent"
                style="grid-template-columns: 6.5rem 1fr 5rem;"
              >
                <span class="text-xs text-foreground/40 tabular-nums self-center">
                  {new Date(data.pubDatetime).toLocaleDateString("ko-KR", {
                    year: "numeric",
                    month: "2-digit",
                    day: "2-digit",
                  })}
                </span>
                <span class="font-medium truncate self-center transition-transform duration-150 group-hover:translate-x-1">
                  {data.title}
                </span>
                <span class="text-xs text-foreground/40 self-center">
                  {categoryLabel(data.category)}
                </span>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-8 text-center">
          <LinkButton href="/archives/">
            모든 글
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      </section>
    )}
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
