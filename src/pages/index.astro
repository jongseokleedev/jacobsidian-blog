---
import { getCollection } from "astro:content";
import BlogShell from "@/layouts/BlogShell.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { PARENTS, getCategoryMeta, parseCategory } from "@/utils/getCategories";
import { getPostImage } from "@/utils/getPostImage";
import GraphCanvas from "@/components/GraphCanvas.astro";
import FeaturedCard from "@/components/FeaturedCard.astro";
import SeriesCard from "@/components/SeriesCard.astro";
import { getSeriesSlug } from "@/utils/getSeriesSlug";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const posts = getSortedPosts(allPosts);
const standalonePosts = posts.filter(p => !p.data.series);

// Series 섹션
const allSeriesMeta = await getCollection("series");
const seriesItems = await Promise.all(
  allSeriesMeta.map(async s => {
    const chapters = posts.filter(p => p.data.series === s.data.title);
    const catMeta = s.data.category ? getCategoryMeta(s.data.category) : null;
    return {
      name: s.data.title,
      subtitle: s.data.subtitle,
      description: s.data.description,
      slug: await getSeriesSlug(s.data.title),
      chapterCount: chapters.length,
      color: catMeta?.color ?? "var(--fg-faint)",
      latestDate: chapters.length
        ? new Date(Math.max(...chapters.map(p => new Date(p.data.pubDatetime).getTime())))
        : new Date(),
    };
  })
);

const allItems = posts.map(p => ({
  href: getPath(p),
  date: new Date(p.data.pubDatetime),
  title: p.data.title,
  description: p.data.description ?? "",
  category: p.data.category,
  label: getCategoryMeta(p.data.category)?.label ?? p.data.category,
  color: getCategoryMeta(p.data.category)?.color ?? "var(--fg-faint)",
  series: p.data.series as string | undefined,
}));

const total = allItems.length;

const parentCounts = allItems.reduce<Record<string, number>>((acc, item) => {
  const { parent } = parseCategory(item.category);
  acc[parent] = (acc[parent] ?? 0) + 1;
  return acc;
}, {});

// Featured: top 3 posts by graph connection score (시리즈 글 제외)
const scoredPosts = standalonePosts.map(post => {
  const outgoing = post.data.links?.length ?? 0;
  const postBasename = post.id.split("/").pop()?.replace(/\.md$/, "") ?? post.id;
  const incoming = posts.filter(other =>
    other.id !== post.id &&
    (other.data.links ?? []).some(
      l => l === postBasename || l === post.data.title
    )
  ).length;
  return { post, score: outgoing + incoming };
});
scoredPosts.sort((a, b) => b.score - a.score);
const topPosts = scoredPosts.slice(0, 10).map(({ post }) => ({
  href: getPath(post),
  poster: getPostImage(post.data.poster, post.body),
  title: post.data.title,
  description: post.data.description,
  date: new Date(post.data.pubDatetime),
  category: post.data.category,
  label: getCategoryMeta(post.data.category)?.label ?? post.data.category,
  color: getCategoryMeta(post.data.category)?.color ?? "var(--fg-faint)",
}));

// Featured: latest posts, 시리즈 글 제외
const latestPosts = standalonePosts
  .slice(0, 10)
  .map(post => ({
    href: getPath(post),
    ogSrc: getPath(post) + "og.png",
    poster: getPostImage(post.data.poster, post.body),
    title: post.data.title,
    description: post.data.description,
    date: new Date(post.data.pubDatetime),
    category: post.data.category,
    label: getCategoryMeta(post.data.category)?.label ?? post.data.category,
    color: getCategoryMeta(post.data.category)?.color ?? "var(--fg-faint)",
  }));
---

<BlogShell mode="discovery" rail="discovery" activePage="home" data-layout="index">
  <!-- Hero: ASCII + Filter + Graph -->
  <section class="pb-10 border-b border-border">
    <div class="overflow-x-hidden mb-6">
      <pre class="text-[1.15vw] leading-[1.2] sm:text-[0.6rem] md:text-[0.7rem] font-mono select-none ascii-gradient" aria-hidden="true">     ██╗ █████╗  ██████╗ ██████╗ ██████╗ ███████╗██╗██████╗ ██╗ █████╗ ███╗   ██╗
     ██║██╔══██╗██╔════╝██╔═══██╗██╔══██╗██╔════╝██║██╔══██╗██║██╔══██╗████╗  ██║
     ██║███████║██║     ██║   ██║██████╔╝███████╗██║██║  ██║██║███████║██╔██╗ ██║
██   ██║██╔══██║██║     ██║   ██║██╔══██╗╚════██║██║██║  ██║██║██╔══██║██║╚██╗██║
╚█████╔╝██║  ██║╚██████╗╚██████╔╝██████╔╝███████║██║██████╔╝██║██║  ██║██║ ╚████║
 ╚════╝ ╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚═════╝ ╚══════╝╚═╝╚═════╝ ╚═╝╚═╝  ╚═╝╚═╝  ╚═══╝</pre>
    </div>
    <h1 class="sr-only">jacobsidian</h1>

    <!-- Category filter pills — unified filter for graph + archives -->
    <div id="cat-filter-row" class="flex gap-2 overflow-x-auto py-2 mb-3 scrollbar-none" style="scrollbar-width:none;">
      <button
        class="cat-filter-pill shrink-0 flex items-center gap-1.5 rounded-full border border-border px-3 py-1 text-[13px] transition-all hover:border-accent hover:text-accent active-pill"
        data-cat="all"
      >
        All
        <span class="font-mono text-[11px] opacity-50">{total}</span>
      </button>
      {Object.entries(PARENTS).map(([parentKey, parentMeta]) => (
        <button
          class="cat-filter-pill shrink-0 flex items-center gap-1.5 rounded-full border border-border px-3 py-1 text-[13px] transition-all hover:border-accent hover:text-accent"
          data-cat={parentKey}
          style={`--pill-color:${parentMeta.color}`}
        >
          <span class="cat-dot shrink-0" style={`background:${parentMeta.color}`} />
          {parentMeta.label}
          <span class="font-mono text-[11px] opacity-50">{parentCounts[parentKey] ?? 0}</span>
        </button>
      ))}
    </div>

    <div class="rounded-lg border border-border overflow-hidden">
      <GraphCanvas height={340} />
    </div>
  </section>


  <!-- Curated: Series + Featured -->
  <section class="py-10 border-b border-border">
    <div class="bd-overline mb-1">Curated</div>

    <!-- Series subsection -->
    {seriesItems.length > 0 && (
      <div class="mb-8">
        <h2 class="text-base font-semibold tracking-tight mb-4">Series</h2>
        <div class="flex flex-wrap gap-4">
          {seriesItems.map(s => (
            <SeriesCard
              name={s.name}
              subtitle={s.subtitle}
              description={s.description}
              href={`/series/${s.slug}`}
              chapterCount={s.chapterCount}
              color={s.color}
              latestDate={s.latestDate}
            />
          ))}
        </div>
      </div>
    )}

    <!-- Featured subsection -->
    <div>
    <div class="flex items-end justify-between mb-5">
      <div>
        <h2 class="text-base font-semibold tracking-tight">Featured</h2>
      </div>
      <div class="flex items-center gap-2">
        <button
          class="featured-tab active-tab shrink-0 rounded-full border border-border px-3 py-1 text-[13px] transition-all hover:border-accent hover:text-accent"
          data-tab="latest"
        >Latest</button>
        <button
          class="featured-tab shrink-0 rounded-full border border-border px-3 py-1 text-[13px] transition-all hover:border-accent hover:text-accent"
          data-tab="core"
        >Core</button>
        <button
          class="featured-tab shrink-0 rounded-full border border-border px-3 py-1 text-[13px] transition-all hover:border-accent hover:text-accent"
          data-tab="trending"
        >Trending</button>
        <div class="carousel-header-divider"></div>
        <button id="carousel-prev-btn" class="carousel-header-nav" aria-label="이전 카드" data-hidden>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button id="carousel-next-btn" class="carousel-header-nav" aria-label="다음 카드">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>

    <!-- Latest panel -->
    <div id="featured-latest" class="featured-panel">
      <div class="featured-carousel">
        <div class="featured-carousel-track">
          {latestPosts.map((item) => <FeaturedCard item={item} carousel />)}
        </div>
      </div>
    </div>

    <!-- Core panel -->
    <div id="featured-core" class="featured-panel hidden">
      <div class="featured-carousel">
        <div class="featured-carousel-track">
          {topPosts.map((item) => <FeaturedCard item={item} carousel />)}
        </div>
      </div>
    </div>

    <!-- Trending panel (client-side) -->
    <div
      id="featured-trending"
      class="featured-panel hidden"
      data-posts={JSON.stringify(allItems.map(i => ({ href: i.href, title: i.title, description: i.description ?? "", category: i.category, label: i.label, color: i.color })))}
    >
      <div class="featured-carousel">
        <div id="trending-carousel-track" class="featured-carousel-track"></div>
      </div>
    </div>
    </div>
  </section>

  <!-- Archives -->
  {allItems.length > 0 && (
    <section class="pt-10">
      <div class="flex items-start justify-between mb-4">
        <div>
          <div class="bd-overline mb-1">Latest</div>
          <h2 class="text-base font-semibold tracking-tight">Archives</h2>
        </div>
        <span id="archives-count" class="font-mono text-[11px] mt-1" style="color: var(--fg-faint);">{total} records</span>
      </div>

      <div id="archives-filter-row" class="flex gap-2 flex-wrap mb-4">
        <button
          class="archives-filter-pill active-pill flex items-center gap-1.5 rounded-full border border-border px-3 py-1 text-[12.5px] transition-all hover:border-accent hover:text-accent"
          data-parent="all"
        >
          All
          <span class="font-mono text-[11px] opacity-50">{total}</span>
        </button>
        {Object.entries(PARENTS).map(([parentKey, parentMeta]) => (
          <button
            class="archives-filter-pill flex items-center gap-1.5 rounded-full border border-border px-3 py-1 text-[12.5px] transition-all hover:border-accent hover:text-accent"
            data-parent={parentKey}
            style={`--pill-color:${parentMeta.color}`}
          >
            <span class="cat-dot shrink-0" style={`background:${parentMeta.color}`} />
            {parentMeta.label}
            <span class="font-mono text-[11px] opacity-50">{parentCounts[parentKey] ?? 0}</span>
          </button>
        ))}
      </div>

      <ul id="post-list" class="archives-list">
        {allItems.map((item, i) => (
          <li data-index={i} data-category={item.category} class={i >= 10 ? "hidden" : ""}>
            <a
              href={item.href}
              class="group post-grid-home py-[10px] border-b transition-colors duration-150 hover:text-accent"
              style="border-color: var(--border-soft);"
            >
              <!-- 모바일: 1행 (날짜 + 카테고리), 데스크탑: 날짜 컬럼 -->
              <div class="flex items-center justify-between sm:contents">
                <span class="font-mono text-[11px] tabular-nums whitespace-nowrap" style="color: var(--fg-faint);">
                  {item.date.toLocaleDateString("ko-KR", {
                    year: "numeric",
                    month: "2-digit",
                    day: "2-digit",
                  })}
                </span>
                <span class="font-mono text-[11px] sm:hidden" style="color: var(--fg-faint);">
                  {item.label}
                </span>
              </div>
              <!-- 제목 (모바일: 2행 전체 너비, 데스크탑: 중간 컬럼) -->
              <span class="font-medium text-[14px] sm:truncate self-center inline-flex items-center gap-2 transition-transform duration-150 group-hover:translate-x-[3px]">
                <span class="cat-dot shrink-0" style={`background: ${item.color}`} />
                {item.series && <span class="font-normal shrink-0" style="color: var(--fg-faint);">{item.series} · </span>}
                {item.title}
              </span>
              <!-- 카테고리 레이블: 데스크탑에서만 표시 -->
              <span class="hidden sm:block font-mono text-[11px] self-center text-right" style="color: var(--fg-faint);">
                {item.label}
              </span>
            </a>
