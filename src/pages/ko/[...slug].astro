---
import { getCollection } from "astro:content";
import { PARENTS } from "@/utils/getCategories";
import { slugifyStr } from "@/utils/slugify";

export async function getStaticPaths() {
  const paths: { params: { slug: string | undefined } }[] = [
    { params: { slug: undefined } }, // /ko/ → /
  ];

  for (const [parent, pm] of Object.entries(PARENTS)) {
    // /ko/parent → /parent
    paths.push({ params: { slug: parent } });

    for (const sub of Object.keys(pm.subs)) {
      const catKey = `${parent}-${sub}`;
      // /ko/parent/sub → /parent/sub
      paths.push({ params: { slug: `${parent}/${sub}` } });

      const posts = await getCollection(
        "posts",
        ({ data }) => data.category === catKey && !data.draft && data.lang !== "en"
      );

      for (const post of posts) {
        const postSlug = slugifyStr(post.id.split("/").pop() ?? post.id);
        // /ko/parent/sub/slug → /parent/sub/slug
        paths.push({ params: { slug: `${parent}/${sub}/${postSlug}` } });
      }
    }
  }

  return paths;
}

const slugParam = Astro.params.slug ?? "";
return Astro.redirect(slugParam ? encodeURI(`/${slugParam}`) : "/", 301);
---
