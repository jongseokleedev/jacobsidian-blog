---
import { getCollection, render } from "astro:content";
import BlogShell from "@/layouts/BlogShell.astro";
import { getPath } from "@/utils/getPath";
import Datetime from "@/components/Datetime.astro";
import { SITE } from "@/config";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const seriesSet = new Set<string>();
  for (const post of allPosts) {
    if (post.data.series) seriesSet.add(post.data.series);
  }
  return Array.from(seriesSet).map(series => ({
    params: { slug: series.replace(/\s+/g, "-").toLowerCase() },
    props: { series },
  }));
}

const { series } = Astro.props as { series: string };
const slug = series.replace(/\s+/g, "-").toLowerCase();

const allPosts = await getCollection("posts", ({ data }) => data.series === series);
const chapters = allPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
const publishedCount = chapters.length;
const totalCount = allPosts.length;

// 볼트에서 sync된 시리즈 소개글 (없으면 null)
const allSeries = await getCollection("series");
const seriesMeta = allSeries.find(s => s.id === slug || s.data.slug === slug) ?? null;
const { Content: SeriesIntro } = seriesMeta ? await render(seriesMeta) : { Content: null };
---

<BlogShell
  mode="discovery"
  rail="discovery"
  title={`${series} | ${SITE.title}`}
  description={seriesMeta?.data.description || `${series} 시리즈 — 총 ${publishedCount}편`}
>
  <div class="max-w-xl mx-auto py-10">
    <!-- 시리즈 헤더 -->
    <div class="mb-10">
      <p class="text-[11px] font-medium uppercase tracking-widest mb-3" style="color: var(--fg-mute);">Series</p>
      <h1 class="text-3xl font-bold tracking-tight mb-4">{series}</h1>

      {SeriesIntro && (
        <div class="app-prose text-[15px] leading-relaxed mb-5" style="color: var(--fg-mute);">
          <SeriesIntro />
        </div>
      )}

      <p class="text-sm" style="color: var(--fg-mute);">
        {publishedCount}편 발행
        {publishedCount < totalCount && ` · ${totalCount - publishedCount}편 준비 중`}
      </p>
    </div>

    <!-- 챕터 목록 -->
    <ol class="space-y-0">
      {chapters.map((post, i) => (
        <li class="group">
          <a
            href={getPath(post)}
            class="flex gap-5 py-5 border-b border-border transition-colors hover:text-accent"
          >
            <span
              class="shrink-0 w-6 text-right text-[13px] font-mono mt-0.5"
              style="color: var(--fg-mute);"
            >
              {post.data.seriesOrder ?? i + 1}
            </span>
            <div class="flex-1 min-w-0">
              <p class="font-medium leading-snug mb-1">{post.data.title}</p>
              <p class="text-[13px] line-clamp-2 mb-2" style="color: var(--fg-mute);">
                {post.data.description}
              </p>
              <Datetime pubDatetime={post.data.pubDatetime} class="text-[12px]" />
            </div>
          </a>
        </li>
      ))}
    </ol>
  </div>
</BlogShell>
