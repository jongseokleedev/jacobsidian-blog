---
import { getCollection, render } from "astro:content";
import BlogShell from "@/layouts/BlogShell.astro";
import { getPath } from "@/utils/getPath";
import { getCategoryMeta, parseCategory } from "@/utils/getCategories";
import { SITE } from "@/config";

export async function getStaticPaths() {
  const allSeries = await getCollection("series");
  return allSeries.map(s => ({
    params: { slug: s.id },
    props: { series: s.data.title },
  }));
}

const { series } = Astro.props as { series: string };
const slug = Astro.params.slug;

const allPosts = await getCollection("posts", ({ data }) => data.series === series);
const chapters = allPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
const publishedCount = chapters.length;
const totalCount = allPosts.length;

const allSeries = await getCollection("series");
const seriesMeta = allSeries.find(s => s.id === slug) ?? null;
const { Content: SeriesIntro } = seriesMeta ? await render(seriesMeta) : { Content: null };

const catMeta = seriesMeta?.data.category ? getCategoryMeta(seriesMeta.data.category) : null;
const { parent } = seriesMeta?.data.category ? parseCategory(seriesMeta.data.category) : { parent: null };
const color = catMeta?.color ?? "var(--accent)";
---

<BlogShell
  mode="discovery"
  rail="category"
  activeCategory={seriesMeta?.data.category}
  title={`${series} | ${SITE.title}`}
  description={seriesMeta?.data.description || `${series} 시리즈 — 총 ${publishedCount}편`}
>
  <!-- 커버 헤더 -->
  <header
    class="rounded-lg mb-8 px-7 py-8 flex flex-col gap-3"
    style={`background: linear-gradient(160deg, color-mix(in srgb, ${color} 18%, transparent), color-mix(in srgb, ${color} 5%, transparent));`}
  >
    <div class="flex items-center gap-2">
      <span class="cat-dot" style={`background: ${color}`} />
      <span
        class="text-[9px] font-mono tracking-widest uppercase px-1.5 py-0.5 rounded"
        style={`color: ${color}; background: color-mix(in srgb, ${color} 18%, transparent);`}
      >Series</span>
      {catMeta && (
        <span class="bd-overline" style={`color: ${color};`}>{catMeta.label}</span>
      )}
    </div>

    <div>
      <h1 class="text-[28px] font-bold tracking-[-0.02em] leading-tight">{series}</h1>
      {seriesMeta?.data.subtitle && (
        <p class="mt-1 text-[15px]" style="color: var(--fg-mute);">{seriesMeta.data.subtitle}</p>
      )}
    </div>

    {SeriesIntro && (
      <div class="app-prose text-[14px] leading-relaxed" style="color: var(--fg-mute);">
        <SeriesIntro />
      </div>
    )}

    <p class="text-[12px] font-mono" style="color: var(--fg-faint);">
      {publishedCount}편 발행{publishedCount < totalCount ? ` · ${totalCount - publishedCount}편 준비 중` : ""}
    </p>
  </header>

  <!-- 챕터 목록 -->
  <div class="bd-overline mb-1">Chapters</div>
  <h2 class="text-base font-semibold tracking-tight mb-2">목차</h2>

  <ol class="archives-list">
    {chapters.map((post, i) => (
      <li>
        <a
          href={getPath(post)}
          class="group post-grid-home py-[10px] border-b transition-colors duration-150 hover:text-accent"
          style="border-color: var(--border-soft);"
        >
          <div class="flex items-center justify-between sm:contents">
            <span class="font-mono text-[11px] tabular-nums whitespace-nowrap" style="color: var(--fg-faint);">
              {String(post.data.seriesOrder ?? i + 1).padStart(2, "0")}
            </span>
            <span class="font-mono text-[11px] sm:hidden" style="color: var(--fg-faint);">
              {new Date(post.data.pubDatetime).toLocaleDateString("ko-KR", { year: "numeric", month: "2-digit", day: "2-digit" })}
            </span>
          </div>
          <span class="font-medium text-[14px] sm:truncate self-center inline-flex items-center gap-2 transition-transform duration-150 group-hover:translate-x-[3px]">
            <span class="cat-dot shrink-0" style={`background: ${color}`} />
            {post.data.title}
          </span>
          <span class="hidden sm:block font-mono text-[11px] tabular-nums whitespace-nowrap self-center text-right" style="color: var(--fg-faint);">
            {new Date(post.data.pubDatetime).toLocaleDateString("ko-KR", { year: "numeric", month: "2-digit", day: "2-digit" })}
          </span>
        </a>
      </li>
    ))}
  </ol>
</BlogShell>

<style>
  .cat-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    display: inline-block;
    flex-shrink: 0;
  }
</style>
