---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import BlogShell from "@/layouts/BlogShell.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { getPath } from "@/utils/getPath";
import { getCategoryMeta } from "@/utils/getCategories";
import CommentCount from "@/components/CommentCount.astro";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts");
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);
    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const { tag: _tag } = Astro.params;
const { page, tagName } = Astro.props;
---

<BlogShell mode="discovery" rail="discovery" title={`#${tagName} | ${SITE.title}`}>
  <header class="mb-6">
    <div class="flex items-center gap-2 mb-1">
      <p class="bd-overline">태그</p>
    </div>
    <h1 class="text-[28px] font-bold tracking-[-0.02em]">#{tagName}</h1>
  </header>

  <section>
    <ul class="archives-list">
      {page.data.map(post => {
        const meta = getCategoryMeta(post.data.category);
        const color = meta?.color ?? "var(--fg-faint)";
        const label = meta?.label ?? post.data.category;
        return (
          <li>
            <a
              href={getPath(post)}
              class="group post-grid-home py-[10px] border-b transition-colors duration-150 hover:text-accent"
              style="border-color: var(--border-soft);"
            >
              <div class="flex items-center justify-between sm:contents">
                <span class="font-mono text-[11px] tabular-nums whitespace-nowrap" style="color: var(--fg-faint);">
                  {new Date(post.data.pubDatetime).toLocaleDateString("ko-KR", {
                    year: "numeric",
                    month: "2-digit",
                    day: "2-digit",
                  })}
                </span>
                <span class="font-mono text-[11px] sm:hidden" style="color: var(--fg-faint);">
                  {label}
                </span>
              </div>
              <span class="font-medium text-[14px] sm:truncate self-center inline-flex items-center gap-2 min-w-0 transition-transform duration-150 group-hover:translate-x-[3px]">
                <span class="cat-dot shrink-0" style={`background: ${color}`} />
                <span class="truncate">{post.data.title}</span>
                <CommentCount postId={post.id} />
              </span>
              <span class="hidden sm:block font-mono text-[11px] self-center text-right" style="color: var(--fg-faint);">
                {label}
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <Pagination {page} />
</BlogShell>
