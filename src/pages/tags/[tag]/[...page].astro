---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { getPath } from "@/utils/getPath";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts");
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);
    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const { tag: _tag } = Astro.params;
const { page, tagName } = Astro.props;
---

<Layout title={`#${tagName} | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout pt-12 pb-16">
    <section class="pb-10 border-b border-border">
      <p class="text-sm text-foreground/40 mb-1">태그</p>
      <h1 class="text-2xl font-semibold tracking-tight">#{tagName}</h1>
    </section>

    <section class="pt-8">
      <ul class="divide-y divide-border">
        {page.data.map(post => (
          <li>
            <a
              href={getPath(post)}
              class="group post-grid py-4 transition-colors duration-150 hover:text-accent"
            >
              <span class="text-xs text-foreground/40 tabular-nums self-center whitespace-nowrap">
                {new Date(post.data.pubDatetime).toLocaleDateString("ko-KR", {
                  year: "numeric",
                  month: "2-digit",
                  day: "2-digit",
                })}
              </span>
              <span class="font-medium truncate self-center transition-transform duration-150 group-hover:translate-x-1">
                {post.data.title}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <Pagination {page} />
  </main>
  <Footer />
</Layout>
