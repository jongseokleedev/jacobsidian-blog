---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import BlogShell from "@/layouts/BlogShell.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { getPath } from "@/utils/getPath";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts");
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);
    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const { tag: _tag } = Astro.params;
const { page, tagName } = Astro.props;
---

<BlogShell mode="discovery" rail="discovery" title={`#${tagName} | ${SITE.title}`}>
  <header class="mb-6">
    <div class="flex items-center gap-2 mb-1">
      <p class="bd-overline">태그</p>
    </div>
    <h1 class="text-[28px] font-bold tracking-[-0.02em]">#{tagName}</h1>
  </header>

  <section>
    <ul class="archives-list">
      {page.data.map(post => (
        <li>
          <a
            href={getPath(post)}
            class="group post-grid-home py-[10px] border-b transition-colors duration-150 hover:text-accent"
            style="border-color: var(--border-soft);"
          >
            <span class="font-mono text-[11px] tabular-nums whitespace-nowrap" style="color: var(--fg-faint);">
              {new Date(post.data.pubDatetime).toLocaleDateString("ko-KR", {
                year: "numeric",
                month: "2-digit",
                day: "2-digit",
              })}
            </span>
            <span class="font-medium text-[14px] truncate self-center transition-transform duration-150 group-hover:translate-x-[3px]">
              {post.data.title}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Pagination {page} />
</BlogShell>
