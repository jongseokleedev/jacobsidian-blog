---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import { SITE } from "@/config";

const posts = await getCollection("posts");
const tags = getUniqueTags(posts).filter(({ tag }) => tag !== "post" && tag !== "book" && tag !== "others");
---

<Layout title={`Tags | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout pt-12 pb-16">
    <section class="pb-10 border-b border-border">
      <h1 class="text-2xl font-semibold tracking-tight mb-1">Tags</h1>
    </section>
    <section class="pt-8">
      <ul class="flex flex-wrap gap-4">
        {tags.map(({ tag, tagName }) => <Tag {tag} {tagName} />)}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
